
config settings 'settings'
	option config_path '/etc/xray/config.json'
	option service 'xray'
	option xray_bin ''
	option socks_port '10808'
	option api_port '62789'
	option socks_udp '1'
	option password ''
	option default_outbound ''
	option log_dir '/var/log'
# автовыбор сервера по лучшему пингу (балансировщик xray leastPing):
#	option auto_best '1'
#	option probe_url 'https://www.gstatic.com/generate_204'

# прозрачный режим (весь трафик роутера/сети идёт через xray):
