	printf '<select name="%s">' "$2"
	printf '<option value=""%s>'"$T_all_traffic_without_a_set"'</option>' "$([ -z "$_cur" ] && echo ' selected')"
	for _st in $(set_sections); do
		_cnt=$(set_item_sections "$_st" | wc -l | tr -d ' ')
		printf '<option value="%s"%s>%s (%s)</option>' "$(h "$_st")" "$([ "$_cur" = "$_st" ] && echo ' selected')" "$(h "$(set_name "$_st")")" "$_cnt"
	done
	printf '</select>'
}

page_rules() {
	# переносим старые правила (значение + выход) в наборы и правила-ссылки
	_bak=$(rules_migrate_v062 2>/dev/null)
	if [ -n "$_bak" ]; then
		printf '<div class="msg">'"$T_the_rules_were_moved_to_the_"'</div>\n' "$(h "$_bak")"
	fi
	# 1) правила — правятся прямо в таблице, сохраняются одной кнопкой
	_cnames=$(lan_clients_named 2>/dev/null | awk -F'\t' '{ print $2 "=" $1 }')
	_ract=$(rules_activity 2>/dev/null)
	printf '<div class="card" style="order:1" id="rules-card"><h2>'"$T_rules"'</h2>'
	# Честность лампочек: панель узнаёт, какое правило поймало трафик, по именам
	# сайтов из журнала запросов dnsmasq. Если имён нет, условия правил проверить
	# нечем — и лампочки начинают показывать не те строки. Об этом надо сказать
	# прямо, а причину по возможности починить самому.
	case "$(dns_names_state)" in
		off)
			printf '<p class="bad">Запись запросов DNS выключена, поэтому панель не знает имён сайтов: лампочки могут показывать не то правило. '
			printf '<form method="post" style="display:inline"><input type="hidden" name="action" value="dnslog_on"><button class="btn sec">'"$T_enable_dns_query_logging"'</button></form></p>'
			;;
		silent)
			printf '<p class="bad">dnsmasq перестал писать в системный журнал роутера (так бывает после сбоя журнала). Из-за этого панель не знает имён сайтов, и лампочки могут показывать не то правило. Перезапускаю dnsmasq сам — имена вернутся через несколько минут. '
			printf '<form method="post" style="display:inline"><input type="hidden" name="action" value="dnslog_repair"><button class="btn sec">'"$T_fix_now"'</button></form></p>'
			dns_try_repair
			;;
		nolog)
			printf '<p class="bad">dnsmasq не работает — имена сайтов панель получать не может, лампочки могут показывать не то правило. Загляните на страницу «Прокси» (состояние службы).</p>'
			;;
	esac
	printf '<div id="rules-form"><input type="hidden" name="newrows" id="newrows" value="">'
	printf '<table class="responsive" id="rules-table"><tr><th></th><th>'"$T_who_goes"'</th><th>'"$T_where_sets"'</th><th>'"$T_through_what"'</th><th>'"$T_activity"'</th><th>'"$T_actions"'</th></tr>'
	for _r in $(rule_sections); do
		_ro=$(uci -q get "$UCI_APP.$_r.outbound" 2>/dev/null)
		_src=$(uci -q get "$UCI_APP.$_r.source" 2>/dev/null)
		_sets=$(uci -q get "$UCI_APP.$_r.sets" 2>/dev/null)
		_off=""
		rule_disabled "$_r" && _off=' style="opacity:.55"'
		# активность: время и подсветка, как в клиентах
		_seen=$(printf '%s\n' "$_ract" | awk -F'\t' -v s="$_r" '$1 == s { print $2 "\t" $4 "\t" $5; exit }')
		_rowcls=""; _rowst=""; _tip="нет свежих записей"; _acttxt='<span class="muted">—</span>'; _outcls=""
		if [ -n "$_seen" ]; then
			_age=$(printf '%s' "$_seen" | cut -f1)
			_top=$(printf '%s' "$_seen" | cut -f3)
			case "$_age" in
				''|*[!0-9]*) ;;
				*)
					_tip="за 10 минут: $_top"
					_acttxt="<span class=\"muted\">$(h "$(human_age "$_age")") назад</span>"
					# лампочка правила: вспыхнула ярко и гаснет за 30 секунд — тем
					# же окном, что и запись набора (LAMP_SECONDS)
					if [ "$_age" -lt "$LAMP_SECONDS" ]; then
						_rowcls=' lamp-on'
						_rowst=" style=\"animation-delay:-${_age}s\""
						_outcls=' class="tagmark active"'
					fi
					;;
			esac
		fi
		printf '<tr data-rule="%s" class="%s"%s>' "$(h "$_r")" "${_rowcls# }" "$_rowst"
		printf '<td class="drag-cell"><span class="drag-handle" data-drag-handle title="'"$T_hold_a_rule_for_a_second_and"'">⠿</span></td>'
		printf '<td data-label="'"$T_who_goes"'">'
		rule_who_pick "$_src" "src_$_r"
		printf '</td>'
		printf '<td data-label="'"$T_where"'">'
		rule_sets_pick "$_sets" "sets_$_r"
		printf '</td>'
		printf '<td data-label="'"$T_through_what"'">'
		rule_out_select "$_ro" "out_$_r"
		printf '</td>'
		# id нужен для живого обновления: пока по правилу идёт трафик, строка
		# подсвечивается и мигает, а надпись «N назад» обновляется сама
		printf '<td data-label="'"$T_activity"'" id="rule-act-%s" title="%s">%s</td>' "$(h "$_r")" "$(h "$_tip")" "$_acttxt"
		printf '<td data-label="'"$T_actions"'"><span class="acts">'
		if rule_disabled "$_r"; then
			printf '<form method="post"><input type="hidden" name="action" value="rule_toggle"><input type="hidden" name="sec" value="%s"><button class="btn start" title="'"$T_enable_rule"'">▶</button></form>' "$(h "$_r")"
		else
			printf '<form method="post"><input type="hidden" name="action" value="rule_toggle"><input type="hidden" name="sec" value="%s"><button class="btn stop" title="'"$T_disable_rule"'">⏸</button></form>' "$(h "$_r")"
		fi
		printf '<form method="post"><input type="hidden" name="action" value="del_rule"><input type="hidden" name="sec" value="%s"><button class="btn danger" title="'"$T_delete_rule_2"'">✕</button></form>' "$(h "$_r")"
		printf '</span></td></tr>\n'
	done
	# Шаблон пустой строки: кнопка «добавить правило» копирует его, а не
	# последнее правило. Так пустое правило можно добавить всегда — раньше
	# при пустом списке копировать было нечего и правило не добавлялось.
	printf '<tr id="rule-tpl" data-tpl="1" style="display:none">'
	printf '<td class="drag-cell"><span class="drag-handle">⠿</span></td>'
	printf '<td data-label="'"$T_who_goes"'">'
	rule_who_pick "" "src_tpl"
	printf '</td>'
	printf '<td data-label="'"$T_where"'">'
	rule_sets_pick "" "sets_tpl"
	printf '</td>'
	printf '<td data-label="'"$T_through_what"'">'
	rule_out_select "" "out_tpl"
	printf '</td>'
	printf '<td data-label="'"$T_activity"'"></td>'
	printf '<td data-label="'"$T_actions"'"><span class="muted">'"$T_new_row_will_be_saved_with_t"'</span></td>'
	printf '</tr>\n'
	printf '</table>'
	# кнопка такая же, как «применить конфиг» на других страницах: пока есть
	# неприменённые изменения — красная «применить конфиг», после применения —
	# зелёная «конфиг применён»
	if config_dirty || [ -n "$(pending_list 1 2>/dev/null)" ]; then
		_albl="$T_apply_config"; _acls="btn apply-btn pending"
	else
		_albl="$T_config_applied"; _acls="btn apply-btn done"
	fi
	printf '<p><button type="button" class="btn sec add-rule">'"$T_add_rule"'</button> <button type="button" class="%s rules-apply">%s</button> <span class="muted">'"$T_saves_the_rules_and_applies_"'</span></p></div>' "$_acls" "$_albl"
	printf '<p class="muted">'"$T_rules_are_checked_from_top_t"'</p></div>\n'
	# карточки страницы: правила собраны выше, наборы и готовые списки —
	# отдельными функциями. Наборы вынесены, чтобы страница могла перерисовать
	# только их (переключение набора не требует пересборки всей страницы)
	sets_card_html
	rules_lists_html
}

# Карточка наборов адресов и доменов. Вынесена отдельно: её одну перерисовывает
# страница при переключении набора и правке записей, а не всю страницу целиком
# (полная сборка «Маршрутов» занимает несколько секунд).
sets_card_html() {
	# 2) наборы
	_cur_set=$(param set)
	# набор, открытый в прошлый раз, помним в настройках: так он не сбрасывается
	# ни при перезагрузке страницы, ни при переходе на другую вкладку и обратно
	[ -n "$_cur_set" ] || _cur_set=$(cfg rules_set "")
	_known=0
	for _s in $(set_sections); do
		[ "$_s" = "$_cur_set" ] && _known=1
	done
	[ "$_known" = 1 ] || _cur_set=$(set_sections | head -1)
	# кнопки управления наборами — над заголовком карточки, до спойлера:
	# так к ним ближе, и они видны, даже когда содержимое свёрнуто
	printf '<div class="card" style="order:2" id="sets-card">'
	printf '<div class="newset">'
	printf '<form method="post"><input type="hidden" name="action" value="set_new">'
	printf '<div><label>'"$T_new_set"'</label><input name="setname" placeholder="'"$T_for_example_direct"'"></div>'
	printf '<button>'"$T_create_set"'</button></form>'
	if [ -n "$_cur_set" ]; then
		printf '<form method="post"><input type="hidden" name="action" value="set_rename"><input type="hidden" name="set" value="%s">' "$(h "$_cur_set")"
		printf '<div><label>'"$T_rename_s"'</label><input name="newname" value="%s"></div>' "$(h "$(set_name "$_cur_set")")" "$(h "$(set_name "$_cur_set")")"
		printf '<button class="btn sec">'"$T_rename"'</button></form>'
		printf '<form method="post"><input type="hidden" name="action" value="set_toggle"><input type="hidden" name="set" value="%s"><button class="btn %s">%s набор</button></form>' \
			"$(h "$_cur_set")" "$(set_disabled "$_cur_set" && echo 'start' || echo 'stop')" "$(set_disabled "$_cur_set" && echo 'включить' || echo 'выключить')"
		printf '<form method="post"><input type="hidden" name="action" value="set_del"><input type="hidden" name="set" value="%s"><button class="btn danger">'"$T_delete_set"'</button></form>' "$(h "$_cur_set")"
		printf '<form method="post"><input type="hidden" name="action" value="geo_items"><button class="btn sec" title="'"$T_parse_the_ready_lists_of_thi"'">'"$T_parse_set_lists"'</button></form>'
	fi
	printf '</div>'
	printf '<h2>'"$T_address_and_domain_sets"'</h2><details class="pick" open><summary>'"$T_show_sets_and_their_content"'</summary>'
	if [ -z "$(set_sections)" ]; then
		printf '<p class="muted">'"$T_there_are_no_sets_yet_create"'</p>'
	else
		printf '<div class="names-row">'
		for _st in $(set_sections); do
			_cnt=$(set_item_sections "$_st" | wc -l | tr -d ' ')
			if [ "$_st" = "$_cur_set" ]; then _cls="btn"; else _cls="btn sec"; fi
			printf '<a class="%s set-pick" data-set-pick="%s" href="%s?page=rules&amp;set=%s">%s (%s)</a>' "$_cls" "$(h "$_st")" "$SCRIPT_NAME" "$(h "$_st")" "$(h "$(set_name "$_st")")" "$_cnt"
			if set_disabled "$_st"; then printf '<span class="bad">выключен</span>'; fi
		done
		printf '</div>'
		if [ -n "$_cur_set" ]; then
			printf '<h3>%s</h3>' "$(h "$(set_name "$_cur_set")")"
			printf '<table class="responsive"><tr><th>'"$T_what"'</th><th>'"$T_value"'</th><th>'"$T_actions"'</th></tr>'
			_ic=0
			# подсветка сработавших записей: считается один раз на набор
			_iact=$(set_items_activity "$_cur_set" "$_ract" 2>/dev/null)
			for _it in $(set_item_sections "$_cur_set"); do
				_ic=$((_ic + 1))
				_it_t=$(uci -q get "$UCI_APP.$_it.type" 2>/dev/null)
				_it_v=$(uci -q get "$UCI_APP.$_it.value" 2>/dev/null)
				_offi=""; item_disabled "$_it" && _offi=' style="opacity:.55"'
				# сработала ли запись: свежая — ярким, до минуты — бледнее,
				# готовый список без кэша имён — пометка «вероятно»
				_icl=""; _ist=""; _ictip=""
				_ia=$(printf '%s\n' "$_iact" | awk -F'\t' -v i="$_it" '$1 == i { print $2 "\t" $3; exit }')
				if [ -n "$_ia" ]; then
					_iaa=${_ia%%	*}; _iak=${_ia##*	}
					case "$_iak" in
						maybe)
							_icl="item-maybe"
							_ictip=" вероятно, сработала эта запись: готовый список ещё не разобран, а другие записи набора не совпали. Точную проверку включает кнопка «разобрать списки набора»" ;;
						*)
							case "$_iaa" in ''|*[!0-9]*) _iaa=999 ;; esac
							# то же окно, что у правил: ярко вспыхнула и гаснет за 30 секунд
							if [ "$_iaa" -lt "$LAMP_SECONDS" ]; then
								_icl="lamp-on"
								_ist=" style=\"animation-delay:-${_iaa}s\""
								_ictip=" сработала $_iaa сек назад — гаснет за $LAMP_SECONDS секунд"
							fi ;;
					esac
				fi
				# готовый список без разобранного файла доменов: объясняем, почему
				# срабатывание по нему видно только «вероятно»
				if [ -z "$_icl" ]; then
					_dfil=$(item_domains_file "$_it")
					if [ -n "$_dfil" ] && [ ! -s "$_dfil" ]; then
						_ictip=" готовый список $_it_v ещё не разобран: пока его нет, панель может сказать про эту запись только «вероятно». Нажмите «разобрать списки набора» — разбор идёт фоном, несколько секунд"
					fi
				fi
				# запись можно поправить прямо здесь: «по какому принципу»
				# (тип) и само значение, как у правил наверху
				printf '<tr data-item="%s" class="%s"%s%s><td data-label="'"$T_what"'">' "$(h "$_it")" "$_icl" "$_ist" "$_offi"
				rule_type_select "$_it_t" "ittype_$_it" "ittype_$_it"
				printf '</td><td data-label="'"$T_value"'" title="%s"><input name="itvalue_%s" value="%s"></td><td data-label="'"$T_actions"'"><span class="acts">' \
					"$(h "$_ictip")" "$(h "$_it")" "$(h "$_it_v")"
				printf '<form method="post"><input type="hidden" name="action" value="item_toggle"><input type="hidden" name="set" value="%s"><input type="hidden" name="item" value="%s"><button class="btn sec" title="'"$T_enable_or_disable_the_entry"'">%s</button></form>' \
					"$(h "$_cur_set")" "$(h "$_it")" "$(item_disabled "$_it" && echo '▶' || echo '⏸')"
				printf '<form method="post"><input type="hidden" name="action" value="item_del"><input type="hidden" name="set" value="%s"><input type="hidden" name="item" value="%s"><button class="btn danger" title="'"$T_delete_the_entry"'">✕</button></form>' \
					"$(h "$_cur_set")" "$(h "$_it")"
				printf '</span></td></tr>\n'
			done
			if [ "$_ic" = 0 ]; then printf '<tr><td colspan="3" class="muted">в наборе пусто</td></tr>'; fi
			printf '</table>'
			# Готовые списки (geosite) проверяются по файлу доменов. Пока файла
			# нет, про запись можно сказать только «вероятно» — и лампочка в
			# наборе не загорается, хотя правило сработало. Файл собираем сами,
			# фоном: несколько секунд на список, результат кэшируется.
			_unbuilt=""
			for _it2 in $(set_item_sections "$_cur_set"); do
				_df2=$(item_domains_file "$_it2")
				[ -n "$_df2" ] || continue
				[ -s "$_df2" ] && continue
				_vn2=$(uci -q get "$UCI_APP.$_it2.value" 2>/dev/null)
				_unbuilt="$_unbuilt$_vn2 "
			done
			_unbuilt=$(printf '%s\n' $_unbuilt | awk 'NF' | LC_ALL=C sort -u | tr '\n' ' ')
			if [ -n "$_unbuilt" ]; then
				printf '<p class="muted">'"$T_the_ready_lists_of_the_set_a"'</p>' "$(h "$_unbuilt")"
				# запускаем сами, один раз: если разбор уже идёт, скрипт выйдет сразу
				[ -f "$STATE_DIR/geo-item.running" ] || bg_run "$GEO_ITEM_ENV sh '$GEO_ITEM'" "$STATE_DIR/geo-item.log"
			fi
			# сохранение правок записей: тише, без перезагрузки страницы
			printf '<p><button type="button" class="btn sec items-save">'"$T_save_entry_changes"'</button> <span class="muted" id="items-note">'"$T_edit_the_type_and_value_righ"'</span></p>'
			printf '<form method="post" style="margin-top:8px"><input type="hidden" name="action" value="item_add"><input type="hidden" name="set" value="%s"><div class="row">' "$(h "$_cur_set")"
			printf '<div><label>'"$T_what_to_add"'</label>'
			# по умолчанию — готовый список доменов: в 99% случаев нужен он
			rule_type_select geosite
			# кнопка добавления — здесь же, под выбором типа: она относится ко всей
			# строке, и раньше её приходилось искать в самом низу формы
			printf '<p style="margin:8px 0 0"><button>Добавить в «%s»</button></p></div>' "$(h "$(set_name "$_cur_set")")"
			printf '<div><label>'"$T_value_several_allowed_each_o"'</label><textarea name="value" rows="3" placeholder="youtube.com, 8.8.8.8, geosite:youtube"></textarea></div>'
			# конструктор шаблона: пишем домены, панель сама собирает выражение —
			# руками в шаблоне легко ошибиться в экранировании точки или в скобках
			printf '<div style="margin-top:6px"><label>'"$T_build_a_template_from_sites_"'</label>'
			printf '<div style="display:flex;gap:6px"><input id="tmpl-sites" placeholder="vkvideo.ru, rutube.ru" autocomplete="off">'
			printf '<button type="button" class="btn sec" id="tmpl-build">'"$T_build_template"'</button></div>'
			printf '<p class="tmpl-hint" id="tmpl-hint" style="margin:4px 0 0">Напиши домены через запятую — панель соберёт <code>(^|\\.)(домен1|домен2)$</code>, переключит тип на «Шаблон» и подставит выражение в «Значение».</p></div>'
			# проверка домена — тут же, рядом с полем «Значение»: найденный домен
			# можно сразу положить в набор (удержание плашки) или скопировать
			printf '<div><label>'"$T_domain_check_where_it_is_and"'</label>'
			printf '<input name="rule_find_name" placeholder="youtube.com" autocomplete="off">'
			printf '<p style="margin:6px 0 0"><button type="button" class="btn small rule-find">'"$T_check_domain"'</button> <button type="button" class="btn small sec list-show">'"$T_what_is_in_the_list"'</button> <span class="muted" id="rule-find-out"></span></p>'
			printf '<input name="list_find_name" list="geo-names" placeholder="'"$T_list_vk_rutube_youtube_categ"'" autocomplete="off" style="margin-top:6px">'
			printf '</div>'
			printf '</div></form>'
			printf '<div class="report" id="rule-find-report"></div>'
		fi
	fi
	printf '</details></div>\n'
}

# Готовые списки и подсказка названий — отдельная функция: в лёгком режиме
# (когда страница перерисовывает только наборы) этот блок не нужен.
rules_lists_html() {
	# 4) готовые списки. Блок свёрнут, а его содержимое собирается только когда
	# его открыли (?page=geo): раньше панель считала всё это при каждой загрузке
	# «Маршрутов», хотя блоки со спойлером обычно свёрнуты. Сама подсказка
	# названий (datalist) остаётся в странице — она лёгкая и нужна полю «Значение».
	printf '<div class="card" style="order:4" id="geo-card">'
	printf '<details class="pick" id="geo-det"><summary>'"$T_geo_lists_of_domains_and_add"'</summary>'
	printf '<div id="geo-body"><p class="muted">'"$T_click_the_title_i_will_show_"'</p></div>'
	printf '</details>'
	geo_datalist
	printf '</div>\n'
}

# Содержимое блока готовых списков (без спойлера): что лежит на роутере, что уже
# разобрано и когда, откуда качается обновление и как включить автообновление.
# Отдаётся отдельной страницей (?page=geo) — только когда блок открыли.
geo_body_html() {
	_sf=$(geo_files geosite)
	_if=$(geo_files geoip)
	# отпечаток файлов со списками считаем ОДИН раз на карточку: он нужен и для
	# «файлы менялись после сбора», и для состояний списков наборов (иначе
	# карточка считала бы его дважды — это лишняя работа для роутера)
	_gsig=$(geo_signature 2>/dev/null)
	if [ -z "$_sf$_if" ]; then
		printf '<p class="bad">Файлов со списками (geosite.dat, geoip.dat) на роутере нет — правила с готовыми списками работать не будут.</p>'
		printf '<p class="muted">'"$T_they_are_installed_by_the_v2"'</p>'
		printf '<form method="post"><input type="hidden" name="action" value="geo_pkg"><button class="btn sec">'"$T_install_list_packages"'</button></form>'
		return 0
	fi
