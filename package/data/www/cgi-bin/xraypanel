		printf '<details class="pick"><summary>'"$T_installation_log"'</summary><pre>%s</pre></details>' "$(printf '%s' "$_plog" | h_in)"
	fi
	printf '<p class="muted">'"$T_before_installing_the_panel_"'</p>'
	printf '</div>\n'
	if ! xray_present; then
		printf '<div class="card"><h2 class="bad">'"$T_xray_is_not_installed"'</h2>'
		printf '<p>Панель — это только управление, а самого ядра xray на роутере нет, поэтому ничего работать не будет. Установщик панели ставит его сам — что получилось, видно ниже в журнале.</p>'
		printf '<p>Нажмите «Применить конфиг»: если xray ещё не установлен, панель поставит пакет <code>xray-core</code> из репозитория, включит автозапуск и поднимет службу. Роутеру нужен доступ в интернет.</p>'
		_ilog=$(tail -n 10 "$STATE_DIR/install.log" 2>/dev/null)
		[ -n "$_ilog" ] && printf '<p class="muted">'"$T_installation_log_2"'</p><pre>%s</pre>' "$(printf '%s' "$_ilog" | h_in)"
		printf '<p class="muted">'"$T_if_it_does_not_work_from_the"'</p></div>'
	fi
	if [ -z "$(cfg password "")" ]; then
		printf '<div class="card"><h2 class="bad">'"$T_panel_without_a_password"'</h2>'
		printf '<p>Сейчас панель открыта всем, у кого есть доступ к роутеру по сети, а работает она от имени root: может менять конфиг, перезапускать службы и ставить пакеты. Поставьте пароль на странице «Настройки» — после этого панель спросит логин <code>admin</code> и этот пароль.</p></div>'
	fi
	_slog="$STATE_DIR/service.log"
	if [ -f "$_slog" ]; then
		printf '<div class="card"><h2>'"$T_last_xray_restart"'</h2><pre>%s</pre>\n<p class="muted">'"$T_if_there_is_an_error_here_xr"'</p></div>\n' "$(tail -n 15 "$_slog" | h_in)"
	fi
}

# таблица серверов: одна и та же разметка и для страницы, и для тихого
# обновления — страница «Серверы» перерисовывает её без перезагрузки
servers_table_html() {
	_actv=$(effective_outbound)
	printf '<table class="responsive"><tr><th>'"$T_name"'</th><th>'"$T_tag"'</th><th>'"$T_address"'</th><th title="'"$T_time_of_the_real_request_thr"'">'"$T_check_proxy"'</th><th title="'"$T_network_ping_to_the_server_i"'">'"$T_ping_network"'</th><th></th></tr>'
	for _s in $(server_sections); do
		_tag=$(server_tag "$_s")
		_style=""; _mark=""
		if [ -n "$_actv" ] && [ "$_tag" = "$_actv" ]; then
			_style=' class="row-ok"'
			_mark=' class="tagmark active"'
		fi
		# выключенный сервер виден в списке, но помечен и в конфиг не идёт
		_offmark=""
		if server_disabled "$_s"; then
			_style=' class="muted"'
			_mark=""
			_offmark=' <span class="bad">выключен</span>'
			_ticon="▶"; _tcls="start"; _ttitle="включить сервер"
		else
			_ticon="⏸"; _tcls="stop"; _ttitle="выключить сервер (останется в списке, но уйдёт из конфига)"
		fi
		# кнопка «сделать основным»: выход, куда идёт весь трафик без своего
		# маршрута. У выключенного сервера смысла нет — там ничего не показываем.
		_btn_def=""
		_def_tag=$(cfg default_outbound "")
		if ! server_disabled "$_s"; then
			if [ -n "$_def_tag" ] && [ "$_tag" = "$_def_tag" ]; then
				_btn_def='<span class="tagmark active" title="'"$T_this_server_is_the_default_o"'">основной</span>'
			else
				_btn_def=$(printf '<form method="post" style="display:inline"><input type="hidden" name="action" value="set_default"><input type="hidden" name="tag" value="%s"><button class="btn sec" title="'"$T_all_traffic_without_its_own_"'">'"$T_make_default"'</button></form>' "$(h "$_tag")")
			fi
		fi
		_res=$(url_test_saved "$_tag")
		# в столбце «Проверка» — только «123 мс» или «нет ответа»: длинная
		# причина не помещалась и ломала вид таблицы, поэтому её убираем в
		# подсказку при наведении
		_rtitle=""
		_rtitle_attr=""
		_rtime=""
		case "$_res" in
			*'('*')'*)
				# в сохранённом значении время проверки в скобках: показываем
				# его рядом с миллисекундами, а в подсказке — целиком
				_rtime=$(printf '%s' "$_res" | sed 's/.*(\(.*\)).*/\1/')
				_rtitle="$_res"
				_res=$(printf '%s' "$_res" | sed 's/ *(.*//')
				;;
		esac
		[ -n "$_rtitle" ] && _rtitle_attr=" title=\"$(h "$_rtitle")\""
		# причина отказа: сохраняется вместе с результатом проверки и попадает
		# в подсказку при наведении на «нет ответа»
		_reason=$(url_test_saved_reason "$_tag")
		if [ -n "$_reason" ]; then
			if [ -n "$_rtitle" ]; then _rtitle="$_rtitle — $_reason"; else _rtitle="$_res — $_reason"; fi
			_rtitle_attr=" title=\"$(h "$_rtitle")\""
		fi
		# время проверки — маленьким шрифтом сразу после миллисекунд
		_rtime_html=""
		[ -n "$_rtime" ] && _rtime_html=" <span class=\"muted\" style=\"font-size:11px\">$_rtime</span>"
		# классы собираем вместе с «clip»: два атрибута class в одном теге
		# браузеры читают по-разному, поэтому склеиваем в один
		case "$_res" in
			*"нет ответа"*) _rcls='clip bad' ;;
			'')             _rcls='clip muted'; _res="не проверялся" ;;
			*)              _rcls='clip ok' ;;
		esac
		_tagcls='clip'
		[ -n "$_mark" ] && _tagcls='clip tagmark active'
		# пинг считаем только по кнопке «замерить пинг» — иначе каждая загрузка
		# страницы дёргала бы сеть
		if [ "$(param ping)" = 1 ]; then
			_pv=$(ping_host "$(uci -q get "$UCI_APP.$_s.address")")
			if [ -n "$_pv" ]; then _ping_txt="${_pv} мс"; else _ping_txt='<span class="bad">нет ответа</span>'; fi
		else
			_ping_txt='<span class="muted">—</span>'
		fi
		_ep=""
		[ "$(uci -q get "$UCI_APP.$_s.ss_plugin")" = 1 ] && _ep=' <span class="bad">нужен плагин</span>'
		# сервер, занятый реверс-мостом, помечаем синим: он выход для моста
		_rev=""
		server_is_reverse "$_tag" && _rev=' style="font-weight:700;color:#2563eb"'
		# адрес с портом — одним куском: в подсказке и в самой ячейке
		_addrhp="$(h "$(uci -q get "$UCI_APP.$_s.address")"):$(h "$(uci -q get "$UCI_APP.$_s.port")")"
		# длинные значения (имя, тег, адрес) держим в одной строке: хвост
		# обрезается, полный текст виден при наведении мышки
		printf '<tr data-tag="%s"%s><td data-label="'"$T_name"'"%s><span class="clip" title="%s">%s</span>%s</td><td data-label="'"$T_tag"'"><span class="%s" title="%s"%s>%s</span></td><td data-label="'"$T_address"'"%s><span class="clip" title="%s">%s</span>%s</td><td data-label="'"$T_check_2"'"><span class="%s"%s>%s</span>%s</td><td data-label="'"$T_ping"'">%s</td><td data-label="'"$T_actions"'"><a class="btn sec" href="%s?page=server&amp;sec=%s">'"$T_edit_2"'</a> <button type="button" class="btn sec urltest-one" data-tag="%s">'"$T_check"'</button> <form method="post" style="display:inline"><input type="hidden" name="action" value="srv_toggle"><input type="hidden" name="sec" value="%s"><button class="btn %s" title="%s">%s</button></form> %s</td></tr>\n' \
			"$(h "$_tag")" "$_style" "$_rev" "$(h "$_tag")" "$(h "$_s")" "$_offmark" \
			"$_tagcls" "$(h "$_tag")" "$_rev" "$(h "$_tag")" \
			"$_rev" "$_addrhp" "$_addrhp" "$_ep" \
			"$_rcls" "$_rtitle_attr" "$(h "$_res")" "$_rtime_html" \
			"$_ping_txt" "$SCRIPT_NAME" "$(h "$_s")" "$(h "$_tag")" "$(h "$_s")" "$_tcls" "$_ttitle" "$_ticon" "$_btn_def"
	done
	printf '</table>'
	# пояснение к столбцам: новичку «пинг» и «проверка» кажутся одним и тем же,
	# а автовыбор смотрит именно на время запроса через прокси
	printf '<p class="muted">'"$T_best_ping_auto_select_looks_"'</p>' "$(h "$(cfg probe_interval 15)")"
	# что ответила последняя проверка: причина словами и журнал под спойлером
	if [ -f "$STATE_DIR/last-test.log" ]; then
		_lwhy=$(url_test_reason 2>/dev/null)
		_llg=$(tail -n 12 "$STATE_DIR/last-test.log" 2>/dev/null)
		if [ -n "$_llg" ]; then
			[ -n "$_lwhy" ] && printf '<p class="muted">'"$T_last_check_b_s_b"'</p>' "$(h "$_lwhy")"
			printf '<details class="pick"><summary>'"$T_last_check_log_detailed"'</summary><pre>%s</pre></details>\n' "$(printf '%s' "$_llg" | h_in)"
		fi
	fi
}

