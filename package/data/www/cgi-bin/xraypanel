				if [ -n "$_rest" ]; then ui_uci set "$UCI_APP.$_r.sets=$_rest"; else ui_uci delete "$UCI_APP.$_r.sets"; fi
				;;
		esac
	done
	ui_uci delete "$UCI_APP.$_st"
	uci commit "$UCI_APP" >/dev/null 2>&1
	pending_note "удалён набор «$_nm»"
	redirect rules "набор «$_nm» удалён (записей: $_cnt)"
