		esac
		printf '<option value="%s"%s>%s</option>' "$_s" "$([ "$_cur_src" = "$_s" ] && echo ' selected')" "$_lb"
	done
	printf '</select></div></div>'
	printf '<p class="muted">Адреса загрузки<br>'
	printf '<b>Loyalsoldier</b>: <code>github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geosite.dat</code> и <code>geoip.dat</code><br>'
	printf '<b>v2fly</b>: <code>github.com/v2fly/domain-list-community/releases/latest/download/dlc.dat</code> и <code>github.com/v2fly/geoip/releases/latest/download/geoip.dat</code><br>'
	printf '<b>runetfreedom</b>: <code>github.com/runetfreedom/russia-v2ray-rules-dat/releases/latest/download/geosite.dat</code> и <code>geoip.dat</code></p>'
	printf '<p><button class="btn">'"$T_update_lists_now"'</button> <span class="muted">'"$T_in_the_background_download_a"'</span></p></form>'
	# что было в прошлый раз: видно, обновилось ли и что именно
	_lu=$(geo_update_last 2>/dev/null)
	if [ -n "$_lu" ]; then
		_ld=$(printf '%s\n' "$_lu" | awk -F'\t' '$1 == "date" { print $2 }')
		_ln=$(printf '%s\n' "$_lu" | awk -F'\t' '$1 == "name" { print $2 }')
		_lf=$(printf '%s\n' "$_lu" | awk -F'\t' '$1 == "file" { printf "%s %s (%s названий); ", ($2 == "geoip.dat" ? "адреса" : "домены"), $3, $5 }')
		if [ -n "$_ld" ]; then
			printf '<p>Последнее обновление: <b>%s</b>, источник %s.<br>Поставлено: %s</p>' "$(h "$_ld")" "$(h "$_ln")" "$(h "$_lf")"
		fi
