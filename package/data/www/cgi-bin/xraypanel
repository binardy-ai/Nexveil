	for _st in $(set_sections); do
		case "$_cur" in *",$_st,"*) _sel=' selected' ;; *) _sel="" ;; esac
		_n=$(set_item_sections "$_st" | wc -l | tr -d ' ')
		printf '<option value="%s"%s>%s (%s)</option>' "$(h "$_st")" "$_sel" "$(h "$(set_name "$_st")")" "$_n"
	done
	printf '</select>'
