geo_ajax_reply() { # $1 сообщение, $2 селектор блока (необязательно), $3 функция рендера
	printf 'Content-Type: application/json; charset=utf-8\n\n{"ok":true,"msg":"%s"' "$(jesc "$1")"
	if [ -n "${2:-}" ] && [ -n "${3:-}" ]; then
		printf ',"target":"%s","html":"%s"' "$(jesc "$2")" "$("$3" | jesc)"
	fi
	printf '}'
}

