# сохранить правки записей набора (тип и значение, правятся в таблице)
act_item_save_all() {
	_st=$(param set)
	[ -n "$_st" ] || _st=$(cfg rules_set "")
	[ -n "$_st" ] || redirect rules "набор не выбран"
	_n=0
	_bad=""
	for _it in $(set_item_sections "$_st" 2>/dev/null); do
		_t=$(param "ittype_$_it")
		_v=$(param "itvalue_$_it")
		# пустое значение — запись оставляем как была
		[ -n "$_v" ] || continue
		case "$_t" in
			ip|domain|full|keyword|regexp|geosite|geoip) ;;
			*) _t=$(guess_rule_type "$_v") ;;
		esac
		# если вписали готовое название с префиксом — разберём его
		_split=$(rule_split_value "$_v")
		_stt=$(printf '%s' "$_split" | cut -f1)
		if [ -n "$_stt" ]; then
			_t="$_stt"; _v=$(printf '%s' "$_split" | cut -f2)
		fi
		# битый или «ловящий всё» шаблон не сохраняем
		if [ "$_t" = regexp ]; then
			_rs=$(regexp_problem "$_v")
			if [ -n "$_rs" ]; then
				_bad="${_bad:+$_bad; }$_v — $_rs"
				continue
			fi
		fi
		ui_uci set "$UCI_APP.$_it.value=$_v"
		[ -n "$_t" ] && ui_uci set "$UCI_APP.$_it.type=$_t"
		_n=$((_n + 1))
	done
	if [ -n "$_bad" ]; then
		uci -q revert "$UCI_APP"
		redirect rules "шаблон с ошибкой — не сохраняю: $_bad"
	fi
	uci commit "$UCI_APP" >/dev/null 2>&1
	pending_note "изменён набор «$(set_name "$_st")»"
	if [ "$(param ajax)" = 1 ]; then
		printf 'Content-Type: application/json; charset=utf-8\n\n{"ok":true,"msg":"записи сохранены: %s"}' "$_n"
		exit 0
	fi
	redirect rules "записи сохранены: $_n"
}

act_item_add() { # добавить запись в набор
	_st=$(param set)
	[ -n "$_st" ] || redirect rules "сначала выберите набор"
	_type=$(param type)
	_val=$(param value)
	# шаблон проверяем до сохранения: с битым выражением xray не запустится
	_bad=$(printf '%s\n' "$_val" | tr ',;' '\n' | while IFS= read -r _one; do
		_one=$(printf '%s' "$_one" | sed -e 's/^ *//' -e 's/ *$//')
		[ -n "$_one" ] || continue
		_chk=$_one
		case "$_chk" in regexp:*) _chk=${_chk#regexp:} ;; esac
		_rs=""
		case "$_type" in
			regexp) _rs=$(regexp_problem "$_chk") ;;
			*)      case "$_one" in regexp:*) _rs=$(regexp_problem "$_chk") ;; esac ;;
		esac
		[ -n "$_rs" ] && printf '%s — %s\n' "$_chk" "$_rs"
	done)
	if [ -n "$_bad" ]; then
		redirect rules "шаблон с ошибкой — не сохраняю: $(printf '%s' "$_bad" | tr '\n' ' ')"
	fi
	# строк может быть несколько: каждая — отдельная запись
	_n=0
	printf '%s\n' "$_val" | tr ',;' '\n' | while IFS= read -r _one; do
		_one=$(printf '%s' "$_one" | sed -e 's/^ *//' -e 's/ *$//')
		[ -n "$_one" ] || continue
		_split=$(rule_split_value "$_one")
		_stt=$(printf '%s' "$_split" | cut -f1)
		_svv=$(printf '%s' "$_split" | cut -f2)
		if [ -z "$_stt" ]; then
			case "$_type" in
				''|auto) _stt=$(guess_rule_type "$_one") ;;
				*)       _stt="$_type" ;;
			esac
		fi
		item_create "$_st" "$_stt" "$_svv" >/dev/null
	done
	uci commit "$UCI_APP" >/dev/null 2>&1
	pending_note "изменён набор «$(set_name "$_st")»"
	redirect rules "записи добавлены в набор «$(set_name "$_st")»"
}

act_item_del() { # убрать запись из набора
	_it=$(param item)
	[ -n "$_it" ] || redirect rules "запись не выбрана"
	_st=$(uci -q get "$UCI_APP.$_it.set" 2>/dev/null)
