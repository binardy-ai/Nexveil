page_state() { # состояние в JSON — для тихого обновления страницы
	printf 'Content-Type: application/json; charset=utf-8\n\n'
	# Что именно нужно этой странице: «лампочки» правил есть только на
	# «Маршрутах», таблица клиентов — только на «Прокси». Раньше панель считала
	# всё сразу, и живое обновление забирало у роутера около 3 секунд каждые
	# 10 секунд — из-за этого страницы казались вялыми. Теперь считаем только
	# запрошенное.
	_need=$(param need "")
	_need_all=0
	[ -z "$_need" ] && _need_all=1
	case ",$_need," in *",rules,"*)   _need_rules=1   ;; *) _need_rules=$_need_all ;; esac
	case ",$_need," in *",clients,"*) _need_clients=1 ;; *) _need_clients=$_need_all ;; esac
	# «прочее»: состояние прозрачного режима, проверка мостов, трафик по выходам
	# и по клиентам, хвост журнала. Это нужно «Прокси», «Реверсу», «Прозрачному
	# режиму» и «Статусу», а на «Маршрутах» — нет. Проверка мостов (сетевая
	# проверка каждого) стоит около секунды, поэтому на «Маршрутах» её не делаем.
	case ",$_need," in *",misc,"*) _need_misc=1 ;; *) _need_misc=$_need_all ;; esac
	# заодно, не чаще раза в 10 минут, держим журнал xray коротким
	trim_access_log
	case "$(svc_state)" in
		running) _stxt="работает"; _sok=true ;;
		stopped) _stxt="остановлен"; _sok=false ;;
		*)       _stxt="служба не найдена"; _sok=false ;;
	esac
	# состояние прозрачного режима: правила, остаток автоотката, последний запуск и хвост журнала
	_trules=""; _left=0; _last=""; _keep=0; _tail=""
	if [ "$_need_misc" = 1 ]; then
		_trules=$("$TRANS" status 2>/dev/null)
		_dl="$STATE_DIR/transparent.deadline"
		if [ -f "$_dl" ]; then
			_d=$(cat "$_dl" 2>/dev/null)
			case "$_d" in ''|*[!0-9]*) _d=0 ;; esac
			_now=$(date +%s)
			[ "$_d" -gt "$_now" ] && _left=$((_d - _now))
		fi
		[ -f "$STATE_DIR/transparent.last" ] && _last=$(cat "$STATE_DIR/transparent.last" 2>/dev/null)
		[ -f "$STATE_DIR/transparent.keep" ] && _keep=1
		_access="$(cfg log_dir "/var/log")/xray-access.log"
		# читаем только хвост журнала: целиком он бывает очень большим, а живое
		# обновление спрашивает это каждые несколько секунд
		[ -f "$_access" ] && _tail=$(tail -n 3000 "$_access" 2>/dev/null | grep -a "transparent" | tail -5)
	fi
	printf '{"active":"%s","service":"%s","svcok":%s,' "$(jesc "$(effective_outbound)")" "$(jesc "$_stxt")" "$_sok"
	printf '"transparent":{"on":"%s","rules":"%s","left":%s,"keep":%s,"last":"%s","tail":"%s"},"bridges":[' \
		"$(jesc "$(cfg transparent 0)")" "$(jesc "$_trules")" "$_left" "$_keep" "$(jesc "$_last")" "$(jesc "$_tail")"
	_first=1
	if [ "$_need_misc" = 1 ]; then
		for _b in $(bridge_sections); do
			_bt=$(uci -q get "$UCI_APP.$_b.tag")
			_bstate=$(bridge_state "$_bt" "$(uci -q get "$UCI_APP.$_b.outbound")"); _brc=$?
			if [ "$_first" = 1 ]; then _first=0; else printf ','; fi
			if [ "$_brc" = 0 ]; then _ok=true; else _ok=false; fi
			_boff=false; bridge_disabled "$_b" && _boff=true
			printf '{"tag":"%s","ok":%s,"off":%s,"state":"%s"}' "$(jesc "$_bt")" "$_ok" "$_boff" "$(jesc "$_bstate")"
		done
	fi
	printf ']'
	# трафик по клиентам — обновляем таблицу «Трафик по клиентам» без перезагрузки
	printf ',"clients":['
	if [ "$_need_clients" = 1 ]; then
	_first=1
		_cex=$(client_exits 120 2>/dev/null)
		_ctr2=$(client_traffic_cached 2>/dev/null)
		_cdns2=$(client_dns_traffic 2>/dev/null)
	# берём всех: и тех, у кого есть счётчики трафика, и тех, кого видно в журнале
	_cips=$( { printf '%s\n' "$_ctr2" | awk 'NF { print $1 }'
		printf '%s\n' "$_cex" | awk -F'\t' 'NF { print $1 }' ; } | LC_ALL=C sort -u )
	for _cip in $_cips; do
		[ -n "$_cip" ] || continue
		_cup=$(printf '%s\n' "$_ctr2" | awk -v t="$_cip" '$1 == t { print $2; exit }')
		_cdn=$(printf '%s\n' "$_ctr2" | awk -v t="$_cip" '$1 == t { print $3; exit }')
		if [ "$_first" = 1 ]; then _first=0; else printf ','; fi
		_cx=$(printf '%s\n' "$_cex" | awk -F'\t' -v t="$_cip" '$1 == t { print $2 "\t" $3 "\t" $4 "\t" $5; exit }')
		_cxtag=${_cx%%	*}; _cxrest=${_cx#*	}
		_cxage=${_cxrest%%	*}; _cxrest2=${_cxrest#*	}
		_cxdst=${_cxrest2%%	*}; _cxother=${_cxrest2#*	}
		[ "$_cxother" = "$_cxdst" ] && _cxother=""
		[ -n "$_cx" ] || { _cxtag=""; _cxage=""; _cxdst=""; }
		_dnsb=$(printf '%s\n' "$_cdns2" | awk -F'\t' -v t="$_cip" '$1 == t { print $2; exit }')
		printf '{"ip":"%s","up":"%s","dn":"%s","tag":"%s","age":"%s","dest":"%s","others":"%s","dns":"%s"}' \
			"$(jesc "$_cip")" "$(jesc "$(human_bytes "${_cup:-0}")")" "$(jesc "$(human_bytes "${_cdn:-0}")")" \
			"$(jesc "${_cxtag}")" "$(jesc "${_cxage}")" "$(jesc "${_cxdst}")" "$(jesc "${_cxother:-}")" "$(jesc "$(human_bytes "${_dnsb:-0}")")"
	done
	fi
	# какие правила работают — чтобы лампочки на «Маршрутах» обновлялись живьём
	printf '],"rules":['
	if [ "$_need_rules" = 1 ]; then
		_first=1
		_rl_txt=$(rules_activity 2>/dev/null)
		printf '%s\n' "$_rl_txt" | while IFS="$(printf '\t')" read -r _rs _rage _rdst _rout _rtop; do
		[ -n "$_rs" ] || continue
		if [ "$_first" = 1 ]; then _first=0; else printf ','; fi
		printf '{"sec":"%s","age":"%s","dest":"%s","out":"%s","top":"%s"}' \
			"$(jesc "$_rs")" "$(jesc "${_rage:-}")" "$(jesc "${_rdst:-}")" "$(jesc "${_rout:-}")" "$(jesc "${_rtop:-}")"
	done
	fi
	# через какой сервер трафик идёт прямо сейчас — для шапки страницы «Прокси»
	_now=""
	[ "$_need_misc" = 1 ] && _now=$(active_server_now)
	# сработавшие записи открытого набора — живая подсветка на «Маршрутах»
	printf '],"setitems":['
	if [ "$_need_rules" = 1 ]; then
		_setsel=$(cfg rules_set "")
		if [ -n "$_setsel" ]; then
			_first=1
			set_items_activity "$_setsel" "$_rl_txt" 2>/dev/null | while IFS="$(printf '\t')" read -r _si _sa _sk; do
				[ -n "$_si" ] || continue
				if [ "$_first" = 1 ]; then _first=0; else printf ','; fi
				printf '{"id":"%s","age":"%s","kind":"%s"}' "$(jesc "$_si")" "$(jesc "$_sa")" "$(jesc "$_sk")"
			done
		fi
	fi
	_ntag=""; _nage=""
	if [ -n "$_now" ]; then _ntag=${_now%%	*}; _nage=${_now##*	}; fi
	# трафик для живого обновления: строка «Трафик» в «Прозрачном режиме» и
	# таблица «Куда идёт трафик». Считаем теми же функциями, что и сама
	# страница, поэтому числа совпадают.
	_tup=0; _tdn=0; _dup=0; _ddn=0; _cup=0; _cdn=0; _exj=""
	if [ "$_need_misc" = 1 ]; then
		_tt=$(traffic_totals 2>/dev/null)
		_tup=${_tt%% *}; _r=${_tt#* }; _tdn=${_r%% *}; _r=${_r#* }
		_dup=${_r%% *}; _ddn=${_r##* }
		_ct2=$(client_traffic_cached 2>/dev/null | awk -F'\t' '{ up += $2; dn += $3 } END { printf "%d %d", up, dn }')
		_cup=${_ct2%% *}; _cdn=${_ct2##* }
		_exb=$(exits_period 2>/dev/null)
		[ -n "$_exb" ] || _exb=$(exit_traffic 2>/dev/null)
		_exj=$(printf '%s\n' "$_exb" | awk -F'\t' 'NF >= 3 && $1 != "" {
				t = $1; gsub(/["\\]/, "", t)
				if (n++) printf ",";
				printf "{\"tag\":\"%s\",\"up\":%d,\"dn\":%d}", t, $2 + 0, $3 + 0
			}')
	fi
	# сколько служебных записей пропущено при расчёте лампочек правил
	_lampn=$(cat "$STATE_DIR/lamp-skip.count" 2>/dev/null)
	case "$_lampn" in ''|*[!0-9]*) _lampn=0 ;; esac
	printf '],"now":{"tag":"%s","age":"%s"},"lamp":"%s","traffic":{"cup":%s,"cdn":%s,"tup":%s,"tdn":%s,"dup":%s,"ddn":%s},"exits":[%s]}' \
		"$(jesc "${_ntag}")" "$(jesc "${_nage}")" \
		"${_lampn:-0}" \
		"${_cup:-0}" "${_cdn:-0}" "${_tup:-0}" "${_tdn:-0}" "${_dup:-0}" "${_ddn:-0}" "$_exj"
}

