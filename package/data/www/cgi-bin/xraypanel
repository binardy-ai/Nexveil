	# --- 4. автообновление
	_au=$(cfg geo_auto 0); _asrc=$(cfg geo_auto_src loyalsoldier)
	printf '<h4>'"$T_automatic_update"'</h4>'
	printf '<form method="post"><input type="hidden" name="action" value="geo_auto">'
	printf '<div class="row"><div><label>'"$T_update_databases"'</label><select name="geo_auto">'
	printf '<option value="0"%s>'"$T_disabled"'</option>' "$([ "$_au" = 0 ] && echo ' selected')"
	printf '<option value="7"%s>'"$T_once_a_week_on_mondays_at_4_"'</option>' "$([ "$_au" = 7 ] && echo ' selected')"
	printf '<option value="30"%s>'"$T_once_a_month_on_the_1st_at_4"'</option>' "$([ "$_au" = 30 ] && echo ' selected')"
	printf '</select></div>'
	printf '<div><label>'"$T_source_for_auto_update"'</label><select name="geo_auto_src">'
	for _s in loyalsoldier v2fly russia; do
		case "$_s" in
			loyalsoldier) _lb="Loyalsoldier (как в PassWall)" ;;
			v2fly)        _lb="v2fly (официальные)" ;;
			russia)       _lb="runetfreedom (российские)" ;;
		esac
		printf '<option value="%s"%s>%s</option>' "$_s" "$([ "$_asrc" = "$_s" ] && echo ' selected')" "$_lb"
	done
	printf '</select></div></div>'
	printf '<p><button class="btn sec">'"$T_save_2"'</button> '
	case "$_au" in
		7)  printf '<span class="muted">'"$T_now_on_once_a_week_monday_4_"'</span>' ;;
		30) printf '<span class="muted">'"$T_now_on_once_a_month_1st_4_am"'</span>' ;;
		*)  printf '<span class="muted">'"$T_now_off"'</span>' ;;
	esac
	printf '</p></form>'
	# --- 5. журналы: три отдельных, чтобы было видно, где что происходит
	_gulog="$STATE_DIR/geo-update.log"
	if [ -f "$_gulog" ]; then
		printf '<details class="pick"><summary>'"$T_update_log_from_the_internet"'</summary><pre>%s</pre></details>' "$(tail -n 25 "$_gulog" | h_in)"
	fi
	_gtlog="$STATE_DIR/geo-tags.log"
	if [ -f "$_gtlog" ]; then
		printf '<details class="pick"><summary>'"$T_name_collection_log"'</summary><pre>%s</pre></details>' "$(tail -n 20 "$_gtlog" | h_in)"
	fi
	_gilog="$STATE_DIR/geo-item.log"
	if [ -f "$_gilog" ]; then
		printf '<details class="pick"><summary>'"$T_set_list_parsing_log"'</summary><pre>%s</pre></details>' "$(tail -n 20 "$_gilog" | h_in)"
	fi
}

