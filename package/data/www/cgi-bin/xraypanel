			"$_ng" "$_ni" "$(h "$(file_date "$(geo_tags_cache)")")"
		# видно, чего не хватает: файл есть, а названий из него нет
		if [ -n "$_sf" ] && [ "${_ng:-0}" = 0 ]; then
			printf '<p class="bad">Списки доменов не разобрались, хотя файл есть. Нажмите «собрать названия заново» и посмотрите журнал ниже.</p>'
		fi
		if [ -n "$_if" ] && [ "${_ni:-0}" = 0 ]; then
			printf '<p class="bad">Списки адресов не разобрались, хотя файл есть. Нажмите «собрать названия заново» и посмотрите журнал ниже.</p>'
		fi
		# файлы обновились после сбора — предлагаем пересобрать
		if ! geo_cache_fresh; then
			printf '<p class="muted">'"$T_the_set_of_files_changed_aft"'</p>'
		fi
		printf '<p><button type="button" class="btn sec geo-build">'"$T_rebuild_names"'</button> <span class="muted" id="geo-note"></span></p>'
