	[ -n "$_msg" ] && printf '<div class="msg" id="page-msg" style="display:none">%s</div>\n' "$(h "$_msg")"
	if [ -n "$_pend" ]; then
		printf '<p class="muted" style="margin:0 0 10px">'"$T_changed_but_not_applied_yet_"'</p>\n' "$(h "$_pend")"
	fi
}

# кнопка «Применить конфиг» — одна и та же на всех страницах,
# $1 = куда вернуться после применения
apply_form() {
	# Надпись на кнопке: пока есть неприменённые изменения — «применить конфиг»
	# красным, а после применения — «конфиг применён» зелёным.
	if config_dirty || [ -n "$(pending_list 1 2>/dev/null)" ]; then
		_lbl="$T_apply_config"; _cls="btn apply-btn pending"
	else
		_lbl="$T_config_applied"; _cls="btn apply-btn done"
	fi
	printf '<form method="post" style="display:inline"><input type="hidden" name="action" value="apply"><input type="hidden" name="back" value="%s"><button class="%s">%s</button></form>' "$(h "$1")" "$_cls" "$_lbl"
}

# компактная строка настроек: подпись | поле | подсказка в одну строку
opt_row() { # $1 = подпись, $2 = готовый html поля, $3 = подсказка
	printf '<div class="opt"><label>%s</label><div class="opt-f">%s</div><span class="opt-h" title="%s">%s</span></div>\n' \
		"$(h "$1")" "$2" "$(h "$3")" "$(h "$3")"
}

# строка-поле ввода
opt_input() { # $1=подпись $2=имя $3=значение $4=подсказка (placeholder) $5=подсказка справа
	printf '<div class="opt"><label>%s</label><div class="opt-f"><input name="%s" value="%s" placeholder="%s"></div><span class="opt-h" title="%s">%s</span></div>\n' \
		"$(h "$1")" "$(h "$2")" "$(h "$3")" "$(h "$4")" "$(h "$5")" "$(h "$5")"
}

# начало строки с выпадающим списком и её конец (пункты печатаются между ними)
opt_select_open() { # $1=подпись $2=имя
	printf '<div class="opt"><label>%s</label><div class="opt-f"><select name="%s">' "$(h "$1")" "$(h "$2")"
}
opt_select_close() { # $1=подсказка справа
	printf '</select></div><span class="opt-h" title="%s">%s</span></div>\n' "$(h "$1")" "$(h "$1")"
}

# начало и конец строки с произвольным содержимым (галочки, раскрывающийся список)
opt_html_open() { # $1=подпись, $2=доп. класс (например wide — в один столбец)
	printf '<div class="opt%s"><label>%s</label><div class="opt-f">' "${2:+ $2}" "$(h "$1")"
}
opt_html_close() { # $1=подсказка справа
	printf '</div><span class="opt-h" title="%s">%s</span></div>\n' "$(h "$1")" "$(h "$1")"
}

page_footer() {
	printf '</main>\n'
	# Звук кнопок: имя звука и громкость отдаём странице маленьким скриптом.
	# Своих звуковых файлов в пакете нет — звук синтезирует сам браузер, поэтому
	# он не занимает места и не тянет загрузку.
	printf '<script>window.__xpSound="%s";window.__xpVolume="%s";window.__xpLbl={apply:"%s",done:"%s"};</script>\n' \
		"$(h "$(cfg sound click)")" "$(h "$(cfg volume mid)")" "$(h "$T_apply_config")" "$(h "$T_config_applied")"
