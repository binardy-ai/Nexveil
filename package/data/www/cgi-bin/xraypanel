# --- страница «Маршруты» в модели 0.62: наборы + правила ---------------------
rule_source_multi() { # $1 = источники через запятую
	_cur=" $1 "
	printf '<select name="source" multiple size="5" style="min-width:230px">'
	_sub=$(lan_subnet)
	if [ -n "$_sub" ]; then
		case "$_cur" in *" $_sub "*) _sel=' selected' ;; *) _sel="" ;; esac
		printf '<option value="%s"%s>'"$T_the_whole_local_network_s"'</option>' "$(h "$_sub")" "$_sel" "$(h "$_sub")"
	fi
	_rlip=$(uci -q get network.lan.ipaddr 2>/dev/null)
	case "$_rlip" in
		''|*[!0-9.]*) ;;
		*)
			case "$_cur" in *" $_rlip "*) _sel=' selected' ;; *) _sel="" ;; esac
			printf '<option value="%s"%s>'"$T_the_router_itself_s"'</option>' "$(h "$_rlip")" "$_sel" "$(h "$_rlip")"
			;;
	esac
	lan_clients_named 2>/dev/null | while IFS="$(printf '\t')" read -r _nm _ip; do
		[ -n "$_ip" ] || continue
		case "$_cur" in *" $_ip "*) _sel=' selected' ;; *) _sel="" ;; esac
		printf '<option value="%s"%s>%s (%s)</option>' "$(h "$_ip")" "$_sel" "$(h "$_nm")" "$(h "$_ip")"
