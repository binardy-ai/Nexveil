	printf '<select name="source" id="rule-source"><option value="">'"$T_all_devices"'</option>'
	if [ -n "$_sub" ]; then
		printf '<option value="%s"%s>'"$T_the_whole_local_network_s"'</option>' "$(h "$_sub")" "$([ "$_cur" = "$_sub" ] && echo ' selected')" "$(h "$_sub")"
	fi
	lan_clients_named 2>/dev/null | while IFS="$(printf '\t')" read -r _cnm _cip; do
		[ -n "$_cip" ] || continue
		printf '<option value="%s"%s>%s (%s)</option>' "$(h "$_cip")" "$([ "$_cur" = "$_cip" ] && echo ' selected')" "$(h "$_cnm")" "$(h "$_cip")"
	done
	# адрес, которого нет среди подключённых, показываем отдельным пунктом,
	# иначе при сохранении правила он бы потерялся
	case "$_cur" in
