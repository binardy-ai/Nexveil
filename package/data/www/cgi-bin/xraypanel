		var card = document.getElementById('update-card');
		if (!card) return;
		if (!document.getElementById('update-wait')) return;   /* проверка уже закончилась */
		if (tries++ > 20) return;
		setTimeout(function () {
			fetch('?page=update_card&t=' + Date.now(), { cache: 'no-store' })
				.then(function (r) { return r.text(); })
				.then(function (html) {
					var doc = new DOMParser().parseFromString(html, 'text/html');
					var fresh = doc.querySelector('#update-card');
					var cur = document.getElementById('update-card');
					if (fresh && cur) cur.innerHTML = fresh.innerHTML;
