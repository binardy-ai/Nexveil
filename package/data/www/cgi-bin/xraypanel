rule_out_select() { # $1 = текущий выход, $2 = имя поля (по умолчанию outbound)
	_cur="$1"
	_nm="${2:-outbound}"
	printf '<select name="%s">' "$_nm"
	printf '<option value="auto"%s>'"$T_by_best_ping"'</option>' "$([ "$_cur" = auto ] && echo ' selected')"
	printf '<option value="direct"%s>'"$T_straight"'</option>' "$([ "$_cur" = direct ] && echo ' selected')"
	for _s in $(server_sections); do
		_t=$(server_tag "$_s")
		server_is_reverse "$_t" && continue
		printf '<option value="%s"%s>'"$T_server_s"'</option>' "$(h "$_t")" "$([ "$_cur" = "$_t" ] && echo ' selected')" "$(h "$_t")"
	done
	# если в правиле остался выход, которого нет в списке (заблокировать,
	# реверс-мост, интерфейс) — показываем его отдельной строкой, чтобы
	# при сохранении он не потерялся
	case "$_cur" in
		''|auto|direct) ;;
		*)
			_known=0
			for _s in $(server_sections); do
				[ "$(server_tag "$_s")" = "$_cur" ] && _known=1
			done
			[ "$_known" = 1 ] || printf '<option value="%s" selected>'"$T_s_current"'</option>' "$(h "$_cur")" "$(h "$(out_text "$_cur")")"
			;;
	esac
	printf '</select>'
}

out_text() { # $1 = выход -> подпись
	case "$1" in
		auto)    printf 'по пингу' ;;
		direct)  printf 'напрямую' ;;
		blocked) printf 'заблокировать' ;;
		iface:*) printf 'через интерфейс %s' "${1#iface:}" ;;
		'')      printf '—' ;;
		*)       printf '%s' "$1" ;;
	esac
}

set_item_type_title() { # $1 = тип
	case "$1" in
		ip)      printf 'адрес или сеть' ;;
		geoip)   printf 'список адресов' ;;
		domain)  printf 'домен и поддомены' ;;
		full)    printf 'ровно этот домен' ;;
		keyword) printf 'слово в имени' ;;
		regexp)  printf 'шаблон' ;;
		geosite) printf 'список доменов' ;;
		'')      printf 'как есть' ;;
		*)       printf '%s' "$1" ;;
	esac
}


