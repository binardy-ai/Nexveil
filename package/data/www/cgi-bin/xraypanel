#!/bin/sh
# Веб-панель xraypanel для OpenWrt/ImmortalWrt.
# CGI-скрипт для uhttpd. Открывается в браузере: http://<роутер>/cgi-bin/xraypanel

. /tmp/stage2/lib.sh 2>/dev/null || {
	echo "Status: 500"
	echo "Content-Type: text/plain; charset=utf-8"
	echo
	echo "не найден /tmp/stage2/lib.sh — пакет установлен не полностью"
	exit 0
}
. /tmp/stage2/themes.sh 2>/dev/null
# если файла тем нет (старый пакет) — работаем без оформления
command -v theme_style >/dev/null 2>&1 || { theme_name() { printf 'classic'; }; theme_style() { :; }; }
# язык интерфейса: строки берутся из /tmp/stage2/lang/<язык>.sh
lang_load 2>/dev/null

METHOD="${REQUEST_METHOD:-GET}"
SCRIPT_NAME="${SCRIPT_NAME:-/cgi-bin/xraypanel}"
mkdir -p "$STATE_DIR" 2>/dev/null
PARAMS="$STATE_DIR/params.$$"
: > "$PARAMS"
trap 'rm -f "$PARAMS" "$UPLOAD" 2>/dev/null' EXIT

[ -n "${QUERY_STRING:-}" ] && printf '%s\n' "$QUERY_STRING" | tr '&' '\n' >> "$PARAMS"
UPLOAD=""
_mb=""
case "${CONTENT_TYPE:-}" in
	multipart/form-data*)
		# загрузка файла из проводника: разбираем multipart сами
		UPLOAD="/tmp/xraypanel-upload.$$"
		# читаем тело с ограничением 1 МБ: файл настроек больше не бывает,
		# а держать в /tmp чужие данные произвольного размера не нужно
		dd bs=4096 count=256 of="$UPLOAD" 2>/dev/null || cat > "$UPLOAD"
		_mb=$(printf '%s' "${CONTENT_TYPE#*boundary=}" | tr -d '"\r')
		if [ -n "$_mb" ]; then
			# строка-разделитель начинается с "--" + boundary и может
			# заканчиваться на "--" (последняя часть формы)
			awk -v delim="--$_mb" -v want="action" '
				{ sub(/\r$/, "") }
				BEGIN { st = 0 }
				index($0, delim) == 1 { st = 1; hdr = ""; next }
				st == 1 {
					if ($0 == "") { st = (hdr ~ ("name=\"" want "\"")) ? 2 : 0; next }
					hdr = hdr " " $0; next
				}
				st == 2 { print want "=" $0 }
			' "$UPLOAD" | tr -d '\r\n' >> "$PARAMS"
			printf '\n' >> "$PARAMS"
		fi
		;;
	*)
		;;
esac
if [ "$METHOD" = "POST" ] && [ -z "$UPLOAD" ]; then
	cat | tr '&' '\n' >> "$PARAMS"
	# тело может прийти без завершающего перевода строки — иначе последняя
	# строка теряется при чтении в цикле
	printf '\n' >> "$PARAMS"
fi

param() { # param имя [значение по умолчанию]
	_v=$(sed -n "s/^$1=//p" "$PARAMS" 2>/dev/null | head -1)
	[ -n "$_v" ] && urldecode "$_v" || printf '%s' "${2:-}"
}

# номер порта: только цифры, 1..65535
valid_port() {
	case "$1" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ "$1" -ge 1 ] 2>/dev/null && [ "$1" -le 65535 ] 2>/dev/null
}

# все значения ключа (для галочек: client=1.2.3.4&client=1.2.3.5)
params_all() {
	sed -n "s/^$1=//p" "$PARAMS" 2>/dev/null | while IFS= read -r _v || [ -n "$_v" ]; do
		[ -n "$_v" ] && urldecode "$_v"
		printf '\n'
	done
}

# было ли такое поле в запросе (в отличие от «пришло пустым»): по этому панель
# понимает, что поле вообще не присылали и менять его не нужно
params_present() {
	grep -q "^$1=" "$PARAMS" 2>/dev/null
}

urlenc() { # простое кодирование для сообщений и ссылок
	printf '%s' "$1" | sed -e 's/%/%25/g' -e 's/ /%20/g' -e 's/&/%26/g' -e 's/#/%23/g' -e 's/?/%3F/g' -e 's/+/%2B/g' -e 's/=/%3D/g'
}

uniq_list() { # список через запятую: без пустых значений и повторов
	printf '%s' "$1" | tr ',' '\n' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' \
		| awk 'NF && !seen[$0]++' | tr '\n' ',' | sed 's/,$//'
}

respond_401() {
	echo "Status: 401 Unauthorized"
	echo "WWW-Authenticate: Basic realm=\"xraypanel\""
	echo "Content-Type: text/plain; charset=utf-8"
	echo
	echo "нужен логин и пароль"
	exit 0
}

# --- авторизация (если в настройках задан пароль) ---------------------------
PW=$(cfg password "")
if [ -n "$PW" ]; then
	AUTH="${HTTP_AUTHORIZATION:-}"
	[ -z "$AUTH" ] && [ -n "${REDIRECT_HTTP_AUTHORIZATION:-}" ] && AUTH="$REDIRECT_HTTP_AUTHORIZATION"
	case "$AUTH" in
		Basic\ *) USERPW=$(printf '%s' "${AUTH#Basic }" | base64 -d 2>/dev/null) ;;
		*) USERPW="" ;;
	esac
	[ "$USERPW" = "admin:$PW" ] || respond_401
fi

redirect() { # redirect "страница" "сообщение"
	# тихий режим: страница сама обновит нужный блок, перезагрузка не нужна
		if [ "$(param ajax)" = 1 ]; then
			printf 'Content-Type: application/json; charset=utf-8\n\n'
			if [ -n "$_AJAX_HTML" ]; then
				printf '{"ok":true,"msg":"%s","target":"%s","html":"%s"}\n' \
					"$(jesc "$2")" "$(jesc "$_AJAX_TARGET")" "$(jesc "$_AJAX_HTML")"
			else
				# «go» — куда вернуться после тихого сохранения. Страницы-редакторы
				# (мост, сервер, правило) после сохранения должны уходить на свой
				# список, а не оставаться в форме: раньше после «Сохранить мост»
				# пользователь так и оставался в редактировании.
				printf '{"ok":true,"msg":"%s","go":"%s"}\n' "$(jesc "$2")" "$(jesc "$1")"
			fi
			# ВАЖНО: не выходим — действие ещё должно доработать (перезапуск,
			# фоновые задачи). Ответ уже отдан, браузеру он и нужен.
			exit 0
		fi
	echo "Status: 303 See Other"
	printf 'Location: %s?page=%s&msg=%s\n' "$SCRIPT_NAME" "$1" "$(urlenc "$2")"
	echo "Content-Type: text/html; charset=utf-8"
	echo
	echo "<a href=\"$SCRIPT_NAME?page=$1\">$T_continue</a>"
	exit 0
}

# Отдать ответ браузеру и НЕ завершать скрипт. Нужно перед перезапуском xray:
# браузер получает готовый ответ сразу, а перезапуск идёт уже после него.
respond_now() { # respond_now "страница" "сообщение"
	# тихий режим: отвечаем JSON, страница обновит надписи сама
	if [ "$(param ajax)" = 1 ]; then
		printf 'Content-Type: application/json; charset=utf-8\n\n'
		if [ -n "$_AJAX_HTML" ]; then
			printf '{"ok":true,"msg":"%s","target":"%s","html":"%s"}\n' \
				"$(jesc "$2")" "$(jesc "$_AJAX_TARGET")" "$(jesc "$_AJAX_HTML")"
		else
			printf '{"ok":true,"msg":"%s","go":"%s"}\n' "$(jesc "$2")" "$(jesc "$1")"
		fi
		# не выходим: действие ещё должно доработать (включение правил, перезапуск)
		return 0
	fi
	echo "Status: 303 See Other"
	printf 'Location: %s?page=%s&msg=%s\n' "$SCRIPT_NAME" "$1" "$(urlenc "$2")"
	echo "Content-Length: 0"
	echo "Content-Type: text/html; charset=utf-8"
	echo
}

ui_uci() { uci -q "$@" >/dev/null 2>&1; }

# --- сохранение настроек -----------------------------------------------------
act_save_server() {
	_want=$(param sec)
	_existed=$(uci -q get "$UCI_APP.$_want" 2>/dev/null)
	_sec=$(ensure_section server "$_want")
	[ -n "$_sec" ] || redirect servers "не удалось создать раздел сервера"
	for _f in tag protocol address port uuid flow sni publickey shortid fingerprint method password insecure wg_private wg_peer wg_address wg_allowed mtu network path hosthdr tls hy_obfs hy_obfs_pass; do
		_v=$(param "$_f")
		# тег приводим к безопасному виду: пробелы и посторонние символы ломают
		# и конфиг xray, и саму панель (она разбирает списки тегов по пробелам)
		[ "$_f" = tag ] && [ -n "$_v" ] && _v=$(tag_clean "$_v")
		if [ -n "$_v" ]; then ui_uci set "$UCI_APP.$_sec.$_f=$_v"; else ui_uci delete "$UCI_APP.$_sec.$_f"; fi
	done
	uci commit "$UCI_APP" >/dev/null 2>&1
	_nt=$(param tag); [ -n "$_nt" ] || _nt="$_sec"
	if [ -n "$_existed" ]; then pending_note "изменён сервер «$_nt»"; else pending_note "добавлен сервер «$_nt»"; fi
	_pk=$(param publickey)
	_netp=$(param network)
	_protop=$(param protocol)
	case "$_protop" in ''|vless) _isvless=1 ;; *) _isvless=0 ;; esac
	case "$_netp" in ws|websocket) _isws=1 ;; *) _isws=0 ;; esac
	if [ "$_isvless" = 1 ] && [ "$_isws" = 0 ] && [ -z "$_pk" ]; then
		# без публичного ключа xray вообще не запускается — говорим сразу
		_hint=" Внимание: для VLESS через Reality нужен публичный ключ (pbk), иначе xray не запустится. Если это подключение через WebSocket — укажите «Сеть: ws»."
	elif [ -n "$_pk" ] && ! reality_key_ok "$_pk"; then
		_hint=" Внимание: публичный ключ Reality обычно 43 символа — проверь pbk."
	else
		_hint=""
	fi
	if [ "$(param protocol)" = ss ]; then
		_badk=$(ss_key_check "$(param method)" "$(param password)")
		[ -n "$_badk" ] && _hint="$_hint Внимание: $_badk."
	fi
	[ -n "$_existed" ] && redirect servers "сервер сохранён. Осталось нажать «Применить конфиг» на странице «Статус».$_hint" \
		|| redirect servers "сервер добавлен. Осталось нажать «Применить конфиг» на странице «Статус».$_hint"
}

act_del_server() {
	_sec=$(param sec)
	_nt=$(uci -q get "$UCI_APP.$_sec.tag" 2>/dev/null); [ -n "$_nt" ] || _nt="$_sec"
	[ -n "$_sec" ] && { ui_uci delete "$UCI_APP.$_sec"; uci commit "$UCI_APP" >/dev/null 2>&1; }
	[ -n "$_sec" ] && pending_note "удалён сервер «$_nt»"
	redirect servers "сервер удалён"
}

act_save_bridge() {
	_want=$(param sec)
	_existed=$(uci -q get "$UCI_APP.$_want" 2>/dev/null)
	_sec=$(ensure_section bridge "$_want")
	[ -n "$_sec" ] || redirect bridges "не удалось создать раздел моста"
	for _f in tag domain outbound net_outbound; do
		_v=$(param "$_f")
		[ "$_f" = tag ] && [ -n "$_v" ] && _v=$(tag_clean "$_v")
		if [ -n "$_v" ]; then ui_uci set "$UCI_APP.$_sec.$_f=$_v"; else ui_uci delete "$UCI_APP.$_sec.$_f"; fi
	done
	_bt=$(param tag)
	_bd=$(param domain)
	# способ реверса у моста: пусто — «как у роутера», иначе legacy или new
	_style=$(param style)
	case "$_style" in
		legacy|new) ui_uci set "$UCI_APP.$_sec.style=$_style" ;;
		*)          ui_uci delete "$UCI_APP.$_sec.style" ;;
	esac
	uci commit "$UCI_APP" >/dev/null 2>&1
	_bnt=$(param tag); [ -n "$_bnt" ] || _bnt="$_sec"
	if [ -n "$_existed" ]; then pending_note "изменён мост «$_bnt»"; else pending_note "добавлен мост «$_bnt»"; fi
	if [ -z "$_bt" ]; then
		redirect bridges "мост сохранён, но не хватает данных: нужен «Тег моста» (как на сервере-портале)"
	fi
	_bstyle=$(bridge_style "$_sec")
	# домен нужен только старому способу: в новом (VLESS Reverse Proxy)
	# связь идёт по тегу, и домена на портале нет
	if [ "$_bstyle" = legacy ] && [ -z "$_bd" ]; then
		redirect bridges "мост сохранён, но для старого способа нужен «Домен» (как на сервере-портале). Либо выберите новый способ реверса — там домен не нужен."
	fi
	[ -n "$_existed" ] && redirect bridges "реверс-мост сохранён. Осталось нажать «Применить конфиг» на странице «Статус»." \
		|| redirect bridges "реверс-мост добавлен. Осталось нажать «Применить конфиг» на странице «Статус»."
}

act_del_bridge() {
	_sec=$(param sec)
	_bnt=$(uci -q get "$UCI_APP.$_sec.tag" 2>/dev/null); [ -n "$_bnt" ] || _bnt="$_sec"
	[ -n "$_sec" ] && { ui_uci delete "$UCI_APP.$_sec"; uci commit "$UCI_APP" >/dev/null 2>&1; }
	[ -n "$_sec" ] && pending_note "удалён мост «$_bnt»"
	redirect bridges "реверс-мост удалён"
}

# --- обновление самой панели -------------------------------------------------
act_update_check() { # проверить новые версии панели в релизах GitHub
	[ -n "$(cfg update_repo "Petr700/xraypanel")" ] || redirect status "не указан репозиторий для проверки обновлений — впишите его на странице «Настройки»"
	bg_run "$UPDATE_ENV sh '$UPDATE_CHECK'" "$STATE_DIR/update.log"
	respond_now status "проверяю новые версии — результат появится на этой странице через несколько секунд"
	exit 0
}

act_update_install() { # скачать и поставить новую версию панели
	_nver=$(update_field version 2>/dev/null)
	_geturl=$(update_field url 2>/dev/null)
	[ -n "$_geturl" ] || redirect status "нет данных о новой версии — сначала нажмите «проверить сейчас»"
	rm -f "$STATE_DIR/update-install.rc" 2>/dev/null
	bg_run "$UPDATE_ENV sh '$UPDATE_INSTALL' '$_geturl'" "$STATE_DIR/update-install.log"
	respond_now status "скачиваю и ставлю версию ${_nver:-из релиза} — через 20–40 секунд обновите страницу. Настройки, серверы и правила не трогаются."
	exit 0
}

# Общий способ сборки реверс-мостов. Выбрать можно только то, что понимает
# установленный бинарник xray: иначе панель писала бы в конфиг блок, из-за
# которого xray вообще откажется запускаться.
act_rev_style() {
	_v=$(param style)
	case "$_v" in
		legacy|new) ;;
		*) redirect bridges "неизвестный способ реверса — ничего не менял" ;;
	esac
	_cap=$(reverse_bin_support 2>/dev/null)
	if [ "$_v" = legacy ] && [ "$_cap" != both ]; then
		redirect bridges "установленный xray старый реверс не понимает (его удалили в свежих сборках) — этот способ выбрать нельзя. Поставьте сборку до 26.4.18 или переключите мосты на новый способ"
	fi
	if [ "$_v" = new ] && [ "$_cap" = none ]; then
		redirect bridges "установленный xray не умеет ни старый, ни новый реверс — проверьте бинарник на странице «Настройки»"
	fi
	printf '%s' "$_v" > "$STATE_DIR/reverse.style" 2>/dev/null
	pending_note "изменён общий способ реверса: $([ "$_v" = legacy ] && echo 'старый (по домену)' || echo 'новый (по тегу)')"
	respond_now bridges "общий способ реверса изменён — нажмите «применить конфиг», чтобы он попал в конфиг xray"
	exit 0
}

act_save_rule() {
	_want=$(param sec)
	# имени у правила больше нет — придумываем своё (r1, r2, …)
	[ -n "$_want" ] || _want=$(rule_new_name)
	_existed=$(uci -q get "$UCI_APP.$_want" 2>/dev/null)
	_sec=$(ensure_section rule "$_want")
	[ -n "$_sec" ] || redirect rules "не удалось создать раздел правила"
	# правило новой модели: кто идёт → какие наборы → через что выходим
	_src=$(params_all source | tr '\n' ',' | sed -e 's/,,*/,/g' -e 's/^,//' -e 's/,$//')
	_sets=$(params_all set | tr '\n' ',' | sed -e 's/,,*/,/g' -e 's/^,//' -e 's/,$//')
	_out=$(param outbound)
	[ -n "$_out" ] || _out=auto
	if [ -n "$_src" ]; then ui_uci set "$UCI_APP.$_sec.source=$_src"; else ui_uci delete "$UCI_APP.$_sec.source"; fi
	if [ -n "$_sets" ]; then ui_uci set "$UCI_APP.$_sec.sets=$_sets"; else ui_uci delete "$UCI_APP.$_sec.sets"; fi
	ui_uci set "$UCI_APP.$_sec.outbound=$_out"
	# поля старой модели у этого правила больше не нужны
	ui_uci delete "$UCI_APP.$_sec.value"
	ui_uci delete "$UCI_APP.$_sec.type"
	ui_uci delete "$UCI_APP.$_sec.category"
	# и старое «значение» из формы (если пришло) — кладём записью в первый набор
	_rt=$(param type); _rv=$(param value)
	if [ -n "$_rv" ] && [ -n "$_sets" ]; then
		for _st in $(printf '%s' "$_sets" | tr ',' ' '); do
			[ -n "$_st" ] || continue
			_split=$(rule_split_value "$_rv")
			_stt=$(printf '%s' "$_split" | cut -f1); _sv=$(printf '%s' "$_split" | cut -f2)
			[ -n "$_stt" ] || _stt=$_rt
			item_create "$_st" "$_stt" "$_sv" >/dev/null
			break
		done
	fi
	# «куда идём» — панель сама понимает, адрес это или домен
	# тип выбирается в форме: адрес, домен, точный домен, слово, шаблон или
	# готовый список (geosite / geoip). Если его не передали — определяем сами.
	_t=$(param type)
	_v=$(param value)
	case "$_t" in
		ip|domain|full|keyword|regexp|geosite|geoip) ;;
		*) _t=$(guess_rule_type "$_v") ;;
	esac
	# если в поле вставили готовое название с префиксом (geosite:ru) —
	# разбираем его на тип и значение
	_split=$(rule_split_value "$_v")
	_st=$(printf '%s' "$_split" | cut -f1)
	if [ -n "$_st" ]; then
		_t="$_st"; _v=$(printf '%s' "$_split" | cut -f2)
		ui_uci set "$UCI_APP.$_sec.value=$_v"
	fi
	# битый или «ловящий всё» шаблон не сохраняем: с битым xray не запустится,
	# а «ловящий всё» тихо завернёт весь трафик
	if [ "$_t" = regexp ]; then
		_rs=$(regexp_problem "$_v")
		if [ -n "$_rs" ]; then
			uci -q revert "$UCI_APP"
			redirect rules "шаблон не сохраняю: $_v — $_rs"
		fi
	fi
	if [ -n "$_t" ]; then ui_uci set "$UCI_APP.$_sec.type=$_t"; else ui_uci delete "$UCI_APP.$_sec.type"; fi
	uci commit "$UCI_APP" >/dev/null 2>&1
	# если выбрано готовое название из файлов роутера — проверяем, что оно там
	# действительно есть: иначе правило молча ничего не делает
	_geo_warn=""
	case "$_t" in
		geosite|geoip)
			if geo_cache_ready && ! geo_tag_exists "$_t" "$_v"; then
				_sim=$(geo_tag_similar "$_t" "$_v")
				if [ -n "$_sim" ]; then
					_geo_warn=" Внимание: в файлах роутера этот список называется «$_sim» — регистр букв важен."
				else
					_geo_warn=" Внимание: в файлах роутера нет списка «$_v» — проверьте название (кнопка «проверить» на странице «Маршруты»)."
				fi
			fi
			;;
	esac
	if [ -z "$_existed" ]; then
		# новое правило ставим на самый верх: свежее обычно самое важное,
		# а порядок всегда можно поправить кнопками ↑ ↓ ⤒ ⤓
		rule_move_first "$_sec"
	fi
	if [ -n "$_existed" ]; then pending_note "изменено правило: $_v"; else pending_note "добавлено правило: $_v"; fi
	[ -n "$_existed" ] && redirect rules "правило сохранено. Осталось нажать «Подтвердить конфиг».$_geo_warn" \
		|| redirect rules "правило добавлено. Осталось нажать «Подтвердить конфиг».$_geo_warn"
}

act_rule_move() { # сдвинуть правило вверх или вниз
	rule_move "$(param sec)" "$(param dir)" || redirect rules "не получилось передвинуть правило"
	pending_note "изменён порядок правил"
	# тихий режим: страница сама переставит строки, перезагрузка не нужна
	if [ "$(param ajax)" = 1 ]; then
		printf 'Content-Type: application/json; charset=utf-8\n\n{"order":['
		_f=1
		for _r in $(rule_sections); do
			if [ "$_f" = 1 ]; then _f=0; else printf ','; fi
			printf '"%s"' "$(jesc "$_r")"
		done
		printf ']}'
		exit 0
	fi
	redirect rules "порядок правил обновлён. Осталось нажать «Подтвердить конфиг»."
}

act_rule_toggle() { # выключить правило, не удаляя его
	_sec=$(param sec)
	[ -n "$_sec" ] || redirect rules "правило не выбрано"
	if rule_disabled "$_sec"; then
		ui_uci delete "$UCI_APP.$_sec.disabled"
		uci commit "$UCI_APP" >/dev/null 2>&1
