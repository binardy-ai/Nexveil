	printf '<h3>'"$T_1_list_files_on_the_router"'</h3>'
	printf '<p class="muted">'"$T_the_panel_takes_the_list_nam"'</p>'
	printf '<table><tr><th>'"$T_file"'</th><th>'"$T_contains"'</th><th>'"$T_size"'</th><th>'"$T_modified"'</th><th>'"$T_names_parsed"'</th></tr>'
	# /usr/share/xray/geosite.dat обычно ссылка на /usr/share/v2ray/geosite.dat:
	# показываем такой файл один раз, иначе таблица дублируется зря
	_seenreal=""
	printf '%s\n%s\n' "$_sf" "$_if" | while IFS="$(printf '\t')" read -r _f _n; do
		[ -n "$_f" ] || continue
		_real=$(readlink -f "$_f" 2>/dev/null)
		[ -n "$_real" ] || _real="$_f"
		case " $_seenreal " in *" $_real "*) continue ;; esac
		_seenreal="$_seenreal $_real"
		case "$_n" in
			*geoip*) _what="адреса" ;;
			*)       _what="домены" ;;
		esac
		_got=$(geo_files_report 2>/dev/null | awk -F'\t' -v f="$_f" '$1 == f { print $3 }' | head -1)
		# если файл найден по ссылке, отчёт может быть записан на её настоящий
		# путь — тогда берём число оттуда
		[ -n "$_got" ] || _got=$(geo_files_report 2>/dev/null | while IFS="$(printf '\t')" read -r _rf _rk _rc; do
			_rr=$(readlink -f "$_rf" 2>/dev/null)
			[ "$_rr" = "$_real" ] && { printf '%s\n' "$_rc"; break; }
		done)
		case "$_got" in
			''|*[!0-9]*) _gtxt='<span class="muted">'"$T_not_parsed_yet"'</span>' ;;
			0)           _gtxt='<span class="bad">0 — не разобрался</span>' ;;
			*)           _gtxt="<b>$_got</b>" ;;
		esac
