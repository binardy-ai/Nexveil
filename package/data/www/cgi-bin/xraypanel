			esac
			_list="$_list$_ip|${_host:-без имени}|$_mac
"
		done < "$_dhcp"
	fi
	if [ -n "$_list" ]; then
		if [ "$_acting" = 0 ]; then
			# режим ещё не включён — выбираем галочками
			printf '<p class="muted">'"$T_mark_the_clients_you_need_an"'</p>'
			printf '<table class="responsive"><tr><th>'"$T_route"'</th><th>'"$T_name_2"'</th><th>'"$T_address_2"'</th><th>'"$T_mac"'</th><th>'"$T_traffic_2"'</th><th>'"$T_goes_through"'</th><th></th></tr>'
		else
			# режим включён: галочек нет, список только для просмотра
			printf '<p class="muted">'"$T_mode_is_on_span_class_ok_gre"'</p>'
			printf '<table class="responsive"><tr><th>'"$T_name_2"'</th><th>'"$T_address_2"'</th><th>'"$T_mac"'</th><th>'"$T_traffic_2"'</th><th>'"$T_goes_through"'</th><th></th></tr>'
		fi
		_cdns_all=$(client_dns_traffic 2>/dev/null)
		printf '%s' "$_list" | while IFS='|' read -r _ip _host _mac; do
			[ -n "$_ip" ] || continue
			_ck=""
			# галочки по умолчанию стоят у всех: пустой список означает «все»
			case "$_pc" in
				'') _ck=checked ;;
				*)  case ",$_pc," in *",$_ip,"*) _ck=checked ;; esac ;;
			esac
			_cup=$(printf '%s\n' "$_ctr" | awk -v t="$_ip" '$1 == t { print $2 }' | head -1)
			_cdn=$(printf '%s\n' "$_ctr" | awk -v t="$_ip" '$1 == t { print $3 }' | head -1)
			_ctraf="—"
			[ -n "$_cup$_cdn" ] && _ctraf="↑ $(human_bytes "${_cup:-0}") / ↓ $(human_bytes "${_cdn:-0}")"
			# куда уходит трафик именно этого клиента
			_cx=$(printf '%s\n' "$_cex" | awk -F'\t' -v t="$_ip" '$1 == t { print $2 "\t" $3 "\t" $4 "\t" $5; exit }')
			if [ -n "$_cx" ]; then
				_cxtag=${_cx%%	*}
				_cxrest=${_cx#*	}
				_cxage=${_cxrest%%	*}
				_cxrest2=${_cxrest#*	}
				_cxdst=${_cxrest2%%	*}
				_cxother=${_cxrest2#*	}
				[ "$_cxother" = "$_cxdst" ] && _cxother=""
				case "$_cxtag" in
					direct)  _cxhtml='<b>напрямую</b>' ;;
					blocked) _cxhtml='<b>заблокировано</b>' ;;
					*)       _cxhtml="<span class=\"ok\">$(h "$_cxtag")</span>" ;;
				esac
				_cxhtml="$_cxhtml <span class=\"muted\">$(h "$(human_age "$_cxage")") назад · $(h "$_cxdst")</span>"
				# в этом же окне клиент ходил и другими выходами — показываем их,
				# чтобы «напрямую» рядом с «wg» не выглядело ошибкой
				[ -n "$_cxother" ] && _cxhtml="$_cxhtml <span class=\"muted\">(ещё: $(h "$_cxother"))</span>"
			else
				_cxhtml='<span class="muted">'"$T_no_fresh_entries"'</span>'
			fi
			# DNS клиента (запросы на 53-й порт): отдельной припиской, потому что
			# в основном счётчике трафика — только TCP
			_cdns=$(printf '%s\n' "$_cdns_all" | awk -F'\t' -v t="$_ip" '$1 == t { print $2; exit }')
			_cdns_html=""
			[ -n "$_cdns" ] && _cdns_html=" <span class=\"ct-dns\" title=\"запросы DNS клиента (порт 53) с момента включения перехвата; ответы в этой цепочке не считаются\">DNS $(h "$(human_bytes "$_cdns")")</span>"
			if [ "$_acting" = 0 ]; then
				_ckcell="<td><input type=\"checkbox\" name=\"client\" value=\"$(h "$_ip")\" style=\"width:auto\" $_ck></td>"
			else
				_ckcell=""
			fi
			# в активном режиме: завёрнутые — зелёным, новые — серым
			_rcls=""
			if [ "$_acting" = 1 ]; then
				case "$_pc" in
					'') _rcls=' class="ok"' ;;
					*)  case ",$_pc," in *",$_ip,"*) _rcls=' class="ok"' ;; *) _rcls=' class="muted"' ;; esac ;;
				esac
			fi
			# DNS у клиента считаем отдельно: в счётчике трафика — только TCP
			# (UDP/443 намеренно блокируется, чтобы трафик не уходил в обход прокси)
			printf '<tr data-client="%s">%s<td%s>%s</td><td%s>%s</td><td class="muted">%s</td><td class="muted"><span class="ct-up">%s</span> / <span class="ct-dn">%s</span>%s</td><td class="ct-exit-cell">%s</td><td><button type="button" class="btn sec traffic-reset" data-ip="%s" title="'"$T_reset_the_counter_of_this_cl"'">'"$T_reset"'</button></td></tr>\n' \
				"$(h "$_ip")" "$_ckcell" "$_rcls" "$(h "$_host")" "$_rcls" "$(h "$_ip")" "$(h "$_mac")" \
				"$(h "$(human_bytes "${_cup:-0}")")" "$(h "$(human_bytes "${_cdn:-0}")")" "$_cdns_html" "$_cxhtml" "$(h "$_ip")"
		done
		printf '</table><p class="muted">'"$T_the_list_is_dhcp_static_leas"'</p>'
		printf '<p class="muted">'"$T_only_b_tcp_b_is_counted_the_"'</p>'
		printf '<p><button type="button" class="btn sec traffic-reset-all">'"$T_reset_traffic_for_all"'</button></p>'
		printf '<script>(function(){function post(d){return fetch(location.pathname+location.search,{method:"POST",headers:{"Content-Type":"application/x-www-form-urlencoded"},body:new URLSearchParams(d),cache:"no-store"})}function zero(r){var u=r.querySelector(".ct-up"),n=r.querySelector(".ct-dn");if(u)u.textContent="0 Б";if(n)n.textContent="0 Б"}document.querySelectorAll("button.traffic-reset").forEach(function(b){b.addEventListener("click",function(){var ip=b.getAttribute("data-ip");b.disabled=true;post({action:"traffic_reset_one",ip:ip}).then(function(){var r=document.querySelector("tr[data-client=\\""+ip+"\\"]");if(r)zero(r)}).catch(function(){}).then(function(){b.disabled=false})})});var a=document.querySelector("button.traffic-reset-all");if(a)a.addEventListener("click",function(){a.disabled=true;post({action:"traffic_reset"}).then(function(){document.querySelectorAll("tr[data-client]").forEach(zero)}).catch(function(){}).then(function(){a.disabled=false})})})()</script>\n'
		[ "$_sel_show" = 1 ] || printf '</details>\n'
	else
		printf '<p class="muted">'"$T_the_client_list_is_empty_the"'</p>'
	fi
	# список адресов только из подключённых устройств: ничего вводить руками не нужно
	_unknown=""
	for _ip in $(printf '%s' "$_pc" | tr ',' ' '); do
		[ -n "$_ip" ] || continue
		printf '%s' "$_list" | grep -q "^$_ip|" || _unknown="$_unknown$_ip, "
	done
	[ -n "$_unknown" ] && printf '<p class="muted">'"$T_the_settings_still_have_addr"'</p>' "$(h "$_unknown" | sed 's/, $//')"
	printf '</div>\n'
	# список клиентов нужен ровно в одном режиме — «только клиенты из списка».
	# Показ и скрытие живёт в общем коде страницы (page_footer): раньше скрипт
	# стоял здесь, внутри блока, который панель подменяет после сохранений, —
	# поэтому после первого сохранения он переставал работать до перезагрузки.
	# Живая подсказка: показывает, кто и куда пойдёт, ещё ДО включения режима.
	# Текст собирает скрипт страницы из того, что выбрано в окошках выше.
	printf '<h2>'"$T_what_you_will_get"'</h2><div id="dns-preview" class="muted">Считаю по выбранным настройкам…</div>\n'
	printf '<p class="muted">'"$T_the_control_buttons_are_at_t"'</p></div>\n'
	_tlog="$STATE_DIR/transparent.log"

	# --- куда идёт трафик: байты по выходам и что ходило (по журналу) ---------
	printf '<div class="card"><h2>'"$T_where_traffic_goes"'</h2>'
	_tr=$(exit_traffic 2>/dev/null)
	_pd=$(exits_period 2>/dev/null)
	_dm=$(exit_domains 600 2>/dev/null)
	_act=$(active_server_now 2>/dev/null)
	_actt=${_act%%	*}
	# если история уже накопилась — показываем её (за сутки), иначе итог с запуска
	if [ -n "$_pd" ]; then _base="$_pd"; _label="за сутки"; else _base="$_tr"; _label="с запуска xray"; fi
	_tot=$(printf '%s\n' "$_base" | awk -F'\t' '{ s += $2 + $3 } END { printf "%d", s + 0 }')
	if [ -z "$_base" ] || [ "${_tot:-0}" = 0 ]; then
		printf '<p class="muted">'"$T_xray_statistics_are_still_em"'</p>'
	else
		printf '<table class="responsive"><tr><th>'"$T_outbound"'</th><th>'"$T_elapsed_s"'</th><th>'"$T_share"'</th><th>'"$T_what_was_visited"'</th></tr>' "$_label"
		printf '%s\n' "$_base" | awk -F'\t' '{ printf "%d\t%s\t%s\t%s\n", $2 + $3, $1, $2, $3 }' \
			| LC_ALL=C sort -t"$(printf '\t')" -k1,1 -rn | cut -f2- | while IFS="$(printf '\t')" read -r _tag _up _dn; do
			[ -n "$_tag" ] || continue
			[ "${_up:-0}" = 0 ] && [ "${_dn:-0}" = 0 ] && continue
			case "$_tag" in
				direct)  _nm='<b>напрямую</b> (мимо прокси)' ;;
				blocked) _nm='<b>заблокировано</b>' ;;
				*)       if [ "$_tag" = "$_actt" ]; then _nm="<span class=\"ok\">$(h "$_tag")</span>"; else _nm="$(h "$_tag")"; fi ;;
			esac
			_pct=$(awk -v a="$(( ${_up:-0} + ${_dn:-0} ))" -v b="$_tot" 'BEGIN { printf "%.0f %%", (b > 0) ? a * 100 / b : 0 }')
			_top=$(printf '%s\n' "$_dm" | awk -F'\t' -v t="$_tag" '$2 == t { printf "%s (%s), ", $3, $1; n++; if (n >= 3) exit }' | sed -e 's/, $//')
			[ -n "$_top" ] || _top='<span class="muted">'"$T_no_entries"'</span>'
			printf '<tr data-exit="%s"><td data-label="'"$T_outbound"'">%s</td><td data-label="'"$T_elapsed"'" class="ex-bytes">↑ %s / ↓ %s</td><td data-label="'"$T_share"'" class="ex-share">%s</td><td data-label="'"$T_what_was_visited"'">%s</td></tr>\n' \
				"$(h "$_tag")" "$_nm" "$(h "$(human_bytes "${_up:-0}")")" "$(h "$(human_bytes "${_dn:-0}")")" "$_pct" "$_top"
		done
		printf '</table>'
	fi
	# как выход переключался между серверами
	_tl=$(exits_timeline 72 2>/dev/null)
	if [ -n "$_tl" ]; then
		printf '<p><b>Переключения:</b> %s</p>' "$(h "$_tl")"
	else
		printf '<p class="muted">'"$T_the_switch_history_will_appe"'</p>'
	fi
	printf '<p class="muted">'"$T_bytes_from_xray_statistics_c"'</p>'
	printf '</div>\n'

	# диагностика: видно, стоят ли правила и доходит ли трафик до перехватчика
	_rules=""
	if command -v nft >/dev/null 2>&1; then
		_rules=$(nft list table ip xraypanel 2>/dev/null)
	fi
	[ -n "$_rules" ] || _rules=$(iptables -t nat -S XRAYTP_PRE 2>/dev/null)
	_bridges=$(lan_bridges)
	_access="$(cfg log_dir "/var/log")/xray-access.log"
	_tail=""
	# читаем только хвост журнала: целиком он бывает очень большим
	[ -f "$_access" ] && _tail=$(tail -n 3000 "$_access" 2>/dev/null | grep -a "transparent" | tail -5)
	# всё, что нужно при разборе полётов, — под спойлером: на странице и без
	# него много всего
	printf '<div class="card"><details class="pick"><summary>'"$T_b_check_b_what_the_panel_see"'</summary>'
	# почему не поднялся вход перехвата (если так было) — тоже здесь, свёрнуто
	if [ -n "$_fail_html" ] || [ -n "$_fail_raw" ]; then
		printf '<details class="pick"><summary>'"$T_why_the_intercept_entry_did_"'</summary>%s' "$_fail_html"
		[ -n "$_fail_raw" ] && printf '<details class="pick"><summary>'"$T_full_log_lines"'</summary><pre>%s</pre></details>' "$_fail_raw"
		printf '</details>'
	fi
	_dt=$(cfg dns_tunnel 0); _dr=$(cfg dns_router "$_dt")
	if [ "$_dt" = 1 ] || [ "$_dr" = 1 ]; then
		if [ "$(cfg dns_mode relay)" = module ]; then
			_dnsmode_txt="внутренний резолвер xray"
		else
			_dnsmode_txt="пересылка через выбранный сервер"
		fi
		if [ "$_dt" = 1 ]; then _dc='<span class="ok">включён</span>'; else _dc='<span class="muted">'"$T_disabled_3"'</span>'; fi
		if [ "$_dr" = 1 ]; then _dr_='<span class="ok">включён</span>'; else _dr_='<span class="muted">'"$T_disabled_3"'</span>'; fi
		printf '<p>DNS через туннель: у клиентов — %s, у самого роутера — %s. Резолвер %s, порт %s, выход %s, режим: %s</p>\n' \
			"$_dc" "$_dr_" \
			"$(h "$(dns_resolver_list | tr '\n' ' ')")" "$(h "$(dns_tunnel_ports | tr '\n' ' ')")" "$(h "$(cfg dns_out "как у прозрачного")")" "$(h "$_dnsmode_txt")"
		if [ "$_dt" = 1 ]; then
			_dline=$(nft list chain ip xraypanel dns 2>/dev/null | grep -a "dport 53" | tail -2)
			if [ -n "$_dline" ]; then
				printf '<h2>'"$T_dns_interception"'</h2><pre>%s</pre>' "$(h "$_dline")"
			else
				printf '<h2>'"$T_dns_interception"'</h2><p class="bad">правил нет — DNS клиентов не уйдёт в туннель. Нажмите «Включить с автооткатом».</p>'
			fi
		fi
	else
		printf '<p class="muted">'"$T_dns_through_the_tunnel_disab"'</p>\n'
	fi
	if [ "$_ps" = router ]; then
		printf '<p class="muted">'"$T_router_only_mode_the_traffic"'</p>'
	else
	_okif=""
	for _x in $(printf '%s' "$_pi" | tr ', ' ' '); do
		case " $_bridges " in *" $_x "*) _okif="$_okif$_x " ;; esac
	done
	if [ -n "$_okif" ]; then
		printf '<p class="muted">'"$T_bridges_on_the_router_code_s"'</p>' "$(h "${_bridges:-нет}")" "$(h "${_okif% }")"
	elif [ -z "$_bridges" ]; then
		printf '<p class="bad">Мосты на роутере не определились. Посмотрите имена сами: <code>ls /sys/class/net</code> или <code>ip link</code> — и укажите нужный интерфейс в поле выбора выше.</p>'
	else
		printf '<p class="bad">Мосты на роутере: <code>%s</code>. В настройках указано: <code>%s</code> — среди мостов такого нет, поэтому трафик клиентов не завернётся. Выберите мост (обычно <code>br-lan</code>) в списке «Интерфейс сети».</p>' "$(h "$_bridges")" "$(h "$_pi")"
		case " $_pi " in
			*" eth0 "*|*" wan "*|*" eth1 "*)
				printf '<p class="muted">'"$T_judging_by_the_name_the_uppe"'</p>' ;;
		esac
	fi
	fi
	# правила и журнал нужны не каждый раз — убираем их под спойлеры, а наверху
	# оставляем то, что смотрят при проверке: что заходило в перехватчик
	if [ -n "$_tail" ]; then
		printf '<h2>'"$T_what_went_through_the_interc"'</h2><pre id="t-tail">%s</pre>' "$(h "$_tail")"
	else
		printf '<h2>'"$T_what_went_through_the_interc"'</h2><pre id="t-tail"></pre><p class="muted">'"$T_empty_so_far_open_any_site_o"'</p>'
	fi
	if [ -n "$_rules" ]; then
		printf '<details class="pick"><summary>'"$T_rules_currently_in_place"'</summary><pre>%s</pre></details>' "$(h "$_rules")"
	else
		printf '<p class="bad">Правил не найдено — нажмите «Включить с автооткатом» и подтвердите.</p>'
	fi
	if [ -f "$_tlog" ]; then
		printf '<details class="pick"><summary>'"$T_transparent_mode_log"'</summary><pre>%s</pre></details>' "$(tail -n 20 "$_tlog" | h_in)"
	fi
	printf '</details></div>\n'

	cat <<EOF
<div class="card"><details class="pick"><summary>$T_b_what_exactly_is_wrapped_b</summary>
<table>
<tr><th>$T_internet_traffic</th><td>$T_goes_into_xray_and_then_by_t</td></tr>
<tr><th>$T_routing_rules</th><td>$T_are_checked_first_so_a_priva</td></tr>
<tr><th>$T_local_network_and_the_router</th><td>$T_is_not_touched_access_to_the</td></tr>
<tr><th>$T_xray_itself</th><td>$T_is_not_wrapped_into_itself_i</td></tr>
<tr><th>$T_quic_udp_443</th><td>$T_is_blocked_for_wrapped_clien</td></tr>
<tr><th>$T_dns_and_other_udp</th><td>$T_are_not_wrapped_in_this_vers</td></tr>
</table>
<p class="muted">$T_after_a_router_reboot_the_ru</p></details></div>
EOF
}

page_config() {
	# Сначала — то, что панель соберёт из текущих настроек: ради этого на
	# страницу и заходят. Файл на диске прячем в свёрнутый блок.
	# stderr не подмешиваем: сообщения утилит («head: … Broken pipe») раньше
	# попадали в текст конфига, из-за чего панель считала настройки изменёнными
	# и каждый раз просила применить конфиг
	_gen=$(gen_config 2>/dev/null)
	if [ -z "$_gen" ]; then
		printf '<div class="card"><h2 class="bad">'"$T_config_cannot_be_built"'</h2><pre>%s</pre></div>\n' "$(gen_config 2>&1 | sed -n '1,20p' | h_in)"
	fi
	printf '<div class="card"><h2>'"$T_what_the_current_settings_wi"'</h2><pre>'
	printf '%s' "$_gen" | h_in
	printf '</pre><p class="muted">'"$T_this_is_the_config_built_fro"'</p></div>\n'
	# отдельный блок: чем файл на роутере отличается от этих настроек
	printf '<div class="card"><h2>'"$T_differences_with_the_file_on"'</h2>'
	if config_text_matches "$_gen"; then
		printf '<p class="muted">'"$T_no_differences_the_file_on_t"'</p>'
	else
		printf '<p class="bad">Файл на роутере отличается от текущих настроек. Вот эти строки:</p><pre>%s</pre>' "$(config_diff_lines "$_gen" 20 | h_in)"
		printf '<p class="muted">'"$T_lines_in_the_file_but_not_in"'</p>'
		apply_form config
	fi
	printf '</div>\n'
	printf '<div class="card"><details><summary>'"$T_show_the_file_on_disk_s"'</summary><pre>' "$(h "$(xray_config)")"
	[ -f "$(xray_config)" ] && cat "$(xray_config)" | h_in || echo "файла нет"
	printf '</pre><p class="muted">'"$T_this_is_the_config_xray_is_r"'</p></details></div>\n'
}

page_settings() {
	printf '<div class="card"><h2>'"$T_panel_settings"'</h2><form method="post"><input type="hidden" name="action" value="settings"><div class="row">'
	printf '<div><label>'"$T_socks_port"'</label><input name="socks_port" value="%s"></div>' "$(h "$(cfg socks_port 10808)")"
	printf '<div><label>'"$T_api_port"'</label><input name="api_port" value="%s"></div>' "$(h "$(cfg api_port 62789)")"
	printf '<div><label>'"$T_panel_password_empty_no_pass"'</label><input name="password" value="%s"></div>' "$(h "$(cfg password "")")"
	printf '<div><label>'"$T_probe_address_for_auto_selec"'</label><input name="probe_url" value="%s"></div>' "$(h "$(cfg probe_url "https://www.gstatic.com/generate_204")")"
	printf '<div><label>'"$T_xray_log_folder"'</label><input name="log_dir" value="%s"></div>' "$(h "$(cfg log_dir "/var/log")")"
	printf '<div><label>'"$T_address_for_checking_nodes"'</label><input name="url_test_url" value="%s" placeholder="http://www.gstatic.com/generate_204"></div>' "$(h "$(url_test_url)")"
	printf '<div><label>'"$T_port_for_checking"'</label><input name="url_test_port" value="%s" placeholder="18999"></div>' "$(h "$(url_test_port)")"
	printf '<div><label>'"$T_check_nodes_automatically"'</label><select name="url_test_interval">'
	_ui="$(cfg url_test_interval 0)"
	for _n in 0 5 15 30 60; do
		if [ "$_n" = 0 ]; then _lbl="выключено"; else _lbl="каждые $_n минут"; fi
		printf '<option value="%s" %s>%s</option>' "$_n" "$([ "$_ui" = "$_n" ] && echo selected)" "$_lbl"
	done
	printf '</select></div>'
	printf '<div><label>'"$T_update_subscriptions_automat"'</label><select name="sub_interval">'
	_si="$(cfg sub_interval 0)"
	for _n in 0 6 12 24; do
		if [ "$_n" = 0 ]; then _lbl="выключено"; else _lbl="каждые $_n ч"; fi
		printf '<option value="%s" %s>%s</option>' "$_n" "$([ "$_si" = "$_n" ] && echo selected)" "$_lbl"
	done
	printf '</select></div>'
	printf '<div><label>'"$T_panel_theme"'</label><select name="theme" data-old="%s">' "$(h "$(theme_name)")"
	for _t in $THEME_LIST; do
		printf '<option value="%s" %s>%s</option>' "$(h "$_t")" "$([ "$(theme_name)" = "$_t" ] && echo selected)" "$(h "$(theme_title "$_t")")"
	done
	printf '</select></div>'
	# язык интерфейса: строки лежат в файлах языков, в коде — ссылки вида $T_…
	printf '<div><label>'"$T_panel_language"'</label><select name="lang">'
	_curlang=$(cfg lang auto)
	for _lg in auto ru en; do
		printf '<option value="%s" %s>%s</option>' "$_lg" "$([ "$_curlang" = "$_lg" ] && echo selected)" "$(lang_title "$_lg")"
	done
	printf '</select></div>'
	# лампочки правил: служебный трафик (проверки связи, обращения к панели и к
	# самим серверам) можно не учитывать — иначе одна лампочка горит постоянно
	printf '<div><label>'"$T_lamps_in_rules"'</label><label class="chk"><input type="checkbox" name="lamp_filter" value="1" style="width:auto" %s>'"$T_do_not_count_service_traffic"'</label></div>' \
		"$([ "$(cfg lamp_filter 1)" = 1 ] && echo checked)"
	printf '<div><label>'"$T_highlight_in_sets"'</label><label class="chk"><input type="checkbox" name="set_highlight" value="1" style="width:auto" %s>'"$T_highlight_the_entries_that_w"'</label></div>' \
		"$([ "$(cfg set_highlight 1)" = 1 ] && echo checked)"
	# звук кнопок: звук синтезирует сам браузер, файлов в пакете нет
	printf '<div><label>'"$T_button_sound"'</label><select name="sound">'
	_cur_snd=$(cfg sound click)
	for _s in off click tick blip two; do
		case "$_s" in
			off)   _lbl="выключен" ;;
			click) _lbl="щелчок (короткий, по умолчанию)" ;;
			tick)  _lbl="тик (самый тихий)" ;;
			blip)  _lbl="блип (мягкий гудок)" ;;
			two)   _lbl="два тона (вверх — обычные, вниз — удаление)" ;;
		esac
		printf '<option value="%s" %s>%s</option>' "$_s" "$([ "$_cur_snd" = "$_s" ] && echo selected)" "$_lbl"
	done
	printf '</select></div>'
	printf '<div><label>'"$T_sound_volume"'</label><select name="volume">'
	_cur_vol=$(cfg volume mid)
	for _v in low mid high; do
		case "$_v" in
			low)  _lbl="тихо" ;;
			mid)  _lbl="средне" ;;
			high) _lbl="громко" ;;
		esac
		printf '<option value="%s" %s>%s</option>' "$_v" "$([ "$_cur_vol" = "$_v" ] && echo selected)" "$_lbl"
	done
	printf '</select></div>'
	# проверка новых версий панели (самообновление)
	printf '<div><label>'"$T_panel_updates_github_reposit"'</label><input name="update_repo" value="%s" placeholder="'"$T_owner_repository"'"></div>' "$(h "$(cfg update_repo "Petr700/xraypanel")")"
	printf '<div><label>Токен GitHub <span class="muted">'"$T_only_needed_for_a_private_re"'</span></label><input name="update_token" value="%s" placeholder="'"$T_optional"'"></div>' "$(h "$(cfg update_token "")")"
	printf '<div><label>'"$T_check_for_updates"'</label><select name="update_auto">'
	printf '<option value="1"%s>'"$T_once_a_day_and_when_status_i"'</option>' "$([ "$(cfg update_auto 1)" = 1 ] && echo ' selected')"
	printf '<option value="0"%s>'"$T_manually_only_by_button"'</option>' "$([ "$(cfg update_auto 1)" = 0 ] && echo ' selected')"
	printf '</select></div>'
	printf '</div><p><button>'"$T_save_settings"'</button></p></form>'
	printf '<p class="muted">'"$T_settings_file_etc_config_xra"'</p></div>\n'
}

# Карточка «Обновление панели»: что нашли в последнем релизе GitHub, кнопка
# «проверить сейчас», «что нового» и «обновить». Отдаётся и отдельной страницей
# (?page=update_card), чтобы страница обновляла её без перезагрузки.
update_card_html() {
	_repo=$(cfg update_repo "Petr700/xraypanel")
	_cver=$(panel_version)
	printf '<h2>'"$T_panel_update"'</h2>'
	if [ -z "$_repo" ]; then
		printf '<p class="muted">'"$T_checking_for_new_versions_is"'</p>'
		return 0
	fi
	_nver=$(update_field version 2>/dev/null)
	_ago=$(update_checked_ago 2>/dev/null)
	_auto=$(cfg update_auto 1)
	# давно не проверяли — запускаем проверку фоном прямо сейчас
	if [ "$_auto" = 1 ] && [ "$(param nocache)" != 1 ] && { [ -z "$_ago" ] || [ "${_ago:-999999}" -gt 43200 ]; }; then
		[ -f "$STATE_DIR/update.running" ] || bg_run "$UPDATE_ENV sh '$UPDATE_CHECK'" "$STATE_DIR/update.log"
		_ago=""
	fi
	if [ -n "$_ago" ]; then
		printf '<p class="muted">'"$T_checked_s_ago_repository_cod"'</p>' "$(h "$(human_age "$_ago")")" "$(h "$_repo")"
	elif [ -s "$STATE_DIR/update.error" ]; then
		printf '<p class="bad">Проверить не удалось: %s</p>' "$(h "$(cat "$STATE_DIR/update.error" 2>/dev/null)")"
		printf '<p class="muted">'"$T_if_the_repository_is_private"'</p>'
	else
		printf '<p class="muted" id="update-wait">Проверяю новые версии… это занимает несколько секунд, страницу перезагружать не нужно.</p>'
	fi
	if [ -n "$_nver" ] && [ "$(ver_newer "$_nver" "$_cver")" = yes ]; then
		_geturl=$(update_field url 2>/dev/null)
		_page=$(update_field page 2>/dev/null)
		printf '<p class="ok"><b>Доступна новая версия %s</b> (сейчас стоит %s).</p>' "$(h "$_nver")" "$(h "$_cver")"
		if [ -n "$_geturl" ]; then
			printf '<form method="post"><input type="hidden" name="action" value="update_install"><button class="btn">обновить до %s</button> <span class="muted">'"$T_downloads_the_package_and_in"'</span></form>' "$(h "$_nver")"
		else
			printf '<p class="bad">В релизе нет файла пакета .ipk — поставить кнопкой не получится.</p>'
		fi
		if [ -n "$_page" ]; then
			printf '<p class="muted">'"$T_release_page_a_href_s_target"'</p>' "$(h "$_page")" "$(h "$_page")"
		fi
		_notes=$(update_notes 2>/dev/null)
		if [ -n "$_notes" ]; then
			printf '<details class="pick"><summary>'"$T_what_is_new_in_version_s"'</summary><pre>%s</pre></details>' "$(h "$_nver")" "$(printf '%s' "$_notes" | h_in)"
		fi
	elif [ -n "$_nver" ]; then
		printf '<p class="ok">Установлена последняя версия: %s.</p>' "$(h "$_cver")"
	fi
	printf '<form method="post" style="margin-top:6px"><input type="hidden" name="action" value="update_check"><button class="btn sec">'"$T_check_for_updates_now"'</button></form>'
	_ulog="$STATE_DIR/update.log"
	if [ -f "$_ulog" ]; then
		printf '<details class="pick"><summary>'"$T_update_check_log"'</summary><pre>%s</pre></details>' "$(tail -n 15 "$_ulog" | h_in)"
	fi
}

