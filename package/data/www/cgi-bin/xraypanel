	[ -n "$_cur" ] || _cur=proxy
	printf '<select name="category" id="rule-cat">'
	for _pair in \
		"direct|Напрямую — мимо прокси" \
		"proxy|Через прокси — в тоннель" \
		"block|Заблокировать"
	do
		_k=${_pair%%|*}; _v=${_pair#*|}
		printf '<option value="%s"%s>%s</option>' "$_k" "$([ "$_cur" = "$_k" ] && echo ' selected')" "$_v"
	done
