		printf '<table><tr><th>'"$T_list"'</th><th>'"$T_contains"'</th><th>'"$T_entries"'</th><th>'"$T_parsed"'</th><th>'"$T_status"'</th></tr>'
		printf '%s\n' "$_sr" | while IFS="$(printf '\t')" read -r _n _ty _c _d _st; do
			[ -n "$_n" ] || continue
			case "$_ty" in
				geoip)   _what="адреса" ;;
				*)       _what="домены" ;;
			esac
			case "$_st" in
				актуален) _sc='<span class="ok">актуален</span>' ;;
				"надо разобрать заново") _sc='<span class="bad">надо разобрать заново</span>' ;;
				*) _sc='<span class="muted">'"$T_not_parsed"'</span>' ;;
			esac
			printf '<tr><td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td></tr>\n' \
				"$(h "$_n")" "$_what" "$(h "$_c")" "$(h "$_d")" "$_sc"
		done
		printf '</table>'
	fi
	printf '<p class="muted">'"$T_it_only_has_to_be_parsed_b_o"'</p>'
	printf '<form method="post"><input type="hidden" name="action" value="geo_items"><button class="btn sec">'"$T_parse_lists"'</button></form>'
	# --- 3. обновление из интернета
	printf '<h3>'"$T_3_update_from_the_internet"'</h3>'
	printf '<p class="muted">'"$T_the_files_are_taken_from_git"'</p>'
