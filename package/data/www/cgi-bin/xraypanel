			printf '<p class="bad">Файлы со списками менялись после сбора — нажмите «собрать названия заново».</p>'
		fi
		if [ -n "$_sf" ] && [ "${_ng:-0}" = 0 ]; then
			printf '<p class="bad">Списки доменов не разобрались, хотя файл есть — смотрите «Журнал сбора названий» внизу.</p>'
		fi
	else
		printf '<p class="muted">'"$T_the_list_names_have_not_been_2"'</p>'
	fi
	printf '<form method="post"><input type="hidden" name="action" value="geo_build"><button class="btn sec">'"$T_rebuild_names"'</button></form>'
	# --- 2. списки, которые стоят в наборах
	printf '<h3>'"$T_2_lists_from_rules_and_sets"'</h3>'
	printf '<p class="muted">'"$T_with_a_parsed_list_the_panel"'</p>'
