})();
/* Отклик на нажатие: панель отвечает вспышкой самой кнопки, звуком и (на
   телефоне) короткой вибрацией — чтобы было видно, что нажатие дошло, даже
   когда сохранение идёт тихо, без перезагрузки страницы. Звук синтезирует
   браузер: файлов в пакете нет, а вид звука и громкость выбираются в
   «Настройках». Браузеры разрешают звук только после первого касания
   страницы — до первого нажатия панель молчит, обойти это нельзя. */
(function () {
	var kind = window.__xpSound || 'off';
	var vol = window.__xpVolume || 'mid';
	var peak = { low: 0.035, mid: 0.08, high: 0.16 }[vol] || 0.08;
	var ctx = null;
	function ac() {
		try {
			if (!ctx) {
				var A = window.AudioContext || window.webkitAudioContext;
				if (!A) return null;
				ctx = new A();
			}
			if (ctx.state === 'suspended' && ctx.resume) ctx.resume();
			return ctx;
		} catch (e) { return null; }
	}
	function beep(freq, dur, delay, gain, wave) {
		var a = ac();
		if (!a) return;
		var o = a.createOscillator(), g = a.createGain();
		var t = a.currentTime + (delay || 0);
		o.type = wave || 'triangle';
		o.frequency.value = freq;
		g.gain.setValueAtTime(0.0001, t);
		g.gain.linearRampToValueAtTime(peak * (gain || 1), t + 0.006);
		g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
		o.connect(g);
		g.connect(a.destination);
		o.start(t);
		o.stop(t + dur + 0.02);
	}
	function play(k) {
		switch (k) {
			case 'click': beep(1500, 0.018, 0, 1, 'square'); beep(760, 0.03, 0.004, 0.45, 'square'); break;
			case 'tick':  beep(2600, 0.012, 0, 0.7, 'square'); break;
			case 'blip':  beep(880, 0.07, 0, 1); break;
			case 'up':    beep(680, 0.055, 0, 0.8); beep(1020, 0.09, 0.07, 0.9); break;
			case 'down':  beep(520, 0.07, 0, 0.8); beep(330, 0.12, 0.085, 0.9); break;
			default: break;
		}
	}
	var last = 0;
	document.addEventListener('click', function (ev) {
		var t = ev.target;
		var b = t && t.closest ? t.closest('button, a.btn, input[type=submit]') : null;
		if (!b || b.disabled) return;
		var now = Date.now();
		if (now - last < 100) return;   /* дребезг: не играем звук дважды */
		last = now;
		var danger = /(^|\s)(danger|stop)(\s|$)/.test(String(b.className || ''));
		if (kind !== 'off') play(danger ? 'down' : (kind === 'two' ? 'up' : kind));
		if (navigator.vibrate) { try { navigator.vibrate(danger ? [18, 40, 18] : 12); } catch (e) {} }
		b.classList.remove('hit');
		void b.offsetWidth;
		b.classList.add('hit');
		setTimeout(function () { b.classList.remove('hit'); }, 450);
	}, true);
})();
