	printf '<script>(function(){var b=document.querySelectorAll("input[name=transparent_iface]"),o=document.getElementById("if-sel");if(!b.length||!o)return;function u(){var v=[];b.forEach(function(x){if(x.checked)v.push(x.value)});o.textContent=v.length?v.join(", "):"'"$T_no"'}b.forEach(function(x){x.addEventListener("change",u)});u()})()</script>\n'
	opt_select_open "$T_where_to_route" transparent_out
