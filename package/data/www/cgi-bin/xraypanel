# --- проверка DNS: куда реально уходит запрос --------------------------------
act_dnscheck() {
	_n=$(param name)
	_n=$(printf '%s' "$_n" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
	[ -n "$_n" ] || _n="example.com"
	case "$_n" in
		*[!A-Za-z0-9._-]*) _res="в имени домена есть недопустимые символы — нужны только буквы, цифры, точки и дефис" ;;
		*)
			_resolver=$(cfg dns_resolver "1.1.1.1")
			# 1) как у клиентов: dnsmasq, а дальше — как настроен перехват
			_a=$(dns_lookup "$_n")
			_aa=${_a%%	*}; _at=${_a##*	}
			# 2) напрямую к резолверу: отвечает ли он и не подменяет ли провайдер
			_b=$(dns_lookup "$_n" "$_resolver")
			_ba=${_b%%	*}; _bt=${_b##*	}
			_dt=$(cfg dns_tunnel 0); _dr=$(cfg dns_router "$_dt")
			if [ "$_dt" = 1 ] && [ "$_dr" = 1 ]; then
				_where="перехват включён: и клиенты, и роутер идут через туннель"
			elif [ "$_dt" = 1 ]; then
				_where="перехват клиентов включён, DNS самого роутера идёт как обычно"
			elif [ "$_dr" = 1 ]; then
				_where="DNS самого роутера идёт через туннель, у клиентов перехвата нет"
			else
				_where="перехват выключен (имена разбирает роутер как обычно)"
			fi
			_res="$_where. Через роутер (как у клиентов): $_aa за $_at мс. Напрямую к $_resolver: $_ba за $_bt мс."
			if [ "$_aa" = "нет ответа" ] && [ "$_ba" != "нет ответа" ]; then
				_res="$_res Похоже, перехват DNS не работает: напрямую отвечает, а через роутер нет."
			elif [ "$_aa" != "нет ответа" ] && [ "$_ba" != "нет ответа" ] && [ "$_aa" != "$_ba" ]; then
				_res="$_res Ответы разные — похоже, провайдер подменяет DNS. Надёжнее указать выход DNS через сервер."
			fi
			;;
	esac
	if [ "$(param ajax)" = 1 ]; then
		printf 'Content-Type: text/plain; charset=utf-8\n\n%s' "$_res"
		exit 0
	fi
	redirect transparent "$_res"
}

# --- гео-списки: собрать названия из файлов роутера --------------------------
