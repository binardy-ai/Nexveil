</nav>
EOF
	# кнопка применения конфига — отдельно, справа в шапке (только когда есть
	# что применять); список изменений показываем ниже, в области объявлений
	_pend=$(pending_list 5)
	if [ -z "$_pend" ] && config_dirty; then
		_pend="настройки изменены (список пометок пуст — например, после обновления панели)"
	fi
	if [ -n "$_pend" ]; then
		# кнопка применения в шапке: у неё свой класс, чтобы страница могла
		# синхронизировать её состояние с кнопкой в карточке правил
		printf '<span class="apply-hdr" style="margin-left:auto">'
