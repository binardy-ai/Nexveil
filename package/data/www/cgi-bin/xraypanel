explain_failure() { # $1 — хвост журналов: объясняем причину по конкретной строке
	_why=""; _what=""; _line=""
	# идём от свежих строк к старым: важна последняя настоящая причина
	_lines=$(printf '%s\n' "$1" | awk 'NF { n++; l[n] = $0 } END { for (i = n; i >= 1; i--) print l[i] }')
	while IFS= read -r _ln; do
		[ -n "$_ln" ] || continue
		# предупреждения проверки связи — не причина отказа входа, пропускаем
		case "$_ln" in
			*"app/observatory"*|*"is dead"*) continue ;;
		esac
		case "$_ln" in
			*"address already in use"*)
				_why="нужный порт уже занят другой программой"
				_what="посмотрите, кто слушает этот порт (<code>netstat -lntp</code>), и либо выключите того, кто занял, либо поменяйте порт в «Настройках»" ;;
			*"failed to listen"*|*"listen tcp"*|*"failed to bind"*|*"cannot assign requested address"*)
				_why="xray не смог занять порт входа — адрес или порт не подошли"
				_what="проверьте «Порт перехвата» и «Порт DNS-входа»: они должны быть свободными и не совпадать с теми, что уже заняты другими службами" ;;
			*"non existing outTag"*|*"unknown outbound"*|*"failed to find outbound"*|*"outboundTag is not found"*)
				_why="в конфиге есть правило или мост, который смотрит на выход, которого больше нет"
				_what="обычно так бывает с выключенным или удалённым сервером: включите его на странице «Серверы» либо переключите правило на «Маршрутах»" ;;
			*"failed to load config"*|*"unmarshal"*|*"invalid character"*|*"unknown field"*|*"Invalid or unsupported"*)
				_why="xray не принял конфиг: в нём есть значение, которого эта сборка не понимает"
				_what="нажмите «Откат конфига» на странице «Статус» — вернётся прежний рабочий файл, а затем проверьте последние изменения настроек" ;;
			*"permission denied"*|*"operation not permitted"*)
				_why="не хватило прав — обычно не установлен нужный модуль ядра для перехвата"
				_what="перезагрузите роутер и посмотрите журнал снова; если повторяется — проверьте, что установлен модуль перехвата (nft/tproxy) и панель запускается от root" ;;
			*"no such file or directory"*)
				_why="не найден файл, который нужен xray"
				_what="проверьте на странице «Настройки» путь к xray и к файлу конфига — по этому пути файл должен существовать" ;;
			*"not supported"*|*"unsupported"*)
				_why="эта сборка xray или ядро роутера не умеет такой режим перехвата"
				_what="попробуйте обычный redirect вместо tproxy — tproxy поддерживают не все ядра" ;;
			*"too many open files"*)
				_why="у системы закончились свободные дескрипторы файлов"
				_what="перезагрузите роутер — после перезагрузки лимиты и счётчики сбрасываются" ;;
			*"не удалось записать"*|*"No space left"*|*"нет места"*)
				_why="панель не смогла записать файл конфига"
				_what="проверьте свободное место (<code>df -h /etc</code>) и права на каталог конфига" ;;
		esac
		if [ -n "$_why" ]; then _line="$_ln"; break; fi
	done <<EOL
$_lines
EOL
	if [ -n "$_why" ]; then
		printf '<p><b>Причина:</b> %s.</p>' "$_why"
		printf '<p><b>Что сделать:</b> %s.</p>' "$_what"
	else
		printf '<p class="muted">'"$T_no_familiar_reason_was_found"'</p>'
	fi
}

page_transparent() {
	# держим журнал xray коротким (не чаще раза в 10 минут) — от него зависят
	# «активный выход», «идёт через» и «что ходило»
	trim_access_log
	_pt=$(cfg transparent_port 12345)
	_ps=$(cfg transparent_scope "lan")
	_pc=$(cfg transparent_clients "")
	_po=$(cfg transparent_out "")
	_pi=$(cfg transparent_iface "br-lan")
	_en=$(cfg transparent 0)
	_st=$("$TRANS" status 2>/dev/null)
	# слушает ли порт перехвата (создан ли вход в конфиге xray)
	_lst=no
	if (ss -ltn 2>/dev/null || netstat -ltn 2>/dev/null) | awk '{print $4}' | grep -q ":$_pt\$" 2>/dev/null; then
		_lst=yes
	fi
	_dl="$STATE_DIR/transparent.deadline"
	_left=""
	if [ -f "$_dl" ]; then
		_d=$(cat "$_dl" 2>/dev/null)
		case "$_d" in ''|*[!0-9]*) _d=0 ;; esac
		_now=$(date +%s)
		[ "$_d" -gt "$_now" ] && _left=$((_d - _now))
	fi
	_kf="$STATE_DIR/transparent.keep"
	_lastf="$STATE_DIR/transparent.last"
	_last=""
	[ -f "$_lastf" ] && _last=$(cat "$_lastf" 2>/dev/null)
	if [ "$_st" = "on" ]; then
		if [ -f "$_kf" ]; then _rev="выключен — правила подтверждены"; else
			if [ -n "$_left" ]; then _rev="сработает через $_left сек — нажмите «Подтвердить»"; else _rev="истёк"; fi
		fi
	else
		_rev="не активен"
	fi

	if [ "$_st" = "on" ]; then _sc="ok"; _sv="стоят"; else _sc="muted"; _sv="сняты (трафик идёт как обычно)"; fi
	if [ "$_en" = "1" ]; then _ev="включён"; else _ev="выключен"; fi
	# куда реально уйдёт перехваченный трафик
	_eff="$_po"
	if [ -z "$_eff" ] && [ "$(cfg auto_best 0)" = "1" ]; then
		_eff="авто — сервер с лучшим пингом"
		_act=$(active_outbound)
		[ -n "$_act" ] && _eff="$_eff; сейчас в работе: $_act (по журналу)"
	fi
	[ -z "$_eff" ] && _eff=$(cfg default_outbound "")
	if [ -z "$_eff" ]; then
		_eff="<span class=\"bad\">напрямую — адрес не изменится</span>"
		_warn=1
	else
		_warn=0
	fi

	# «сейчас трафик идёт через» — по свежим записям журнала xray, а не по
	# настройке: с автовыбором по пингу и правилами они часто не совпадают
	_now=$(active_server_now)
	if [ -n "$_now" ]; then
		_now_tag=${_now%%	*}
		_now_age=${_now##*	}
		_now_line="<span class=\"ok\" id=\"now-tag\">$(h "$_now_tag")</span> <span class=\"muted\" id=\"now-age\">($(h "$(human_age "$_now_age")") назад)</span>"
	else
