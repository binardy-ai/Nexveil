# для категории «через прокси»: какой именно выход использовать
rule_proxy_select() { # $1 = текущий выход (auto или тег сервера)
	_cur="$1"
	printf '<select name="proxy_out">'
	printf '<option value="auto"%s>'"$T_by_ping_the_fastest_server"'</option>' "$([ "$_cur" = auto ] && echo ' selected')"
	for _s in $(server_sections); do
		_t=$(server_tag "$_s")
		server_is_reverse "$_t" && continue
		printf '<option value="%s"%s>%s</option>' "$(h "$_t")" "$([ "$_cur" = "$_t" ] && echo ' selected')" "$(h "$_t")"
	done
	case "$_cur" in
		''|auto|direct|blocked) ;;
		*)
			# выход, которого нет среди серверов (например выключенный) — не теряем
			_known=0
			for _s in $(server_sections); do
				[ "$(server_tag "$_s")" = "$_cur" ] && _known=1
			done
			[ "$_known" = 1 ] || printf '<option value="%s" selected>'"$T_s_current_not_in_the_list"'</option>' "$(h "$_cur")" "$(h "$_cur")"
			;;
	esac
	printf '</select>'
}

