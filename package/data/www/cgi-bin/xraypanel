	det.addEventListener('toggle', function () { if (det.open) load(); });
	if (det.open) load();
	/* страница перерисовывает карточку после тихих действий: если блок был
	   открыт — открываем его снова и собираем содержимое заново */
	window.__geoReload = function (wasOpen) {
