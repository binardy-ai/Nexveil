			_body=$(printf '%s\n' "$_d" | sed -e '/^#всего/d' | head -n 60 | cut -f1 | tr '\n' ' ' | sed -e 's/[[:space:]]*$//')
			if [ "${_tot:-0}" = 0 ]; then
