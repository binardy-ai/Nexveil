# --- наборы (категории) и их записи ------------------------------------------
act_save_rules_all() { # сохранить все правила из таблицы и применить конфиг
	for _r in $(rule_sections); do
		# Поля правим ТОЛЬКО если они вообще были в запросе. Раньше отсутствие
		# поля считалось «пустым значением» и правило теряло источник или набор:
		# сохранение одного правила стирало данные у соседних.
		if params_present "src_$_r"; then
			_src=$(params_all "src_$_r" | grep -v '^$' | tr '\n' ',' | sed -e 's/,,*/,/g' -e 's/^,//' -e 's/,$//')
			if [ -n "$_src" ]; then ui_uci set "$UCI_APP.$_r.source=$_src"; else ui_uci delete "$UCI_APP.$_r.source"; fi
		fi
		if params_present "sets_$_r"; then
			_sets=$(params_all "sets_$_r" | grep -v '^$' | tr '\n' ',' | sed -e 's/,,*/,/g' -e 's/^,//' -e 's/,$//')
			if [ -n "$_sets" ]; then ui_uci set "$UCI_APP.$_r.sets=$_sets"; else ui_uci delete "$UCI_APP.$_r.sets"; fi
		fi
		if params_present "out_$_r"; then
			_out=$(param "out_$_r")
			[ -n "$_out" ] && ui_uci set "$UCI_APP.$_r.outbound=$_out"
		fi
	done
	_skip=0
	for _k in $(param newrows | tr ',' ' '); do
		[ -n "$_k" ] || continue
		_src=$(params_all "src_$_k" | grep -v '^$' | tr '\n' ',' | sed -e 's/,,*/,/g' -e 's/^,//' -e 's/,$//')
		_sets=$(params_all "sets_$_k" | grep -v '^$' | tr '\n' ',' | sed -e 's/,,*/,/g' -e 's/^,//' -e 's/,$//')
		_out=$(param "out_$_k")
		[ -n "$_out" ] || _out=auto
		# пустую строку (ничего не выбрано) не сохраняем — но и не молчим об этом,
		# иначе кажется, что правило «не сохранилось»
		if [ -z "$_src$_sets" ] && [ "$_out" = auto ]; then
			_skip=$((_skip + 1))
			continue
		fi
		_new=$(rule_new_name)
		uci -q set "$UCI_APP.$_new=rule"
		[ -n "$_src" ] && uci -q set "$UCI_APP.$_new.source=$_src"
		[ -n "$_sets" ] && uci -q set "$UCI_APP.$_new.sets=$_sets"
		uci -q set "$UCI_APP.$_new.outbound=$_out"
		_maxo=$(uci -q get "$UCI_APP.$_new.ord" 2>/dev/null); case "$_maxo" in ''|*[!0-9]*) _maxo=0 ;; esac
		uci -q set "$UCI_APP.$_new.ord=$((_maxo + 9990))"
	done
	uci commit "$UCI_APP" >/dev/null 2>&1
	pending_clear
	pending_note "правила сохранены"
	if [ "${_skip:-0}" -gt 0 ]; then
		respond_now rules "остальные правила сохранены и конфиг применяется. Пустых строк пропущено: $_skip — в них не выбрано ни устройство, ни набор, а выход стоит «по пингу». Чтобы строка сохранилась, выберите устройство, набор или конкретный выход."
	else
		respond_now rules "правила сохранены, конфиг применяется — страница обновится сама"
	fi
	bg_apply
	exit 0
}

