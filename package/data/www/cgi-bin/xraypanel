							var act = document.getElementById('rule-act-' + r.sec);
							if (act) {
								var fullT = r.top || r.dest || '';
								/* ageText уже добавляет «назад» — второй раз не нужно */
								act.innerHTML = '<span class="muted">' + ageText(a) + '</span>';
								act.setAttribute('title', __t("T_in_10_minutes") + fullT);
							}
						}
						if (!dot) return;
						if (isNaN(a)) return;
						if (a < LAMP) {
							dot.className = 'dot on';
							dot.style.animationDelay = '-' + a + 's';
						} else {
							dot.className = 'dot';
							dot.style.animationDelay = '';
						}
						var full = r.top || r.dest || '';
						var one = String(full).split(', ')[0].replace(/ \(\d+\)$/, '');
						if (txt) {
							txt.innerHTML = (r.out ? '<span class="ok">' + esc(r.out) + '</span> · ' : '')
								+ ageText(a) + ' · ' + esc(one);
						}
						var cell = dot.closest ? dot.closest('td') : null;
						if (cell) cell.setAttribute('title',
							__t("T_outbound_2") + (r.out || '') + ', ' + ageText(a) + __t("T_in_10_minutes_2") + full);
					});
				}
				/* через какой сервер трафик идёт прямо сейчас (шапка «Прокси») */
				/* сработавшие записи открытого набора: та же лампочка, что у правил
				   (вспышка и затухание за 30 секунд), «вероятно» — серым пунктиром */
				if (d.setitems) {
					document.querySelectorAll('tr[data-item]').forEach(function (row) {
						row.classList.remove('item-maybe');
						lamp(row, null);
					});
					d.setitems.forEach(function (it) {
						var row = document.querySelector('tr[data-item="' + it.id + '"]');
						if (!row) return;
						if (it.kind === 'maybe') { row.classList.add('item-maybe'); return; }
						lamp(row, it.age);
					});
				}
				var nowTag = document.getElementById('now-tag');
				if (nowTag) {
					var nowAge = document.getElementById('now-age');
					if (d.now && d.now.tag) {
						var na = parseInt(d.now.age, 10);
						nowTag.textContent = d.now.tag;
						nowTag.className = 'ok';
						if (nowAge) nowAge.textContent = isNaN(na) ? '' : '(' + ageText(na) + ')';
					} else {
						nowTag.textContent = __t("T_no_fresh_entries");
						nowTag.className = 'muted';
						if (nowAge) nowAge.textContent = '';
					}
				}
				/* «Куда идёт трафик»: байты и доли пересчитываем на месте */
				if (d.exits && d.exits.length) {
					var tot = 0;
					d.exits.forEach(function (e) { tot += (Number(e.up) || 0) + (Number(e.dn) || 0); });
					d.exits.forEach(function (e) {
						var row = document.querySelector('tr[data-exit="' + e.tag + '"]');
						if (!row) return;
						var b = row.querySelector('.ex-bytes'), s = row.querySelector('.ex-share');
						var sum = (Number(e.up) || 0) + (Number(e.dn) || 0);
						if (b) b.textContent = '↑ ' + hb(e.up) + ' / ↓ ' + hb(e.dn);
						if (s) s.textContent = (tot > 0 ? Math.round(sum * 100 / tot) : 0) + ' %';
					});
				}
				/* строка «Трафик» в «Прозрачном режиме» — как у клиентов */
				if (d.traffic) {
					var tl = document.getElementById('t-traffic');
					if (tl) {
						var pts = [], t = d.traffic;
						if ((Number(t.cup) || 0) + (Number(t.cdn) || 0) > 0)
							pts.push(__t("T_clients") + hb(t.cup) + ' / ↓ ' + hb(t.cdn) + __t("T_router"));
						if ((Number(t.tup) || 0) + (Number(t.tdn) || 0) + (Number(t.dup) || 0) + (Number(t.ddn) || 0) > 0)
							pts.push(__t("T_through_the_tunnel") + hb(t.tup) + ' / ↓ ' + hb(t.tdn)
								+ __t("T_straight_2") + hb(t.dup) + ' / ↓ ' + hb(t.ddn) + ' (xray)');
						tl.innerHTML = pts.length ? esc(pts.join(' · ')) : __t("T_span_class_muted_empty_so_fa");
					}
				}
				/* сколько служебных записей пропущено при расчёте лампочек */
				var lsn = document.getElementById('lamp-skip-n');
				if (lsn && d.lamp !== undefined) lsn.textContent = d.lamp;
				busy = false;
				if (done) done();
			})
			.catch(function () { busy = false; if (done) done(); });
	}
	window.__panelRepaint = paint;
	/* на «Маршрутах» опрашиваем чаще: подсветка правила должна появляться сразу,
	   как только по нему пошёл трафик. Роутер считает активность не чаще, чем раз
	   в 5 секунд, поэтому чаще 4 секунд спрашивать бессмысленно. */
	var hasRules = !!document.querySelector('tr[data-rule]');
	/* Опрашиваем по кругу, но с оглядкой на роутер: если ответ идёт дольше
	   двух с половиной секунд, спрашиваем реже (раз в 12 секунд). Иначе при
	   нескольких открытых вкладках запросы копились очередью, и «Маршруты»
	   начинали отвечать по 10–15 секунд. */
	setTimeout(function () {
		var timer = null, seq = 0;
		function tick() {
			/* Вкладка панели не на экране — не грузим роутер. Каждый опрос
			   «Маршрутов» стоит ему 1–2 секунды, а зачем это делать, если
			   панель просто висит открытой в фоне. Вернулись на вкладку —
			   состояние обновляем сразу. */
			if (document.hidden) { timer = setTimeout(tick, 5000); return; }
			var t0 = Date.now();
			var my = ++seq;
			paint(function () {
				/* если за это время запустился новый такт (например, вернулись на
				   вкладку) — следующий шаг планирует он, а не мы */
				if (my !== seq) return;
				var took = Date.now() - t0;
				var wait = took > 2500 ? 12000 : (hasRules ? 4000 : 10000);
				timer = setTimeout(tick, wait);
			});
		}
		tick();
		document.addEventListener('visibilitychange', function () {
			if (document.hidden) return;
			if (timer) clearTimeout(timer);
			timer = setTimeout(tick, 300);
		});
	}, hasRules ? 800 : 1500);
})();

/* Применение конфига без перезагрузки страницы: нажали кнопку — она стала
   «Применяется…», дальше панель сама дожидается итога и переписывает надписи. */
(function () {
