# Тяжёлые операции (проверка конфига, перезапуск xray, правила фаервола) уводим
# в фон: браузеру ответ уходит сразу, иначе uhttpd обрывает CGI по таймауту и
# показывает «Bad Gateway / The process did not produce any response».
bg_run() { # $1 команда для sh, $2 файл лога
	_blog="$2"
	if [ -f "$_blog" ] && [ "$(wc -c <"$_blog" 2>/dev/null)" -gt 20000 ] 2>/dev/null; then
		: > "$_blog"
	fi
	if command -v setsid >/dev/null 2>&1; then
		setsid sh -c "$1" >>"$_blog" 2>&1 &
	elif command -v nohup >/dev/null 2>&1; then
		nohup sh -c "$1" >>"$_blog" 2>&1 &
	else
		sh -c "$1" >>"$_blog" 2>&1 &
	fi
}

bg_apply() {
	# итог применения кладём в файлы: страница сама спрашивает состояние и
	# показывает результат, не перезагружаясь (файлы читает страница «jobs»)
	rm -f "$STATE_DIR/apply.rc" 2>/dev/null
	bg_run ". '$LIB' >/dev/null 2>&1; apply_and_restart; _rc=\$?; printf '%s' \"\$_rc\" > '$STATE_DIR/apply.rc'; rm -f '$STATE_DIR/apply.running'" "$STATE_DIR/apply.log"
}

bg_rollback() {
	bg_run ". '$LIB' >/dev/null 2>&1; rollback_config; svc_restart && echo 'xray перезапущен' || echo 'xray НЕ поднялся'" "$STATE_DIR/apply.log"
}

# --- смена версии самой панели ----------------------------------------------
# Аккуратно достаём кусок из multipart-запроса по байтам: пакет — это gzip,
# построчный разбор его бы испортил.
panel_byte_offsets() { # $1 файл, $2 образец: печатает байтовые смещения (0 — начало)
	# busybox grep не умеет -b, поэтому считаем байты сами
	LC_ALL=C awk -v pat="$2" '
		{
			s = $0; p = 1
			while (1) {
				i = index(substr(s, p), pat)
				if (i == 0) break
				print n + p + i - 2
				p = p + i - 1 + length(pat)
			}
			n += length($0) + 1
		}
	' "$1" 2>/dev/null
}

panel_upload_part() { # $1 файл запроса, $2 граница, $3 имя поля, $4 куда писать
	_offs=$(panel_byte_offsets "$1" "--$2")
	_prev=""; _res=1; _fname=""
	for _o in $_offs; do
		if [ -n "$_prev" ]; then
			_len=$((_o - _prev))
			_blk="/tmp/.xpb.$$"
			_hdrf="/tmp/.xph.$$"
			tail -c +$((_prev + 1)) "$1" 2>/dev/null | head -c "$_len" > "$_blk" 2>/dev/null
			# где кончаются заголовки: первая пустая строка (в файле она как "\r")
			_hb=$(LC_ALL=C awk '{ n += length($0) + 1; if ($0 == "\r" || $0 == "") { print n; exit } }' "$_blk")
			[ -n "$_hb" ] || _hb=0
			# имена и тип берём только из заголовков: тело — это сам пакет,
			# а в нём встречается что угодно, включая нулевые байты
			head -c "$_hb" "$_blk" > "$_hdrf" 2>/dev/null
			if grep -q "name=\"$3\"" "$_hdrf" 2>/dev/null; then
				_fname=$(grep -o 'filename="[^"]*"' "$_hdrf" 2>/dev/null | head -1 | sed -e 's/^filename="//' -e 's/"$//')
				_bstart=$((_prev + _hb))
				_blen=$((_o - _bstart - 2))
				[ "$_blen" -gt 0 ] 2>/dev/null || _blen=0
				tail -c +$((_bstart + 1)) "$1" 2>/dev/null | head -c "$_blen" > "$4" 2>/dev/null
				_res=0
			fi
			rm -f "$_blk" "$_hdrf" 2>/dev/null
			[ "$_res" = 0 ] && break
		fi
		_prev="$_o"
	done
	printf '%s' "$_fname" > "$4.name" 2>/dev/null
	return $_res
}

act_panel_upload() {
	_dest="/etc/xraypanel/versions"
	if [ -z "$UPLOAD" ] || [ ! -f "$UPLOAD" ] || [ -z "$_mb" ]; then
		redirect status "файл не пришёл — выберите пакет ещё раз"
	fi
	mkdir -p "$_dest" 2>/dev/null
	_tmp="$UPLOAD.pkg"
	if ! panel_upload_part "$UPLOAD" "$_mb" ipk "$_tmp"; then
		rm -f "$_tmp" "$_tmp.name" 2>/dev/null
		redirect status "в запросе не нашёлся файл — попробуйте выбрать пакет ещё раз"
	fi
	if ! panel_ipk_ok "$_tmp"; then
		rm -f "$_tmp" "$_tmp.name" 2>/dev/null
		redirect status "это не пакет панели (.ipk не читается) — файл не сохранён"
	fi
	_fn=$(sed -e 's#.*/##' -e 's/[^A-Za-z0-9._-]/_/g' "$_tmp.name" 2>/dev/null | head -1)
	case "$_fn" in
		*.ipk) ;;
		'')    _fn="panel-$(date +%Y%m%d-%H%M).ipk" ;;
		*)     _fn="$_fn.ipk" ;;
	esac
	if ! mv -f "$_tmp" "$_dest/$_fn" 2>/dev/null; then
		rm -f "$_tmp" "$_tmp.name" 2>/dev/null
		redirect status "не удалось сохранить пакет в $_dest"
	fi
	rm -f "$_tmp.name" 2>/dev/null
	redirect status "пакет сохранён: $_dest/$_fn (версия $(panel_ipk_version "$_dest/$_fn")). Нажмите «поставить», когда будете готовы."
}

act_panel_dirs() { # папки, где панель ищет пакеты версий
	_d=$(param panel_ipk_dirs | tr -s ' ' | sed -e 's/^ *//' -e 's/ *$//')
	[ -n "$_d" ] || _d="/tmp /etc/xraypanel/versions"
	ui_uci set "$UCI_APP.settings.panel_ipk_dirs=$_d"
	uci commit "$UCI_APP" >/dev/null 2>&1
	redirect status "папки для пакетов сохранены: $_d"
}

act_panel_install() {
	_f=$(param file)
	case "$_f" in
		*.ipk) ;;
		*) redirect status "пакет не выбран" ;;
	esac
	[ -f "$_f" ] || redirect status "файла нет: $_f"
	if ! panel_ipk_ok "$_f"; then
		redirect status "это не пакет панели (.ipk не читается): $_f"
	fi
	_v=$(panel_ipk_version "$_f")
	if [ "$_v" = "$(panel_version)" ]; then
		redirect status "эта версия уже установлена ($_v)"
	fi
	if ! panel_ipk_sane "$_f"; then
		redirect status "не ставлю: панель внутри этого пакета не проходит проверку (неверный формат или ошибка в самой панели). Такой пакет может оставить роутер без панели."
	fi
	# помним, что стояло: по этой записи работает кнопка «вернуть прежнюю версию»
	_prev=$(cfg panel_installed_ipk "")
	ui_uci set "$UCI_APP.settings.panel_prev_ipk=$_prev"
	ui_uci set "$UCI_APP.settings.panel_installed_ipk=$_f"
	uci commit "$UCI_APP" >/dev/null 2>&1
	rm -f "$STATE_DIR/panel-install.rc" 2>/dev/null
	bg_run "echo 'ставлю: $_f (версия $_v)'; opkg install --force-reinstall '$_f' 2>&1; _rc=\$?; printf '%s' \"\$_rc\" > '$STATE_DIR/panel-install.rc'; echo \"код возврата: \$_rc\"" "$STATE_DIR/panel-install.log"
	respond_now status "устанавливаю версию $_v — через 10–20 секунд обновите страницу. Настройки, серверы и правила не трогаются."
	exit 0
}

bg_trans_on() {
	bg_run "'$ENABLER'" "$STATE_DIR/transparent.log"
}

bg_trans_off() {
	bg_run "'$DISABLER'" "$STATE_DIR/transparent.log"
}

trans_save() {
	# порты проверяем: значение не из формы, а из чужого файла настроек тоже
	# может оказаться мусором — тогда просто не сохраняем его
	_badports=""
	for _f in transparent_port transparent_scope transparent_out dns_port dns_resolver; do
		_v=$(param "$_f")
		case "$_f" in
			transparent_port|dns_port)
				if [ -n "$_v" ] && ! valid_port "$_v"; then
					_badports="$_badports $_f=$_v"
					continue
				fi
				;;
		esac
		if [ -n "$_v" ]; then ui_uci set "$UCI_APP.settings.$_f=$_v"; else ui_uci delete "$UCI_APP.settings.$_f"; fi
	done
	# Интерфейс сети нужен только там, где заворачивается вся локальная сеть
	# (режимы «вся сеть» и «роутер и сеть»). Определяем его сами по настройкам
	# роутера — вручную указывать не нужно. Поле в форме осталось только как
	# запасной вариант, если определить не удалось.
	case "$(param transparent_scope)" in
		lan|both)
			# отмеченные галочками интерфейсы; если ничего не отмечено —
			# подставляем LAN-мост роутера
			_v=$(params_all transparent_iface | tr '\n' ',')
			[ -n "$_v" ] || _v=$(lan_main_iface)
			_m=$(param transparent_iface_manual | tr ' ' ',')
			_all=$(uniq_list "$_v,$_m")
			if [ -n "$_all" ]; then ui_uci set "$UCI_APP.settings.transparent_iface=$_all"; fi
			;;
	esac
	# DNS — три понятных выбора вместо прежней путаницы из двух галочек:
	#   dns_clients     — куда уходит DNS клиентов: none | tunnel | router
	#   dns_resolver_up — чем отвечает роутерный резолвер: own | tunnel
	#   dns_router_own  — «и DNS самого роутера тем же путём»
	# Внутри оставляем прежние ключи (dns_tunnel / dns_client_via / dns_router):
	# их читает transparent.sh, и менять их смысл не нужно.
	case "$(param dns_clients)" in
		tunnel)
			ui_uci set "$UCI_APP.settings.dns_tunnel=1"
			ui_uci set "$UCI_APP.settings.dns_client_via=xray" ;;
		router)
			ui_uci set "$UCI_APP.settings.dns_tunnel=1"
			ui_uci set "$UCI_APP.settings.dns_client_via=router" ;;
		*)
			ui_uci set "$UCI_APP.settings.dns_tunnel=0" ;;
	esac
	# «через туннель» и галочка про сам роутер — это одно и то же действие:
	# роутерный резолвер один на всех, поэтому оба варианта переводят dnsmasq
	# на вход xray (панель пропишет 127.0.0.1#5353 и вернёт всё назад).
	if [ "$(param dns_resolver_up)" = tunnel ] || [ "$(param dns_router_own)" = 1 ]; then
		ui_uci set "$UCI_APP.settings.dns_router=1"
	else
		ui_uci set "$UCI_APP.settings.dns_router=0"
	fi
	# шифрованный DNS: закрываем, чтобы клиент не обошёл перехват своим
	# «приватным DNS» (DoT) или DoH-сервером
	if [ "$(param block_dot)" = 1 ]; then ui_uci set "$UCI_APP.settings.block_dot=1"; else ui_uci set "$UCI_APP.settings.block_dot=0"; fi
	if [ "$(param block_doh)" = 1 ]; then ui_uci set "$UCI_APP.settings.block_doh=1"; else ui_uci set "$UCI_APP.settings.block_doh=0"; fi
	if [ "$(param dns_canary)" = 1 ]; then ui_uci set "$UCI_APP.settings.dns_canary=1"; else ui_uci set "$UCI_APP.settings.dns_canary=0"; fi
	if [ "$(param dns_bootstrap)" = 1 ]; then ui_uci set "$UCI_APP.settings.dns_bootstrap=1"; else ui_uci set "$UCI_APP.settings.dns_bootstrap=0"; fi
	if [ "$(param auto_calm)" = 1 ]; then ui_uci set "$UCI_APP.settings.auto_calm=1"; else ui_uci set "$UCI_APP.settings.auto_calm=0"; fi
	_v=$(param doh_block_list | tr ',;' '  ' | tr -s ' ' | sed 's/^ *//; s/ *$//')
	if [ -n "$_v" ]; then ui_uci set "$UCI_APP.settings.doh_block_list=$_v"; fi
	# список резолверов: сохраняем списком, а первый дублируем в dns_resolver
	# (это значение читают старые версии панели и часть подсказок)
	_v=$(param dns_resolvers | tr ',;' '  ' | tr -s ' ' | sed 's/^ *//; s/ *$//')
	if [ -n "$_v" ]; then
		ui_uci set "$UCI_APP.settings.dns_resolvers=$_v"
		ui_uci set "$UCI_APP.settings.dns_resolver=${_v%% *}"
	else
		ui_uci delete "$UCI_APP.settings.dns_resolvers"
	fi
	_v=$(param dns_out)
	if [ -n "$_v" ]; then ui_uci set "$UCI_APP.settings.dns_out=$_v"; else ui_uci delete "$UCI_APP.settings.dns_out"; fi
	_v=$(param dns_server_mode)
	if [ "$_v" = plain ]; then ui_uci set "$UCI_APP.settings.dns_server_mode=plain"; else ui_uci delete "$UCI_APP.settings.dns_server_mode"; fi
	_v=$(param dns_mode)
	case "$_v" in
		module|relay) ui_uci set "$UCI_APP.settings.dns_mode=$_v" ;;
		*)            ui_uci delete "$UCI_APP.settings.dns_mode" ;;
	esac
}

# --- сохранение и восстановление настроек ------------------------------------
act_export() { # отдаём настройки файлом
	echo "Content-Type: application/octet-stream"
	printf 'Content-Disposition: attachment; filename="xraypanel-%s.conf"\n' "$(date +%Y%m%d-%H%M)"
	echo
	printf '# Настройки панели xraypanel, сохранено %s\n' "$(date '+%Y-%m-%d %H:%M:%S')"
	_cf="${XRAYPANEL_CONF_DIR:-/etc/config}/$UCI_APP"
	if [ "$(param keep_clients)" = 1 ]; then
		[ -f "$_cf" ] && cat "$_cf"
	else
		# Список клиентов у каждого роутера свой: адреса из другой сети на новом
		# роутере только путают. Оставляем их закомментированными — видно, что
		# было, но в настройки они не попадут.
		[ -f "$_cf" ] && sed -e 's/^\(option transparent_clients .*\)$/# список клиентов этого роутера, при переносе не применяется:\n#\1/' "$_cf"
	fi
	exit 0
}

act_import() { # восстанавливаем настройки из вставленного текста
	if [ -n "$UPLOAD" ] && [ -f "$UPLOAD" ] && [ -n "$_mb" ]; then
		# файл, выбранный в проводнике: достаём его из multipart-запроса
		_imp="$UPLOAD.conf"
		awk -v delim="--$_mb" '
			{ sub(/\r$/, "") }
			BEGIN { st = 0 }
			index($0, delim) == 1 { st = 1; hdr = ""; next }
			st == 1 {
				if ($0 == "") { st = (hdr ~ /name="cfgfile"/) ? 2 : 0; next }
				hdr = hdr " " $0; next
			}
			st == 2 { print }
		' "$UPLOAD" | sed 's/\r$//' > "$_imp"
		_text=$(cat "$_imp" 2>/dev/null)
		rm -f "$_imp" 2>/dev/null
	else
		_text=$(param cfgtext)
	fi
	case "$_text" in
		*"config settings"*|*"config server"*|*"config bridge"*|*"config rule"*|*"package xraypanel"*) ;;
		*) redirect settings "не похоже на настройки панели: вставьте текст из файла, скачанного кнопкой «Скачать настройки»" ;;
	esac
	_cdir="${XRAYPANEL_CONF_DIR:-/etc/config}"
	_bak="$_cdir/$UCI_APP.bak-$(date +%Y%m%d-%H%M%S)"
	cp -f "$_cdir/$UCI_APP" "$_bak" 2>/dev/null
	if ! printf '%s\n' "$_text" > "$_cdir/$UCI_APP"; then
		redirect settings "не удалось записать файл настроек"
	fi
	if ! uci -q show "$UCI_APP" >/dev/null 2>&1; then
		cp -f "$_bak" "$_cdir/$UCI_APP" 2>/dev/null
		redirect settings "во вставленных настройках ошибка — вернул прежний файл (копия: $_bak)"
	fi
	uci commit "$UCI_APP" >/dev/null 2>&1
	# на другом роутере адреса клиентов могут быть чужими — убираем их
	_dropped=$(prune_transparent_clients 2>/dev/null)
	# пути к xray, конфигу и журналам у прежнего роутера могли быть другими:
	# если тут таких нет — убираем, иначе панель не найдёт ни бинарник,
	# ни службу, и вход перехвата не поднимется
	_fixed=""
	_v=$(uci -q get "$UCI_APP.settings.xray_bin" 2>/dev/null)
	[ -n "$_v" ] && [ ! -x "$_v" ] && { uci -q delete "$UCI_APP.settings.xray_bin"; _fixed="$_fixed путь к xray,"; }
	_v=$(uci -q get "$UCI_APP.settings.config_path" 2>/dev/null)
	[ -n "$_v" ] && [ ! -d "$(dirname "$_v")" ] && { uci -q delete "$UCI_APP.settings.config_path"; _fixed="$_fixed путь к конфигу,"; }
	_v=$(uci -q get "$UCI_APP.settings.log_dir" 2>/dev/null)
	[ -n "$_v" ] && [ ! -d "$_v" ] && { uci -q delete "$UCI_APP.settings.log_dir"; _fixed="$_fixed каталог журналов,"; }
	_v=$(uci -q get "$UCI_APP.settings.service" 2>/dev/null)
	[ -n "$_v" ] && [ ! -x "/etc/init.d/$_v" ] && { uci -q delete "$UCI_APP.settings.service"; _fixed="$_fixed имя службы,"; }
	if [ -n "$_fixed" ]; then
		uci commit "$UCI_APP" >/dev/null 2>&1
		_fixed=" Подчищены настройки прежнего роутера: ${_fixed%,}."
	fi
	_note=""
	[ -n "$_dropped" ] && _note=" Из списка клиентов убраны адреса, которых на этом роутере нет: $_dropped."
	respond_now settings "настройки восстановлены.${_note}${_fixed} Конфиг применяется — обновите страницу через пару секунд. Прежний файл сохранён: $_bak"
	bg_apply
	exit 0
}

act_trans_on() {
	# клиентов отмечаем галочками в списке подключённых устройств
	_picked=$(params_all client | tr '\n' ',')
	_clients=$(uniq_list "$_picked")
	_out=$(param transparent_out)
	trans_save
	if [ "$_out" = "auto" ]; then
		ui_uci set "$UCI_APP.settings.auto_best=1"
		ui_uci delete "$UCI_APP.settings.transparent_out"
	else
		# выбрали конкретный выход (или «по правилам панели») — автовыбор
		# выключаем, иначе балансировщик остался бы главным и настройка не
		# действовала бы
		ui_uci set "$UCI_APP.settings.auto_best=0"
		ui_uci set "$UCI_APP.settings.transparent_out=$_out"
	fi
	# Список клиентов нужен только режиму «только клиенты из списка». Там он
	# обязателен: с пустым списком перехват не ставится и режим не включается
	# (раньше панель при всех отмеченных галочках сохраняла «пусто = все», и
	# включение молча срывалось). В остальных режимах заворачиваются все, и
	# список только мешает.
	case "$(param transparent_scope)" in
		list)
			if [ -z "$_clients" ]; then
				respond_now transparent "В режиме «только клиенты из списка» отметьте галочкой хотя бы одного клиента — иначе заворачивать некого, режим не включаю."
				exit 0
			fi
			ui_uci set "$UCI_APP.settings.transparent_clients=$_clients"
			;;
		*)
			ui_uci delete "$UCI_APP.settings.transparent_clients"
			;;
	esac
	ui_uci set "$UCI_APP.settings.transparent=1"
	uci commit "$UCI_APP" >/dev/null 2>&1
	printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "включаю прозрачный режим…" > "$STATE_DIR/transparent.last" 2>/dev/null
	_note=""
	[ -n "$_badports" ] && _note="Не сохранил неверные порты:$_badports (нужны только цифры, 1–65535). "
	respond_now transparent "$_noteвключаю прозрачный режим. Через несколько секунд обновите страницу — результат появится в блоке «Состояние»."
	bg_trans_on
	exit 0
}

act_trans_keep() {
	_sh=$("$TRANS" keep 2>&1)
	redirect transparent "$_sh"
}

act_trans_off() {
	ui_uci set "$UCI_APP.settings.transparent=0"
	uci commit "$UCI_APP" >/dev/null 2>&1
	printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "выключаю прозрачный режим…" > "$STATE_DIR/transparent.last" 2>/dev/null
	respond_now transparent "выключаю прозрачный режим. Через несколько секунд обновите страницу."
	bg_trans_off
	exit 0
}

# Пинг всех серверов и выбор самого быстрого как основного.
act_dedup() {
	_n=$(dedup_servers 2>/dev/null)
	[ "${_n:-0}" != 0 ] && pending_note "убраны дубли серверов"
	redirect servers "убрано дублей: ${_n:-0}. Осталось нажать «Применить конфиг»."
}

act_traffic_reset() {
	_msg=$(traffic_reset 2>/dev/null)
	redirect transparent "счётчики трафика по клиентам обнулены${_msg:+ ($_msg)}"
}

act_traffic_reset_one() {
	_ip=$(param ip)
	[ -n "$_ip" ] || redirect transparent "не выбран клиент"
	traffic_reset_client "$_ip"
	redirect transparent "счётчик клиента $_ip обнулён"
}

act_dnslog_on() { # включить запись запросов dnsmasq (имена сайтов для правил)
	dns_log_on
	case "$?" in
		0) redirect rules "включил запись запросов DNS (штатная настройка dnsmasq, отдельный файл не создаётся). Панель проверила: записи в журнал идут. Первые имена появятся через несколько минут — столько нужно, чтобы клиенты разобрали имена заново." ;;
		2) redirect rules "не получилось: после включения dnsmasq не поднялся — я вернул прежние настройки и запустил его заново. Запись запросов осталась выключенной." ;;
		3) _bl=$(dns_log_blocker); redirect rules "запись запросов включена, но записей в системном журнале не видно. ${_bl:-Загляните в системный журнал роутера (LuCI → Статус → Системный журнал): строк dnsmasq там нет, значит его журнал отключён где-то ещё.}" ;;
		*) redirect rules "включить не удалось: dnsmasq сейчас не работает (или в настройках нет раздела dnsmasq) — я ничего не менял." ;;
	esac
}

act_dnslog_off() {
	dns_log_off
	redirect rules "выключил запись запросов DNS и вернул прежние настройки dnsmasq"
}

act_dnslog_repair() { # «починить»: перезапустить dnsmasq, чтобы он снова писал в журнал
	dns_log_repair
	case "$?" in
		0) redirect rules "перезапустил dnsmasq — он снова пишет запросы в системный журнал. Имена появятся в течение нескольких минут." ;;
		2) redirect rules "dnsmasq после перезапуска не поднялся. Откройте «Прокси» и посмотрите состояние службы, либо перезагрузите роутер." ;;
		3) redirect rules "dnsmasq работает, но записей в системном журнале всё равно нет — посмотрите системный журнал роутера (LuCI → Статус → Системный журнал)." ;;
		*) redirect rules "не удалось: dnsmasq сейчас не работает — сначала поднимите его на странице «Прокси»." ;;
	esac
}

# Само собой: если dnsmasq потерял системный журнал (бывает после сбоя logd),
# панель перезапускает его сама — но не чаще раза в час, чтобы не дёргать DNS
# без нужды. Так лампочки не начинают «врать» незаметно для пользователя.
dns_try_repair() {
	_at="$STATE_DIR/dns-repair.at"
	_now=$(date +%s 2>/dev/null)
	case "$_now" in ''|*[!0-9]*) _now=0 ;; esac
	_old=$(cat "$_at" 2>/dev/null)
	case "$_old" in ''|*[!0-9]*) _old=0 ;; esac
	[ "$_now" -gt 0 ] && [ $((_now - _old)) -lt 3600 ] && return 0
	[ "$_now" -gt 0 ] && printf '%s' "$_now" > "$_at" 2>/dev/null
	bg_run ". '$LIB' >/dev/null 2>&1; dns_log_repair >/dev/null 2>&1" "$STATE_DIR/dns-repair.log"
	return 0
}

act_sub_save() { # добавить подписку и сразу её обновить
	_want=$(param sec | sed -e 's/[^A-Za-z0-9._-]/-/g')
	_url=$(param url)
	[ -n "$_url" ] || redirect servers "нужен адрес подписки"
	[ -n "$_want" ] || _want="sub"
	_sec=$(ensure_section sub "$_want")
	[ -n "$_sec" ] || redirect servers "не удалось создать раздел подписки"
	ui_uci set "$UCI_APP.$_sec.url=$_url"
	_ua=$(param ua); [ -n "$_ua" ] && ui_uci set "$UCI_APP.$_sec.ua=$_ua"
	uci commit "$UCI_APP" >/dev/null 2>&1
	_out=$(sub_update "$_sec" 2>&1)
	pending_note "добавлена подписка «$_sec» и обновлены её узлы"
	redirect servers "подписка $_sec: $_out. Осталось нажать «Применить конфиг» на странице «Статус»."
}

act_sub_update() {
	_s=$(param sec)
	# тихое обновление со страницы: ответ в виде JSON, страница не перезагружается
	if [ "$(param ajax)" = 1 ]; then
		printf 'Content-Type: application/json; charset=utf-8\n\n'
		if [ -z "$_s" ]; then
			printf '{"ok":false,"text":"не выбрана подписка"}'
			exit 0
		fi
		_out=$(sub_update "$_s" 2>&1)
		pending_note "обновлены узлы подписки «$_s»"
		printf '{"ok":true,"text":"%s","count":"%s","updated":"%s"}' \
			"$(jesc "$_out")" \
			"$(jesc "$(uci -q get "$UCI_APP.$_s.count" 2>/dev/null)")" \
			"$(jesc "$(uci -q get "$UCI_APP.$_s.updated" 2>/dev/null)")"
		exit 0
	fi
	[ -n "$_s" ] || redirect servers "не выбрана подписка"
	_out=$(sub_update "$_s" 2>&1)
	redirect servers "подписка $_s обновлена: $_out. Осталось нажать «Применить конфиг»."
}

act_sub_del() {
	_s=$(param sec)
	[ -n "$_s" ] || redirect servers "не выбрана подписка"
	for _sec in $(server_sections); do
		[ "$(uci -q get "$UCI_APP.$_sec.sub" 2>/dev/null)" = "$_s" ] && ui_uci delete "$UCI_APP.$_sec"
	done
	ui_uci delete "$UCI_APP.$_s"
	uci commit "$UCI_APP" >/dev/null 2>&1
	redirect servers "подписка $_s и её серверы удалены"
}

# --- проверка DNS: куда реально уходит запрос --------------------------------
act_rule_find() {
	_d=$(param name)
	# принимаем и ссылку, и домен с путём или портом — оставляем только имя
	_d=$(printf '%s' "$_d" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' \
		-e 's#^[A-Za-z][A-Za-z0-9+.-]*://##' -e 's#/.*$##' -e 's#:.*$##' | tr 'A-Z' 'a-z')
	case "$_d" in
		''|*[!a-z0-9._-]*) _out="введите домен, например youtube.com" ;;
		*)
			# Полный разбор файлов со списками занимает много времени (они
			# большие), из-за чего uhttpd успевал отдать «Bad Gateway».
			# Поэтому первый поиск запускаем В ФОНЕ: страница сразу получает
			# ответ «ищу», сама спрашивает готовность и показывает отчёт, когда
			# он готов. Повторный поиск того же домена берётся из кэша сразу.
			if ! geo_lookup_cached "$_d"; then
				: >"$STATE_DIR/lookup.running" 2>/dev/null
				bg_run ". '$LIB' >/dev/null 2>&1; geo_find_lists '$_d' >/dev/null 2>&1; rm -f '$STATE_DIR/lookup.running'" "$STATE_DIR/lookup.log"
				if [ "$(param ajax)" = 1 ]; then
					printf 'Content-Type: text/plain; charset=utf-8\n\nищу: просматриваю файлы готовых списков — это несколько секунд'
					exit 0
				fi
				redirect rules "ищу домен $_d в готовых списках — результат появится через несколько секунд"
			fi
			_lists=$(geo_find_lists "$_d" 2>/dev/null); _lrc=$?
			_slow=""
			[ -z "$_lists" ] && _slow=0
			_names=$(printf '%s\n' "$_lists" | cut -f1 | LC_ALL=C sort -u | tr '\n' ' ' | sed -e 's/[[:space:]]*$//')
			# для сравнения с названиями правил — без учёта регистра
			_nameslow=$(printf '%s' "$_names" | tr 'A-Z' 'a-z')
			# какие правила подходят: идём сверху вниз, как это делает xray
			_hit=""; _hitline=""; _hitgeo=""
			# разбираем правила по наборам: каждое правило — это «кто → наборы → выход»
			while IFS="$(printf '\t')" read -r _r _s _t _v; do
				[ -n "$_r" ] || continue
				rule_disabled "$_r" && continue
				_o=$(uci -q get "$UCI_APP.$_r.outbound" 2>/dev/null)
				_vl=$(printf '%s' "$_v" | tr 'A-Z' 'a-z')
				_ok=""
				case "$_t" in
					full)    [ "$_d" = "$_vl" ] && _ok=1 ;;
					domain)  [ "$_d" = "$_vl" ] && _ok=1
					         case "$_d" in *".$_vl") _ok=1 ;; esac ;;
					keyword) case "$_d" in *"$_vl"*) _ok=1 ;; esac ;;
					geosite) case " $_nameslow " in *" $_vl "*) _ok=1; _hitgeo=1 ;; esac ;;
					'')      _ok=1 ;;   # правило без условий ловит всё
				esac
				if [ -n "$_ok" ]; then
					_sets=$(uci -q get "$UCI_APP.$_r.sets" 2>/dev/null)
					_snames=""
					for _st in $(printf '%s' "$_sets" | tr ',' ' '); do
						_snames="${_snames}${_snames:+, }$(set_name "$_st")"
					done
					_line="$_r — $( [ -n "$_s" ] && printf 'устройство %s, ' "$_s" )$( [ -n "$_snames" ] && printf 'набор «%s», ' "$_snames" )$( [ -n "$_t" ] && rule_matcher_value "$_t" "$_v" ) → ${_o:-не задан}"
					if [ -z "$_hit" ]; then
						_hit="$_r"; _hitline="${_line#$_r — }"
						[ "$_t" = geosite ] && _hitgeo=1
					else
						_nr=$(( ${_nr:-0} + 1 ))
						[ "$_nr" -le 3 ] && _rest="$_rest
   перекрыто: $_line"
					fi
				fi
			done <<EOL
$(rule_conditions)
EOL
			# собираем отчёт
			_out="Домен: $_d"
			if [ "${_slow:-0}" = 1 ]; then
				_out="$_out
Проверка по готовым спискам не уложилась в 8 секунд — файлы на роутере большие. Ниже показан разбор ваших правил; если нужно, повторите проверку ещё раз (часть ответов кэшируется)."
			fi
			if [ -n "$_names" ]; then
				# каждое название — отдельной плашкой: навёл — подсветилось,
				# нажал — скопировалось (цвета чередуются, чтобы читалось)
				_chips=""; _ci=0
				for _nm in $_names; do
					_ci=$((_ci + 1))
					case $((_ci % 2)) in 1) _cc=dom-a ;; *) _cc=dom-b ;; esac
					_chips="$_chips<span class=\"dom $_cc\" data-copy=\"$_nm\">$_nm</span> "
				done
				# подсказка про нажатия — прямо в результатах проверки, чтобы
				# не искать её в другом месте
				_out="$_out
Есть в готовых списках: $_chips
(нажми на домен — скопируется в буфер; задержи на секунду — добавится в «Значение»)"
			else
				_out="$_out
В готовых списках домена нет — придётся указывать его вручную (домен) или шаблоном."
			fi
			if [ -n "$_hit" ]; then
				_out="$_out
Работает правило: $_hit — $_hitline"
				if [ -n "$_hitgeo" ]; then
					_out="$_out
Это правило и поймает такой трафик."
				else
					_out="$_out
Правило по домену ловит сам сайт и его поддомены. Если нужен весь сервис (видео, картинки на других доменах), берите готовый список."
				fi
				if [ -n "$_rest" ]; then
					_out="$_out
Ниже подходят, но перекрыты этим правилом:$_rest
(xray берёт первое подходящее сверху — чтобы работало своё правило, поднимите его кнопкой ⤒)"
				fi
			else
				_out="$_out
Ни одно правило сейчас не подходит — такой трафик пойдёт по остальным (как настроено на «Прокси»)."
				# советуем самый подходящий список: сначала тот, чьё имя похоже на
				# домен (ozon.ru -> OZON), иначе самый короткий
				_first=$(printf '%s\n' "$_lists" | LC_ALL=C awk -F'\t' -v d="$_d" '
					{ lines[NR] = $1 }
					END {
						n = split(d, L, ".")
						hit = ""
						for (k = 1; k <= NR && hit == ""; k++) {
							tag = tolower(lines[k])
							for (i = 1; i < n; i++) {
								if (length(L[i]) < 4) continue
								if (index(tag, tolower(L[i])) > 0) { hit = lines[k]; break }
							}
						}
						if (hit == "") {
							best = ""
							for (k = 1; k <= NR; k++)
								if (best == "" || length(lines[k]) < length(best)) best = lines[k]
							hit = best
						}
						if (hit != "") print hit
					}')
				if [ -n "$_first" ]; then
					_out="$_out
Чтобы ловить его, добавьте правило: тип «готовый список доменов», значение $_first."
				else
					_out="$_out
Чтобы ловить его, добавьте правило: тип «Домен и поддомены», значение $_d."
				fi
			fi
			;;
	esac
	if [ "$(param ajax)" = 1 ]; then
		# в тихом режиме отдаём только текст результата: страница показывает
		# его под полем, перезагрузка не нужна
		printf 'Content-Type: text/plain; charset=utf-8\n\n%s' "$_out"
		exit 0
	fi
	redirect rules "$_out"
}

