page_server() {
	_sec=$(param sec)
	_t=$(uci -q get "$UCI_APP.$_sec.tag")
	_pr=$(uci -q get "$UCI_APP.$_sec.protocol")
	[ -n "$_pr" ] || _pr=vless
	_a=$(uci -q get "$UCI_APP.$_sec.address")
	_p=$(uci -q get "$UCI_APP.$_sec.port")
	_u=$(uci -q get "$UCI_APP.$_sec.uuid")
	_f=$(uci -q get "$UCI_APP.$_sec.flow")
	_n=$(uci -q get "$UCI_APP.$_sec.sni")
	_k=$(uci -q get "$UCI_APP.$_sec.publickey")
	_i=$(uci -q get "$UCI_APP.$_sec.shortid")
	_g=$(uci -q get "$UCI_APP.$_sec.fingerprint")
	_m=$(uci -q get "$UCI_APP.$_sec.method")
	_pw=$(uci -q get "$UCI_APP.$_sec.password")
	_wgp=$(uci -q get "$UCI_APP.$_sec.wg_private")
	_wgk=$(uci -q get "$UCI_APP.$_sec.wg_peer")
	_wga=$(uci -q get "$UCI_APP.$_sec.wg_address")
	_wgl=$(uci -q get "$UCI_APP.$_sec.wg_allowed")
	_mtu=$(uci -q get "$UCI_APP.$_sec.mtu")
	printf '<div class="card"><h2>%s</h2><form method="post"><input type="hidden" name="action" value="save_server">' \
		"$([ -n "$_sec" ] && echo "Сервер $_sec" || echo "Новый сервер")"
	[ -n "$_sec" ] && printf '<input type="hidden" name="sec" value="%s">' "$(h "$_sec")"
	printf '<div class="row">'
	[ -z "$_sec" ] && printf '<div><label>'"$T_section_name_latin_letters_o"'</label><input name="sec" placeholder="de1"></div>'
	# протокол выхода: от него зависит, какие поля нужны
	printf '<div><label>'"$T_protocol"'</label><select name="protocol" id="proto">'
	printf '<option value="vless" %s>VLESS + Reality</option>' "$([ "$_pr" = vless ] && echo selected)"
	printf '<option value="ss" %s>Shadowsocks</option>' "$([ "$_pr" = ss ] && echo selected)"
	printf '<option value="hysteria" %s>Hysteria 2</option>' "$([ "$_pr" = hysteria ] && echo selected)"
	printf '<option value="vmess" %s>VMess</option>' "$([ "$_pr" = vmess ] && echo selected)"
	printf '<option value="trojan" %s>Trojan</option>' "$([ "$_pr" = trojan ] && echo selected)"
	printf '<option value="wireguard" %s>WireGuard</option>' "$([ "$_pr" = wireguard ] && echo selected)"
	printf '</select></div>'
	# Поля показываются в зависимости от протокола (переключает скрипт ниже).
	# «f-common» — общие для всех (тег, адрес, порт): раньше они были помечены
	# как «только для VLESS» и у остальных протоколов пропадали, поэтому сервер
	# кроме VLESS через форму было просто не создать. UUID нужен ещё и VMess,
	# SNI — VMess и Trojan.
	for _pair in "tag:$T_outbound_tag:$_t:f-common" "address:$T_server_address_ip_or_domain:$_a:f-common" \
		"port:$T_port:$_p:f-common" "uuid:UUID:$_u:f-vless f-vmess" "flow:$T_flow_vless_reality_only:$_f:f-vless" \
		"sni:SNI (serverName):$_n:f-vless f-vmess f-trojan f-hysteria" \
		"publickey:Public key (Reality):$_k:f-vless" "shortid:Short ID:$_i:f-vless" \
		"fingerprint:Fingerprint:$_g:f-vless"; do
		_name=${_pair%%:*}; _rest=${_pair#*:}; _label=${_rest%%:*}; _rest=${_rest#*:}; _val=${_rest%%:*}; _cls=${_rest#*:}
		printf '<div class="%s"><label>%s</label><input name="%s" value="%s"></div>' "$_cls" "$(h "$_label")" "$_name" "$(h "$_val")"
	done
	printf '<div class="f-ss"><label>'"$T_encryption_method_can_be_cho"'</label><input name="method" value="%s" list="ss-methods" placeholder="'"$T_aes_256_gcm_or_2022_blake3_a"'"><datalist id="ss-methods">' "$(h "$_m")"
	# «none» из списка убран: xray такого метода не знает
	# («infra/conf: unknown cipher method: none») — остальные проверены на живом xray
	for _mm in aes-128-gcm aes-256-gcm chacha20-ietf-poly1305 xchacha20-ietf-poly1305 \
		2022-blake3-aes-128-gcm 2022-blake3-aes-256-gcm 2022-blake3-chacha20-poly1305; do
		printf '<option value="%s"></option>' "$_mm"
	done
	printf '</datalist></div>'
	printf '<p class="f-ss muted">Все методы из списка проверены на живом xray. У методов 2022-blake3 ключ должен быть base64 нужной длины: 16 байт у aes-128, 32 байта у aes-256 и chacha20; метод <code>none</code> xray не поддерживает.</p>'
	printf '<div class="f-ss f-hysteria f-trojan"><label>'"$T_password"'</label><input name="password" value="%s"></div>' "$(h "$_pw")"
	printf '<div class="f-vmess f-vless"><label>'"$T_network_tcp_or_ws"'</label><input name="network" value="%s" placeholder="tcp"></div>' "$(h "$(uci -q get "$UCI_APP.$_sec.network")")"
	printf '<div class="f-vmess f-vless"><label>'"$T_path_for_ws"'</label><input name="path" value="%s" placeholder="/ws"></div>' "$(h "$(uci -q get "$UCI_APP.$_sec.path")")"
	printf '<div class="f-vmess f-vless"><label>'"$T_host_for_ws"'</label><input name="hosthdr" value="%s"></div>' "$(h "$(uci -q get "$UCI_APP.$_sec.hosthdr")")"
	printf '<p class="f-vmess f-vless muted">Для VLESS: сеть <b>tcp</b> — обычный Reality (нужен публичный ключ pbk), сеть <b>ws</b> — WebSocket (обычно через CDN; тогда заполните «Путь» и «Host», а поле Flow оставьте пустым — с ws оно несовместимо).</p>' 
	printf '<div class="f-vmess"><label>TLS</label><select name="tls"><option value="0" %s>'"$T_no"'</option><option value="1" %s>'"$T_yes"'</option></select></div>' \
		"$([ "$(uci -q get "$UCI_APP.$_sec.tls")" != 1 ] && echo selected)" "$([ "$(uci -q get "$UCI_APP.$_sec.tls")" = 1 ] && echo selected)"
	printf '<div class="f-hysteria"><label>'"$T_verify_certificate"'</label><select name="insecure"><option value="0" %s>'"$T_verify"'</option><option value="1" %s>'"$T_do_not_verify_allowinsecure"'</option></select></div>' \
		"$([ "$(uci -q get "$UCI_APP.$_sec.insecure")" != 1 ] && echo selected)" "$([ "$(uci -q get "$UCI_APP.$_sec.insecure")" = 1 ] && echo selected)"
	# обфускация Hysteria 2 (salamander): нужна, если сервер её требует. В xray
	# это «финальная маска» (finalmask.udp), в ссылках приходит как obfs=salamander
	printf '<div class="f-hysteria"><label>'"$T_obfuscation"'</label><select name="hy_obfs">'
	printf '<option value="" %s>'"$T_no"'</option>' "$([ "$(uci -q get "$UCI_APP.$_sec.hy_obfs")" != salamander ] && echo selected)"
	printf '<option value="salamander" %s>'"$T_salamander_as_in_hysteria_2"'</option>' "$([ "$(uci -q get "$UCI_APP.$_sec.hy_obfs")" = salamander ] && echo selected)"
	printf '</select></div>'
	printf '<div class="f-hysteria"><label>'"$T_obfuscation_password"'</label><input name="hy_obfs_pass" value="%s" placeholder="'"$T_obfs_password_from_the_link"'"></div>' "$(h "$(uci -q get "$UCI_APP.$_sec.hy_obfs_pass")")"
	printf '<div class="f-wg"><label>'"$T_client_private_key_secretkey"'</label><input name="wg_private" value="%s"></div>' "$(h "$_wgp")"
	printf '<div class="f-wg"><label>'"$T_server_public_key_publickey"'</label><input name="wg_peer" value="%s"></div>' "$(h "$_wgk")"
	printf '<div class="f-wg"><label>'"$T_client_address_for_example_1"'</label><input name="wg_address" value="%s"></div>' "$(h "$_wga")"
	printf '<div class="f-wg"><label>'"$T_where_to_route_allowedips"'</label><input name="wg_allowed" value="%s" placeholder="0.0.0.0/0"></div>' "$(h "$_wgl")"
	printf '<div class="f-wg"><label>MTU</label><input name="mtu" value="%s" placeholder="1420"></div>' "$(h "$_mtu")"
	printf '</div><p><button>'"$T_save"'</button></p></form>'
	# показываем только поля выбранного протокола
	printf '<script>(function(){var s=document.getElementById("proto");if(!s)return;function u(){var v=s.value;var show={"vless":["f-vless"],"ss":["f-ss"],"hysteria":["f-hysteria"],"wireguard":["f-wg"],"vmess":["f-vmess"],"trojan":["f-trojan"]}[v]||[];document.querySelectorAll(".f-common,.f-vless,.f-ss,.f-hysteria,.f-wg,.f-vmess,.f-trojan").forEach(function(e){var cl=e.className;var on=cl.indexOf("f-common")>=0;show.forEach(function(c){if(cl.indexOf(c)>=0)on=true});e.style.display=on?"":"none"});}s.addEventListener("change",u);u()})()</script>\n'
	[ -n "$_sec" ] && printf '<form method="post"><input type="hidden" name="action" value="del_server"><input type="hidden" name="sec" value="%s"><button class="btn danger">'"$T_delete_server"'</button></form>' "$(h "$_sec")"
	[ -n "$_sec" ] && printf ' <form method="post" style="display:inline"><input type="hidden" name="action" value="srv_toggle"><input type="hidden" name="sec" value="%s"><button class="btn %s">%s</button></form>' \
		"$(h "$_sec")" "$([ "$(uci -q get "$UCI_APP.$_sec.disabled")" = 1 ] && echo start || echo stop)" \
		"$([ "$(uci -q get "$UCI_APP.$_sec.disabled")" = 1 ] && echo 'Включить сервер' || echo 'Выключить сервер (не удалять)')"
	printf '</div>\n'
}

page_bridges() {
	# Что умеет установленная сборка xray — видно прямо тут: от этого зависит,
	# какие мосты вообще могут работать. Панель сама подстраивает конфиг под
	# бинарник, но человеку это надо понимать (и знать, что поставить).
	_cap=$(reverse_bin_support 2>/dev/null)
	_binver=$("$(xray_bin)" version 2>/dev/null | head -1)
	[ -n "$_binver" ] || _binver="не найден"
	_style=$(reverse_style 2>/dev/null)
	printf '<div class="card"><h2>'"$T_which_reverse_modes_your_bui"'</h2>'
	case "$_cap" in
		both)
			printf '<p>Установленный xray: <b>%s</b>. Он понимает <b>оба</b> способа реверса — и старый (по домену), и новый (VLESS Reverse Proxy). Значит, мосты обоих видов могут работать одновременно.</p>' "$(h "$_binver")"
			;;
		new)
			printf '<p>Установленный xray: <b>%s</b>. Он понимает <b>только новый</b> способ — VLESS Reverse Proxy по тегу. Старый реверс (<code>reverse.bridges</code>, по домену) в этой сборке удалён.</p>' "$(h "$_binver")"
			;;
		*)
			printf '<p class="bad">Установленный xray: %s — не удалось определить, какой реверс он умеет. Проверьте путь к бинарнику на странице «Настройки».</p>' "$(h "$_binver")"
			;;
	esac
	printf '<p>Общий способ для мостов, у которых выбрано «как у роутера»: <b>%s</b>.</p>' "$([ "$_style" = legacy ] && echo 'старый (по домену)' || ([ "$_style" = new ] && echo 'новый (по тегу)' || echo 'не выбран'))"
	printf '<form method="post"><input type="hidden" name="action" value="rev_style">'
	printf '<div class="row"><div><label>'"$T_change_the_common_method"'</label><select name="style">'
	printf '<option value="legacy"%s%s>'"$T_old_by_domain_needs_an_xray_"'</option>' "$([ "$_style" = legacy ] && echo ' selected')" "$([ "$_cap" != both ] && echo ' disabled')"
	printf '<option value="new"%s%s>'"$T_new_vless_reverse_proxy_by_t"'</option>' "$([ "$_style" = new ] && echo ' selected')" "$([ "$_cap" = none ] && echo ' disabled')"
	printf '</select></div></div><p><button class="btn sec">'"$T_save_mode"'</button> <span class="muted">'"$T_then_press_apply_config"'</span></p></form>'
	printf '<details class="pick"><summary>'"$T_short_which_reverse_works_wi"'</summary>'
	printf '<table><tr><th>'"$T_mode"'</th><th>'"$T_what_it_is"'</th><th>'"$T_which_xray_builds_support_it"'</th></tr>'
	printf '<tr><td>'"$T_old"'</td><td>'"$T_by_domain_code_reverse_bridg"'</td><td>'"$T_before_26_4_18_24_12_31_26_4"'</td></tr>'
	printf '<tr><td>'"$T_new"'</td><td>'"$T_vless_reverse_proxy_by_tag_c"'</td><td>'"$T_25_9_11_and_newer_26_4_25_26"'</td></tr>'
	printf '</table>'
	printf '<p class="muted">'"$T_the_panel_detects_the_capabi"'</p>'
	printf '<p class="muted">'"$T_for_the_new_method_it_is_imp"'</p>'
	printf '<p class="muted">'"$T_if_you_want_both_methods_at_"'</p>'
	printf '<p class="muted">'"$T_the_method_of_a_single_bridg"'</p>'
	printf '</details></div>'
	cat <<EOF
<div class="card"><h2>$T_reverse_bridges</h2>
<p class="muted">$T_a_bridge_is_a_reverse_tunnel</p>
<table class="responsive"><tr><th>$T_name</th><th>$T_bridge_tag</th><th>$T_mode</th><th>$T_domain</th><th>$T_outbound_server</th><th title="$T_response_time_of_the_outboun">$T_response</th><th>$T_status</th><th></th></tr>
EOF
	for _b in $(bridge_sections); do
		_bt=$(uci -q get "$UCI_APP.$_b.tag")
		_bstate=$(bridge_state "$_bt" "$(uci -q get "$UCI_APP.$_b.outbound")"); _brc=$?
		_boffmark=""
		if bridge_disabled "$_b"; then
			# выключенный мост остаётся в списке, но в конфиг не попадает
			_bstyle=' class="muted"'; _bcls='clip'
			_boffmark=' <span class="bad">выключен</span>'
			_bticon="▶"; _btcls="start"; _bttitle="включить мост"
		elif [ "$_brc" = 0 ]; then
			_bstyle=' class="row-ok"'; _bcls='clip tagmark active'
			_bticon="⏸"; _btcls="stop"; _bttitle="выключить мост (останется в списке)"
		else
			_bstyle=' class="row-bad"'; _bcls='clip tagmark bad'
			_bticon="⏸"; _btcls="stop"; _bttitle="выключить мост (останется в списке)"
		fi
		# каким способом собран этот мост — видно прямо в списке
		case "$(bridge_style "$_b" 2>/dev/null)" in
			new) _bstxt='<span class="clip ok" title="'"$T_new_method_vless_reverse_pro"'">новый</span>' ;;
			*)   _bstxt='<span class="clip" title="'"$T_old_method_portals_and_bridg"'">старый</span>' ;;
		esac
		_bdom=$(uci -q get "$UCI_APP.$_b.domain")
		_bout=$(uci -q get "$UCI_APP.$_b.outbound")
		# отклик выходного сервера — живой замер: сразу видно, живой ли канал
		# до сервера моста (для выключенного моста смысла нет)
		_bms='—'
		if ! bridge_disabled "$_b"; then
			_bos=$(tag_to_section "$_bout")
			_boa=""
			[ -n "$_bos" ] && _boa=$(uci -q get "$UCI_APP.$_bos.address")
			if [ -n "$_boa" ]; then
				_bpv=$(ping_host "$_boa" 1)
				if [ -n "$_bpv" ]; then _bms="$_bpv мс"; else _bms='<span class="bad">нет ответа</span>'; fi
			fi
		fi
		# длинные значения держим в одной строке: хвост обрезается, полный
		# текст виден при наведении мышки (title)
		printf '<tr data-bridge="%s"%s><td data-label="'"$T_name"'"><span class="clip" title="%s">%s</span>%s</td><td data-label="'"$T_bridge_tag"'"><span class="%s" title="%s">%s</span></td><td data-label="'"$T_mode"'">%s</td><td data-label="'"$T_domain"'"><span class="clip" title="%s">%s</span></td><td data-label="'"$T_outbound"'"><span class="clip" title="%s">%s</span></td><td data-label="'"$T_response"'">%s</td><td data-label="'"$T_status"'" class="muted bnote"><span class="clip" title="%s">%s</span></td><td data-label="'"$T_actions"'"><a class="btn sec" href="%s?page=bridge&sec=%s">'"$T_edit_2"'</a> ' \
			"$(h "$_bt")" "$_bstyle" "$(h "$_b")" "$(h "$_b")" "$_boffmark" \
			"$_bcls" "$(h "$_bt")" "$(h "$_bt")" "$_bstxt" \
			"$(h "$_bdom")" "$(h "$_bdom")" "$(h "$_bout")" "$(h "$_bout")" \
			"$_bms" "$(h "$_bstate")" "$(h "$_bstate")" "$SCRIPT_NAME" "$(h "$_b")"
		printf '<form method="post" style="display:inline"><input type="hidden" name="action" value="bridge_toggle"><input type="hidden" name="sec" value="%s"><button class="btn %s" title="%s">%s</button></form> <form method="post" style="display:inline"><input type="hidden" name="action" value="del_bridge"><input type="hidden" name="sec" value="%s"><button class="btn danger">'"$T_delete"'</button></form></td></tr>\n' "$(h "$_b")" "$_btcls" "$_bttitle" "$_bticon" "$(h "$_b")"
	done
	printf '</table><p class="muted">'"$T_working_bridges_are_green_de"'</p>\n<p><a class="btn sec" href="%s?page=bridge">'"$T_add_a_bridge"'</a> ' "$SCRIPT_NAME"
	apply_form bridges
	printf '</p></div>\n'
	printf '<p class="muted">'"$T_the_button_disables_a_bridge"'</p>\n'
	# диагностика: видно, что именно видит проверка
	printf '<div class="card"><h2>'"$T_check_what_the_panel_sees"'</h2><pre>'
	for _b in $(bridge_sections); do
		bridge_debug "$(uci -q get "$UCI_APP.$_b.tag")" "$(uci -q get "$UCI_APP.$_b.outbound")" | h_in
		printf '\n'
	done
	printf '</pre><p class="muted">'"$T_if_it_says_connection_table_"'</p></div>\n'
	cat <<EOF
<div class="card"><h2>$T_how_to_fill_in</h2>
<table>
<tr><th>$T_bridge_tag</th><td>$T_bridge_name_it_must_match_wh</td></tr>
<tr><th>$T_reverse_mode</th><td>$T_b_old_b_portals_and_bridges_</td></tr>
<tr><th>$T_domain</th><td>$T_the_domain_on_which_the_port</td></tr>
<tr><th>$T_outbound</th><td>$T_the_tag_of_the_server_the_ro</td></tr>
</table></div>
EOF
}

page_bridge() {
	_sec=$(param sec)
	_bt=$(uci -q get "$UCI_APP.$_sec.tag")
	_bd=$(uci -q get "$UCI_APP.$_sec.domain")
	_bo=$(uci -q get "$UCI_APP.$_sec.outbound")
	_bn=$(uci -q get "$UCI_APP.$_sec.net_outbound")
	[ -n "$_bn" ] || _bn="lan"
	printf '<div class="card"><h2>%s</h2><form method="post"><input type="hidden" name="action" value="save_bridge">' \
		"$([ -n "$_sec" ] && echo "Мост $_sec" || echo "Новый реверс-мост")"
	[ -n "$_sec" ] && printf '<input type="hidden" name="sec" value="%s">' "$(h "$_sec")"
	printf '<div class="row">'
	[ -z "$_sec" ] && printf '<div><label>'"$T_section_name_latin_letters_o"'</label><input name="sec" placeholder="lucy"></div>'
