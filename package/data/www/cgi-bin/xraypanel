		printf '</select> <button class="btn">'"$T_install_selected"'</button></form>'
		printf '<p class="muted">'"$T_checked_folders_code_s_code_"'</p></details>' "$(h "$(cfg panel_ipk_dirs "/tmp /etc/xraypanel/versions")")"
	else
		printf '<p class="muted">'"$T_no_packages_found_checked_fo"'</p>' "$(h "$(cfg panel_ipk_dirs "/tmp /etc/xraypanel/versions")")"
	fi
	printf '<form method="post" enctype="multipart/form-data" style="margin-top:8px"><input type="hidden" name="action" value="panel_upload"><label>'"$T_upload_ipk_package_from_the_"'</label><input type="file" name="ipk" accept=".ipk"><p><button>'"$T_upload"'</button></p></form>'
	printf '<form method="post" style="margin-top:8px"><label>'"$T_folders_to_look_for_packages"'</label><input name="panel_ipk_dirs" value="%s"><p><button class="btn sec">'"$T_save_folders"'</button></p></form>' "$(h "$(cfg panel_ipk_dirs "/tmp /etc/xraypanel/versions")")"
	_pip=$(cfg panel_prev_ipk "")
	if [ -n "$_pip" ] && [ -f "$_pip" ]; then
		printf '<form method="post"><input type="hidden" name="action" value="panel_install"><input type="hidden" name="file" value="%s"><button class="btn sec">вернуть прежнюю версию (%s)</button></form>' \
			"$(h "$_pip")" "$(h "$(panel_ipk_version "$_pip")")"
	fi
	_prc=$(cat "$STATE_DIR/panel-install.rc" 2>/dev/null)
	_plog=$(tail -n 12 "$STATE_DIR/panel-install.log" 2>/dev/null)
	if [ -n "$_plog" ]; then
		if [ "$_prc" = 0 ]; then
			printf '<p class="ok">Установка прошла успешно — обновите страницу (F5): панель откроется уже новой версией.</p>'
		elif [ -n "$_prc" ]; then
