# проверка одного названия: есть ли такой список в файлах роутера
act_geo_check() {
	_k=$(param kind); _n=$(param name)
	case "$_k" in geosite|geoip) ;; *) _k="geosite" ;; esac
	# убираем случайные пробелы по краям — из-за них проверка ругалась бы зря
	_n=$(printf '%s' "$_n" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
