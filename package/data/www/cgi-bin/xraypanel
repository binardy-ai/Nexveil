			restore();
			setApplyButtons(false);
			/* об ошибке не «выскакиваем»: кнопка снова красная «применить конфиг»,
			   а подробности лежат в журнале на странице «Конфиг» */
		}
	}
	function poll(n) {
		if (n > 80) { restore(); return; }
		fetch('?page=jobs&t=' + Date.now(), { cache: 'no-store' })
			.then(function (r) { return r.json(); })
			.then(function (d) {
				if (d.apply === 'running') { setTimeout(function () { poll(n + 1); }, 1500); return; }
				finish(d.apply_rc, d.apply_msg);
			})
			.catch(function () { setTimeout(function () { poll(n + 1); }, 2000); });
	}
	forms.forEach(function (f) {
		f.addEventListener('submit', function (ev) {
			ev.preventDefault();
			buttons(__t("T_applying"), true);
			say(__t("T_config_is_being_applied"));
			fetch(location.pathname + location.search, {
				method: 'POST',
				headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
				body: new URLSearchParams({ action: 'apply', ajax: '1' }),
				cache: 'no-store'
			})
				.then(function () { poll(0); })
				.catch(function () {
					restore();
				});
		});
	});
})();
/* Карточка «Обновление панели»: пока идёт проверка релиза, спрашиваем её сама —
   человеку не нужно перезагружать страницу, результат появится сам. */
(function () {
