if [ "$(param page)" = state ]; then
	page_state
	exit 0
fi

# карточка «Обновление панели» отдельным куском: страница обновляет её сама,
# пока идёт проверка релиза (без перезагрузки)
if [ "$(param page)" = update_card ]; then
	printf 'Content-Type: text/html; charset=utf-8\n'
	printf 'Cache-Control: no-store, no-cache, must-revalidate\n\n'
	printf '<div class="card" id="update-card">'
	update_card_html
	printf '</div>\n'
	exit 0
fi

# таблица серверов отдельным куском: страница «Серверы» обновляет её без
# перезагрузки (проверка узлов, обновление подписки)
if [ "$(param page)" = servers_table ]; then
	printf 'Content-Type: text/html; charset=utf-8\n\n'
	servers_table_html
	exit 0
fi

# лёгкий режим «Маршрутов»: отдать только карточку наборов. Её подменяет
# страница при переключении набора и правке записей — так не нужно каждый раз
# пересобирать всю страницу (полная сборка занимает 5–6 секунд)
if [ "$(param page)" = rules ] && [ "$(param part)" = sets ]; then
	printf 'Content-Type: text/html; charset=utf-8\n'
	printf 'Cache-Control: no-store, no-cache, must-revalidate\n\n'
	_ract=$(rules_activity 2>/dev/null)
	sets_card_html
	exit 0
fi

# содержимое блока «Готовые списки» — страница просит его только когда блок
# открыли, поэтому при обычной загрузке «Маршрутов» эта работа не делается
if [ "$(param page)" = geo ]; then
	printf 'Content-Type: text/html; charset=utf-8\n'
	printf 'Cache-Control: no-store, no-cache, must-revalidate\n\n'
	geo_body_html
	exit 0
fi

# состояние фоновых заданий — по нему страницы понимают, когда закончилась
# проверка узлов или сбор названий списков
if [ "$(param page)" = jobs ]; then
	printf 'Content-Type: application/json; charset=utf-8\n\n'
	# итог применения конфига (0 — применился, 1 — вернули прежний)
	_arc=""
	[ -f "$STATE_DIR/apply.rc" ] && _arc=$(cat "$STATE_DIR/apply.rc" 2>/dev/null | tr -cd '0-9')
	_amsg=$(tail -n 1 "$STATE_DIR/apply.log" 2>/dev/null)
	printf '{"urltest":"%s","geo":"%s","geo_upd":"%s","apply":"%s","apply_rc":"%s","apply_msg":"%s","lookup":"%s"}' \
		"$(job_state urltest)" "$(job_state geo-tags)" "$(job_state geo-update)" "$(job_state apply)" "$_arc" "$(jesc "$_amsg")" "$(job_state lookup)"
	exit 0
fi

page_header
case "$(param page)" in
	servers)  page_servers ;;
	server)   page_server ;;
	bridges)  page_bridges ;;
	bridge)   page_bridge ;;
	transparent) page_transparent ;;
	rules)    page_rules ;;
	rule)     page_rule ;;
	config)   page_config ;;
	settings) page_settings ;;
	backup)   page_backup ;;
	*)        page_status ;;
esac
page_footer
rm -f "$PARAMS" 2>/dev/null
