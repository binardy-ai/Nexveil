		_res="сначала впишите название списка"
	elif [ -z "$(geo_files "$_k")" ]; then
		_res="файлов со списками на роутере нет — поставьте пакеты кнопкой выше"
	elif ! geo_cache_ready; then
		# без собранного списка названий честно проверить нельзя: поиск по
		# файлу подстрокой находил бы «есть» почти для любой ерунды
		_res="названия списков ещё не собраны — нажмите «собрать названия списков» и повторите проверку"
	elif geo_tag_exists "$_k" "$_n"; then
		_res="есть"
	else
		_sim=$(geo_tag_similar "$_k" "$_n")
		if [ -n "$_sim" ]; then
			_res="есть (в файле записано как «$_sim» — это тот же список)"
		else
			# точного названия нет — показываем, какие есть похожие, чтобы
			# было видно, что писать вместо введённого
			_like=$(geo_tag_search "$_k" "$_n" 8 | tr '\n' ' ' | sed -e 's/[[:space:]]*$//')
			if [ -n "$_like" ]; then
				_res="нет такого списка. Похожие названия: $_like"
			else
				_res="нет такого списка в файлах роутера"
			fi
		fi
	fi
	if [ "$(param ajax)" = 1 ]; then
		printf 'Content-Type: text/plain; charset=utf-8\n\n%s' "$_res"
		exit 0
	fi
	redirect rules "список $_k:$_n — $_res"
}

act_ping_one() { # замерить пинг одного сервера — ответом, без перезагрузки страницы
	_t=$(param tag)
	_sec=$(tag_to_section "$_t")
	[ -n "$_sec" ] || { printf 'Content-Type: text/plain; charset=utf-8\n\nнет такого сервера'; exit 0; }
	_addr=$(uci -q get "$UCI_APP.$_sec.address" 2>/dev/null)
	_p=$(ping_host "$_addr")
	if [ -n "$_p" ]; then _out="${_p} мс"; else _out="нет ответа"; fi
	if [ "$(param ajax)" = 1 ]; then
		printf 'Content-Type: text/plain; charset=utf-8\n\n%s' "$_out"
		exit 0
	fi
	redirect servers "пинг $_t: $_out"
}

act_urltest() { # проверить один сервер: качаем тестовую страницу через него
	_t=$(param tag)
	[ -n "$_t" ] || redirect servers "не выбран сервер для проверки"
	# без подстановки команды: тогда причина отказа (URLTEST_REASON) остаётся
	# видна и её можно сохранить вместе с результатом
	_otf="$STATE_DIR/urltest.out.$$"
	url_test_server "$_t" > "$_otf" 2>/dev/null
	_r=$(cat "$_otf" 2>/dev/null); rm -f "$_otf" 2>/dev/null
	url_test_save "$_t" "$_r" "$URLTEST_REASON"
	# тихая проверка со страницы: отдаём только результат, без перехода
	if [ "$(param ajax)" = 1 ]; then
		printf 'Content-Type: text/plain; charset=utf-8\n\n%s' "$_r"
		exit 0
	fi
	redirect servers "проверка «$_t»: $_r"
}

act_urltest_all() { # проверить все серверы — в фоне, это долго
	# со страницы «Серверы» это тихий запуск: страница не перезагружается,
	# она сама спрашивает результаты и обновляет строки таблицы
	if [ "$(param ajax)" = 1 ]; then
		printf 'Content-Type: text/plain; charset=utf-8\n\nзапущено'
		bg_run ". '$LIB' >/dev/null 2>&1; touch '$STATE_DIR/urltest.running'; url_test_all; rm -f '$STATE_DIR/urltest.running'" "$STATE_DIR/urltest.log"
		exit 0
	fi
	respond_now servers "проверяю все серверы в фоне — через полминуты обновите страницу, результаты появятся в таблице."
	bg_run ". '$LIB' >/dev/null 2>&1; touch '$STATE_DIR/urltest.running'; url_test_all; rm -f '$STATE_DIR/urltest.running'" "$STATE_DIR/urltest.log"
	exit 0
}

act_best_ping() {
	_best=""; _best_ms=""; _report=""
	for _s in $(server_sections); do
		_tag=$(server_tag "$_s")
		# выключенные серверы в замер не берём — их в конфиге всё равно нет
		if server_disabled "$_s"; then
			_report="$_report$_tag: пропущен (выключен); "
			continue
		fi
		# серверы реверса в замер не берём — через них выход не работает
		if server_is_reverse "$_tag"; then
			_report="$_report$_tag: пропущен (занят реверсом); "
			continue
		fi
		_addr=$(uci -q get "$UCI_APP.$_s.address")
		[ -n "$_addr" ] || continue
		_p=$(ping_host "$_addr")
		if [ -z "$_p" ]; then
			_report="$_report$_tag: нет ответа; "
			continue
		fi
		_report="$_report$_tag: $_p мс; "
		if [ -z "$_best_ms" ] || awk -v a="$_p" -v b="$_best_ms" 'BEGIN{exit !(a<b)}'; then
			_best="$_tag"; _best_ms="$_p"
		fi
	done
	if [ -z "$_best" ]; then
		redirect "" "пинг не ответил ни у одного сервера — ничего не меняю. $_report"
	fi
	ui_uci set "$UCI_APP.settings.default_outbound=$_best"
	uci commit "$UCI_APP" >/dev/null 2>&1
	respond_now "" "самый быстрый — $_best ($_best_ms мс). Все замеры: $_report. Конфиг применяется, обновите страницу через пару секунд."
	bg_apply
	exit 0
}

ACTION=$(param action)
case "$ACTION" in
	save_server) act_save_server ;;
	del_server)  act_del_server ;;
	srv_toggle)  act_srv_toggle ;;
	save_bridge) act_save_bridge ;;
	del_bridge)  act_del_bridge ;;
	bridge_toggle) act_bridge_toggle ;;
	rev_style)   act_rev_style ;;
	update_check)   act_update_check ;;
	update_install) act_update_install ;;
	confdir_clean) _n=$(config_extra_clean); pending_note "убраны лишние .json из каталога конфига (файлов: $_n)"; redirect "" "лишние файлы убраны (переименованы в .bak): $_n. Осталось нажать «Применить конфиг»." ;;
	save_rule)   act_save_rule ;;
	rule_move)   act_rule_move ;;
	rule_toggle) act_rule_toggle ;;
	del_rule)    act_del_rule ;;
	set_new)     act_set_new ;;
	set_pick)    act_set_pick ;;
	rule_reorder) act_rule_reorder ;;
	save_rules_all) act_save_rules_all ;;
	set_del)     act_set_del ;;
	set_rename)  act_set_rename ;;
	set_toggle)  act_set_toggle ;;
	item_add)    act_item_add ;;
	item_save_all) act_item_save_all ;;
	item_del)    act_item_del ;;
	item_toggle) act_item_toggle ;;
	import_link) act_import_link ;;
	set_default) act_set_default ;;
	enable_service) act_enable_service ;;
	fix_tz)      act_fix_tz ;;
	trans_on)    act_trans_on ;;
	trans_keep)  act_trans_keep ;;
	trans_off)   act_trans_off ;;
	export)      act_export ;;
	import)      act_import ;;
	urltest)     act_urltest ;;
	ping_one)    act_ping_one ;;
	urltest_all) act_urltest_all ;;
	sub_save)    act_sub_save ;;
	dedup)       act_dedup ;;
	traffic_reset) act_traffic_reset ;;
	traffic_reset_one) act_traffic_reset_one ;;
	panel_install) act_panel_install ;;
	panel_upload)  act_panel_upload ;;
	panel_dirs)    act_panel_dirs ;;
	dnslog_on)   act_dnslog_on ;;
	dnslog_off)  act_dnslog_off ;;
	dnslog_repair) act_dnslog_repair ;;
	sub_update)  act_sub_update ;;
	sub_del)     act_sub_del ;;
	geo_build)   act_geo_build ;;
	geo_check)   act_geo_check ;;
	geo_pkg)     act_geo_pkg ;;
	geo_items)   act_geo_items ;;
	geo_auto)    act_geo_auto ;;
	rule_find)   act_rule_find ;;
	list_show)   act_list_show ;;
	geo_update)  act_geo_update ;;
	dns_check)   act_dnscheck ;;
	best_ping)   act_best_ping ;;
	apply)       pending_clear
		# тихий запуск со страницы: отвечаем сразу, страница сама ждёт итог
		# и обновляет надписи — перезагрузка не нужна
		if [ "$(param ajax)" = 1 ]; then
			mkdir -p "$STATE_DIR" 2>/dev/null
			: > "$STATE_DIR/apply.running"
			printf 'Content-Type: text/plain; charset=utf-8\n\nstarted'
			bg_apply
			exit 0
		fi
		respond_now "$(param back)" "конфиг применяется — через пару секунд обновите страницу"; bg_apply; exit 0 ;;
	rollback)    respond_now "" "восстанавливаю прошлый конфиг — обновите страницу через пару секунд"; bg_rollback; exit 0 ;;
	restart)     respond_now "" "xray перезапускается — обновите страницу через пару секунд"; svc_restart_async; exit 0 ;;
	settings)    for _f in socks_port api_port password log_dir url_test_url; do
			# если меняется то, что попадает в конфиг xray — отмечаем это
			case "$_f" in
				socks_port|api_port|log_dir)
					_old=$(uci -q get "$UCI_APP.settings.$_f" 2>/dev/null)
					[ "$_old" != "$(param "$_f")" ] && pending_note "изменены настройки панели ($_f)"
					;;
			esac
			_v=$(param "$_f")
			case "$_f" in
				socks_port|api_port)
					if [ -n "$_v" ] && ! valid_port "$_v"; then
						redirect settings "порт $_f должен быть числом от 1 до 65535 — значение не сохранено"
					fi
					;;
			esac
			if [ -n "$_v" ] || [ "$_f" = "password" ]; then ui_uci set "$UCI_APP.settings.$_f=$_v"; fi
		done
		# порт проверки и период: мусор не принимаем
		_v=$(param url_test_port)
		if valid_port "$_v"; then ui_uci set "$UCI_APP.settings.url_test_port=$_v"; fi
		_v=$(param url_test_interval)
		case "$_v" in
			0|5|15|30|60)
				if [ "$_v" = 0 ]; then ui_uci delete "$UCI_APP.settings.url_test_interval"
				else ui_uci set "$UCI_APP.settings.url_test_interval=$_v"; fi
				uci commit "$UCI_APP" >/dev/null 2>&1
				cron_set_urltest "$_v"
				;;
		esac
		_v=$(param sub_interval)
		case "$_v" in
			0|6|12|24)
				if [ "$_v" = 0 ]; then ui_uci delete "$UCI_APP.settings.sub_interval"
				else ui_uci set "$UCI_APP.settings.sub_interval=$_v"; fi
				uci commit "$UCI_APP" >/dev/null 2>&1
				cron_set_subs "$_v"
				;;
		esac
		# лампочки правил: галочка не отправляется, когда снята — поэтому
		# сохраняем и ноль (иначе «выключено» вернулось бы к «включено»)
		if [ "$(param lamp_filter)" = 1 ]; then
			ui_uci set "$UCI_APP.settings.lamp_filter=1"
		else
			ui_uci set "$UCI_APP.settings.lamp_filter=0"
		fi
		if [ "$(param set_highlight)" = 1 ]; then
			ui_uci set "$UCI_APP.settings.set_highlight=1"
		else
			ui_uci set "$UCI_APP.settings.set_highlight=0"
		fi
		# звук кнопок: без файлов, звук синтезирует сам браузер. Принимаем только
		# известные значения — иначе опечатка в адресе сломала бы отклик кнопок
		_v=$(param sound)
		case " off click tick blip two " in
			*" $_v "*) ui_uci set "$UCI_APP.settings.sound=$_v" ;;
		esac
		_v=$(param volume)
		case " low mid high " in
			*" $_v "*) ui_uci set "$UCI_APP.settings.volume=$_v" ;;
		esac
		# автовыбор по пингу теперь живёт только на странице «Прокси»,
		# поэтому здесь его не трогаем — иначе сохранение настроек выключало бы
		# режим, выбранный там
		# автообновление готовых списков живёт в блоке «Готовые списки» на
		# «Маршрутах»: здесь только приводим задание в cron в порядок
		cron_set_geo "$(cfg geo_auto 0)" "$(cfg geo_auto_src loyalsoldier)"
		# самообновление панели: репозиторий, необязательный токен и расписание
		_v=$(param update_repo | tr -cd 'A-Za-z0-9._/-')
		[ -n "$_v" ] && ui_uci set "$UCI_APP.settings.update_repo=$_v"
		_v=$(param update_token | tr -cd 'A-Za-z0-9._-')
		if [ -n "$_v" ]; then ui_uci set "$UCI_APP.settings.update_token=$_v"
		else ui_uci delete "$UCI_APP.settings.update_token" 2>/dev/null; fi
		if [ "$(param update_auto)" = 0 ]; then
			ui_uci set "$UCI_APP.settings.update_auto=0"
			cron_set_update 0
		else
			ui_uci set "$UCI_APP.settings.update_auto=1"
			cron_set_update 1
		fi
		_pu=$(param probe_url)
		[ -n "$_pu" ] && ui_uci set "$UCI_APP.settings.probe_url=$_pu"
		# оформление: принимаем только известные темы
		_v=$(param theme)
		case " ${THEME_LIST:-classic} " in
			*" $_v "*) ui_uci set "$UCI_APP.settings.theme=$_v" ;;
		esac
		# язык панели: авто (по языку браузера), русский или English
		_v=$(param lang)
		case "$_v" in
			auto|ru|en) ui_uci set "$UCI_APP.settings.lang=$_v" ;;
		esac
		uci commit "$UCI_APP" >/dev/null 2>&1
		redirect "" "настройки сохранены" ;;
esac

