# --- общие куски для формы правила ------------------------------------------
# дата изменения файла (busybox date -r умеет, но подстрахуемся через ls)
file_date() {
	_d=$(date -r "$1" '+%d.%m.%Y %H:%M' 2>/dev/null)
	[ -n "$_d" ] || _d=$(ls -l "$1" 2>/dev/null | awk '{ print $6 " " $7 " " $8 }')
	printf '%s' "$_d"
}

# тип значения: панель сама подставит нужный префикс
rule_type_select() { # $1 = выбранный тип, $2 = имя поля, $3 = id (для списка записей)
	_nm=${2:-type}
	_id=${3:-rule-type}
	printf '<select name="%s" id="%s">' "$_nm" "$_id"
	for _pair in \
		"ip|IP-адрес или сеть — 10.0.0.0/8, 8.8.8.8" \
		"domain|Домен и все поддомены — youtube.com" \
		"full|Только ровно этот домен — youtube.com" \
		"keyword|Слово в имени — google" \
		"regexp|Шаблон — .*\\.ru\$" \
		"geosite|Готовый список доменов (из файла роутера)" \
		"geoip|Готовый список адресов (из файла роутера)"
	do
		_k=${_pair%%|*}; _v=${_pair#*|}
		printf '<option value="%s"%s>%s</option>' "$_k" "$([ "$1" = "$_k" ] && echo ' selected')" "$_v"
	done
	printf '</select>'
}

# названия готовых списков: подсказка для поля значения
geo_datalist() {
	_c=$(geo_tags_cache)
	[ -s "$_c" ] || return 0
	printf '<datalist id="geo-names">'
	# одним awk: раньше на каждое название запускался отдельный sed, и на 1800
	# названиях сборка страницы «Маршруты» растягивалась на несколько секунд
	awk -F'\t' 'NF >= 2 && $2 != "" && !seen[$2]++ {
		s = $2
		gsub(/&/, "\\&amp;", s); gsub(/</, "\\&lt;", s); gsub(/>/, "\\&gt;", s); gsub(/"/, "\\&quot;", s)
		print "<option value=\"" s "\"></option>"
	}' "$_c" 2>/dev/null
	printf '</datalist>'
}

# устройство: подключённые сейчас + вся локальная сеть (руками вводить не надо)
rule_category_select() { # $1 = текущая категория (direct|proxy|block)
