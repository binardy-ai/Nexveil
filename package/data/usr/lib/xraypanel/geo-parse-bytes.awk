# Запасной разбор списков: на вход идут байты файла числами (их готовит od
# или hexdump). Используется, только если прямой разбор ничего не нашёл.
#
# Ищем последовательность 10, <varint: длина записи>, 10, <длина названия>,
# <название>, 18 — это «поле 1 записи» (название списка), сразу за которым
# идёт «поле 2» (домены или сети).

BEGIN { st = 0; cnt = 0; tag = "" }

{
	for (i = 1; i <= NF; i++) {
		b = $i + 0
		if (st == 0) {
			if (b == 10) st = 1
		} else if (st == 1) {
			if (b < 128) st = 2
		} else if (st == 2) {
			st = (b == 10) ? 3 : 0
		} else if (st == 3) {
			if (b >= 1 && b <= 48) { cnt = b; tag = ""; st = 4 } else st = 0
		} else if (st == 4) {
			if (b < 32 || b > 126) {
				st = 0
			} else {
				tag = tag sprintf("%c", b)
				if (length(tag) >= cnt) st = 5
			}
		} else if (st == 5) {
			if (b == 18) print tag
			st = 0
		}
	}
}
