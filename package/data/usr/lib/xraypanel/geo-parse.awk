# Разбор файлов со списками geoip.dat / geosite.dat (формат protobuf).
# Файл читается напрямую, память при этом не растёт: держим только текущую
# запись и предыдущую. Раньше файл прогонялся через od — на роутере это
# съедало всю память на больших файлах (geoip.dat).
#
# Устройство файла: повторяется запись, а в ней
#   поле 1 (0x0A) — название списка, сразу за ним
#   поле 2 (0x12) — сами данные (домены или сети).
# Значит, название — это то, что стоит между двумя байтами 0x0A:
#   0x0A <varint: длина записи> 0x0A <длина названия> <название> 0x12 …
#
# Читаем файл по «строкам» (разделитель — байт 0x0A, а это и есть 0x0A):
#   * обычная запись начинается с байта длины названия;
#   * если длина названия равна 10, её байт тоже равен 0x0A — тогда запись
#     начинается прямо с названия. Такой случай отличается по предыдущей
#     записи: у настоящего названия перед ним стоит только длина записи.

BEGIN {
	RS = "\n"
	for (_i = 0; _i < 256; _i++) M[sprintf("%c", _i)] = _i
	prev = ""
	prev2 = ""
}

function is_short_varint(s,   k, i) {
	k = length(s)
	if (k < 1 || k > 3) return 0
	for (i = 1; i < k; i++) if (M[substr(s, i, 1)] < 128) return 0
	return 1
}

{
	rec = $0
	n = length(rec)
	found = 0

	# 1) обычный случай: запись начинается с байта длины названия
	if (n >= 3) {
		b = M[substr(rec, 1, 1)]
		if (b >= 1 && b <= 48 && n >= b + 2) {
			t = substr(rec, 2, b)
			if (M[substr(rec, b + 2, 1)] == 18 && t ~ /^[ -~]+$/) {
				print t
				found = 1
			}
		}
	}

	# 2) название длиной ровно 10 символов: его байт длины совпал с
	#    разделителем, поэтому запись начинается прямо с названия, а запись
	#    перед ней пустая (два разделителя подряд)
	if (!found && n >= 11 && (is_short_varint(prev) || (length(prev) == 0 && is_short_varint(prev2)))) {
		t = substr(rec, 1, 10)
		if (M[substr(rec, 11, 1)] == 18 && t ~ /^[ -~]+$/) print t
	}

	prev2 = prev
	prev = rec
}
