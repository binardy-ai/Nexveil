#!/bin/sh
# Списки адресов для правил по доменам — тот же приём, что в PassWall:
# dnsmasq при разборе имени сам складывает полученные адреса в nft-набор,
# свой для каждого правила панели. По этим наборам панель видит, какое правило
# поймало трафик, даже когда в журнале xray стоит адрес, а не имя сайта.
#
# Наборы живут в памяти, как и все правила nft: создаются заново при загрузке
# роутера и при каждом применении конфига.
#
# Запуск:  rule-sets.sh sync | off | show | check
#
# Важно про порядок работы: сначала панель делает наборы для простых правил
# (domain:, full:) — это мгновенно, и они начинают работать сразу. Готовые
# списки (geosite:) считаются отдельно и позже: разбор большого списка на
# роутере занимает время, и раньше из-за него не успевали появиться вообще все
# наборы (доменные правила оставались без адресов).
#
# Если в сборке нет nft или dnsmasq собран без поддержки nftset — ничего не
# делаем, панель просто работает как раньше (лампочки по доменам не горят).

LIB="${XRAYPANEL_LIB:-/usr/lib/xraypanel/lib.sh}"
[ -f "$LIB" ] && . "$LIB"
STATE="${XRAYPANEL_STATE:-/etc/xraypanel}"
TABLE="${RULE_SETS_TABLE:-xraypanel_dom}"
FAMILY="${RULE_SETS_FAMILY:-inet}"
LOG="$STATE/rule-sets.log"
STATUS="$STATE/rule-sets.status"
RUN="$STATE/rule-sets.running"
CONF_NAME="xraypanel-rules.conf"
# сколько имён из готового списка берём для одного правила (защита от
# гигантских категорий: файл с настройками dnsmasq не должен пухнуть)
MAX_DOMAINS="${XRAYPANEL_SETS_MAX:-2000}"
# по сколько имён в одной строке nftset: у dnsmasq есть предел длины строки
PER_LINE=40
# сколько секунд держим разобранный готовый список (файлы со списками меняются
# редко, а разбор на роутере небыстрый)
GEO_TTL=604800

mkdir -p "$STATE" 2>/dev/null

log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOG" 2>/dev/null; }

have_nft() { command -v nft >/dev/null 2>&1; }

# куда dnsmasq складывает свои дополнительные файлы настроек
conf_dir() {
	_d=$(uci -q get dhcp.@dnsmasq[0].confdir 2>/dev/null)
	_d=${_d%%,*}
	_d=$(printf '%s' "$_d" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
	[ -n "$_d" ] || _d=/tmp/dnsmasq.d
	printf '%s' "$_d"
}

dnsmasq_has_nftset() {
	command -v dnsmasq >/dev/null 2>&1 || return 1
	dnsmasq --version 2>/dev/null | grep -q 'nftset'
}

reload_dnsmasq() {
	[ -x /etc/init.d/dnsmasq ] || return 0
	/etc/init.d/dnsmasq reload >/dev/null 2>&1 && return 0
	/etc/init.d/dnsmasq restart >/dev/null 2>&1
}

# --- готовые списки ---------------------------------------------------------
# отпечаток файлов со списками: если он не менялся, разобранный список берём
# из кэша и не считаем заново
geo_sig() {
	for _pair in $(geo_files geosite 2>/dev/null | tr '\t' ':'); do
		_f=${_pair%%:*}
		[ -f "$_f" ] || continue
		printf '%s:%s:%s;' "$_f" "$(wc -c <"$_f" 2>/dev/null | tr -d ' ')" "$(date -r "$_f" +%s 2>/dev/null)"
	done
}

geo_domains_cached() { # $1 = название готового списка
	_c="$STATE/geosite.$1.domains"
	_s="$STATE/geosite.$1.sig"
	_cur=$(geo_sig)
	if [ -s "$_c" ] && [ -n "$_cur" ] && [ "$(cat "$_s" 2>/dev/null)" = "$_cur" ]; then
		cat "$_c"
		return 0
	fi
	type geo_list_domains >/dev/null 2>&1 || return 0
	# разбор большого списка на роутере — дело небыстрое: ограничиваем его по
	# времени, чтобы один тяжёлый список не задерживал всю сборку
	if command -v timeout >/dev/null 2>&1; then
		_d=$(timeout 120 geo_list_domains "$1" "$MAX_DOMAINS" 2>/dev/null | sed -e '/^#/d' | cut -f1)
	else
		_d=$(geo_list_domains "$1" "$MAX_DOMAINS" 2>/dev/null | sed -e '/^#/d' | cut -f1)
	fi
	if [ -z "$_d" ]; then
		log "готовый список $1 не разобрался за отведённое время — его адреса не собираем"
		return 0
	fi
	[ -n "$_d" ] || return 0
	printf '%s\n' "$_d" >"$_c" 2>/dev/null
	printf '%s' "$_cur" >"$_s" 2>/dev/null
	printf '%s\n' "$_d"
}

# имена (домены) правила. $2: cheap — только domain:/full: (считается мгновенно),
# geo — только готовые списки (geosite:), их разбор идёт отдельно.
# keyword: и regexp: сюда не попадают: dnsmasq понимает только «домен и все
# поддомены», шаблоны он не разбирает.
rule_domains() { # $1 = раздел правила, $2 = cheap|geo
	_parts=$(rule_parts "$1" 2>/dev/null)
	_t=$(printf '%s' "$_parts" | cut -f2)
	_v=$(printf '%s' "$_parts" | cut -f3)
	[ -n "$_v" ] || return 0
	case "$_t" in
		domain|full)
			[ "$2" = geo ] && return 0
			printf '%s\n' "$_v" | tr ',' '\n' | while IFS= read -r _d; do
				_d=$(printf '%s' "$_d" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
				[ -n "$_d" ] || continue
				case "$_d" in *[!A-Za-z0-9._-]*) continue ;; esac
				printf '%s\n' "$_d"
			done
			;;
		geosite)
			[ "$2" = cheap ] && return 0
			geo_domains_cached "$_v" | while IFS= read -r _d || [ -n "$_d" ]; do
				[ -n "$_d" ] || continue
				case "$_d" in *[!A-Za-z0-9._-]*) continue ;; esac
				printf '%s\n' "$_d"
			done
			;;
	esac
}

# тело файла настроек dnsmasq по парам «имя<TAB>набор».
#
# Важно: если одно имя нужно нескольким правилам, наборы надо перечислить в
# ОДНОЙ строке nftset= через запятую. Если написать их отдельными строками,
# dnsmasq положит адрес только в один набор — остальные правила останутся без
# адресов (и лампочки у них не загорятся).
build_body() {
	: > "$_body" 2>/dev/null
	[ -s "$_pairs" ] || return 0
	LC_ALL=C sort -u "$_pairs" 2>/dev/null | LC_ALL=C awk -F'\t' -v fam="$FAMILY" -v tbl="$TABLE" '
		function flush() { if (d != "" && s != "") print s "\t" d }
		{
			if ($1 != d) { flush(); d = $1; delete seen; s = "" }
			if (!($2 in seen)) { seen[$2] = 1; s = s (s ? "," : "") "4#" fam "#" tbl "#" $2 }
		}
		END { flush() }
	' | LC_ALL=C sort | LC_ALL=C awk -F'\t' -v per="$PER_LINE" '
		function flush() { if (cur != "" && n > 0) printf "nftset=%s/%s\n", doms, cur; doms = ""; n = 0 }
		{
			if ($1 != cur) { flush(); cur = $1 }
			doms = doms "/" $2
			n++
			if (n >= per) flush()
		}
		END { flush() }
	' >"$_body" 2>/dev/null
}

# наборы в nft + файл настроек dnsmasq по тому, что уже собрано в $_body/$_want
apply_sets() {
	[ -n "$_want" ] || return 0
	nft list table "$FAMILY" "$TABLE" >/dev/null 2>&1 || \
		nft add table "$FAMILY" "$TABLE" >/dev/null 2>&1 || { log "не удалось создать таблицу nft $TABLE"; return 1; }
	for _e in $(nft list table "$FAMILY" "$TABLE" 2>/dev/null | sed -n 's/^[[:space:]]*set \([^ ]*\) {.*/\1/p'); do
		case " $_want " in *" $_e "*) continue ;; esac
		nft delete set "$FAMILY" "$TABLE" "$_e" >/dev/null 2>&1
	done
	for _s in $_want; do
		nft list set "$FAMILY" "$TABLE" "$_s" >/dev/null 2>&1 && continue
		nft add set "$FAMILY" "$TABLE" "$_s" '{ type ipv4_addr; flags interval; }' >/dev/null 2>&1 ||
			log "не удалось создать набор $_s"
	done

	_cd=$(conf_dir)
	mkdir -p "$_cd" 2>/dev/null
	# Без поддержки nftset в dnsmasq файл писать нельзя: неизвестная строка в
	# настройках — и dnsmasq не поднимется, а это DNS всего роутера.
	if ! dnsmasq_has_nftset; then
		rm -f "$_cd/$CONF_NAME" 2>/dev/null
		log "dnsmasq без поддержки nftset — файл со списками не пишу"
		return 0
	fi
	# было ли dnsmasq запущено до правки: если после перечитывания настроек он
	# не поднялся, значит виноват наш файл — убираем его и поднимаем снова
	_wasup=0
	pgrep -x dnsmasq >/dev/null 2>&1 && _wasup=1
	_new="$STATE/$CONF_NAME.new"
	{
		printf '# Списки адресов для правил панели xraypanel — файл создаётся автоматически,\n'
		printf '# правки вручную затрутся при следующем применении конфига.\n'
		printf '# dnsmasq складывает сюда адреса разобранных имён, чтобы панель видела,\n'
		printf '# какое правило поймало трафик (тот же приём, что в PassWall).\n'
		[ -s "$_body" ] && cat "$_body"
	} >"$_new" 2>/dev/null
	if [ ! -f "$_cd/$CONF_NAME" ] || ! cmp -s "$_new" "$_cd/$CONF_NAME"; then
		if cp -f "$_new" "$_cd/$CONF_NAME" 2>/dev/null; then
			reload_dnsmasq
			_reloaded=1
			if [ "$_wasup" = 1 ] && ! pgrep -x dnsmasq >/dev/null 2>&1; then
				rm -f "$_cd/$CONF_NAME" 2>/dev/null
				reload_dnsmasq
				log "dnsmasq не поднялся с нашим файлом — файл убран, dnsmasq перезапущен"
				return 1
			fi
		else
			log "не удалось записать $_cd/$CONF_NAME"
		fi
	fi
	rm -f "$_new" 2>/dev/null
	return 0
}

do_sync() {
	have_nft || { log "nft не найден — списки адресов не ведутся"; return 0; }
	# если сбор уже идёт — второй раз не запускаем: разбор списков тяжёлый, а
	# страницы могут просить его по нескольку раз
	if [ -f "$RUN" ]; then
		_old=$(cat "$RUN" 2>/dev/null); case "$_old" in ''|*[!0-9]*) _old=0 ;; esac
		_now=$(date +%s 2>/dev/null); case "$_now" in ''|*[!0-9]*) _now=0 ;; esac
		if [ "$_now" -gt 0 ] && [ $((_now - _old)) -lt 900 ]; then
			log "сбор уже идёт — выхожу"
			return 0
		fi
	fi
	date +%s >"$RUN" 2>/dev/null
	trap 'rm -f "$RUN" 2>/dev/null' EXIT INT TERM

	_body="$STATE/rule-sets.body"
	_list="$STATE/rule-sets.list"
	_pairs="$STATE/rule-sets.doms"
	_want=""
	_nsets=0
	_reloaded=0
	: >"$_body"
	: >"$_list"
	: >"$_pairs"

	# Два прохода: сначала простые правила (domain:/full:) — они дают наборы
	# сразу; затем готовые списки (geosite:), разбор которых занимает время.
	for _kind in cheap geo; do
		for _r in $(rule_sections 2>/dev/null); do
			rule_disabled "$_r" && continue
			_sn=$(rule_set_name "$_r")
			case " $_want " in *" $_sn "*) continue ;; esac
			_doms=$(rule_domains "$_r" "$_kind")
			[ -n "$_doms" ] || continue
			_want="$_want $_sn"
			_nsets=$((_nsets + 1))
			printf '%s\t%s\n' "$_r" "$_sn" >>"$_list"
			printf '%s\n' "$_doms" | while IFS= read -r _d || [ -n "$_d" ]; do
				[ -n "$_d" ] && printf '%s\t%s\n' "$_d" "$_sn" >>"$_pairs"
			done
		done
		build_body
		# после простых правил наборы уже рабочие, готовые списки добавляются
		# к ним позже этим же вызовом
		[ -n "$_want" ] && apply_sets
	done

	# правил по доменам нет — наборы и файл настроек не нужны
	if [ -z "$_want" ]; then
		_cd=$(conf_dir)
		_had=0
		[ -f "$_cd/$CONF_NAME" ] && _had=1
		rm -f "$_cd/$CONF_NAME" 2>/dev/null
		nft list table "$FAMILY" "$TABLE" >/dev/null 2>&1 && nft delete table "$FAMILY" "$TABLE" >/dev/null 2>&1
		[ "$_had" = 1 ] && reload_dnsmasq
		printf '%s\n' "$(date '+%H:%M:%S') правил по доменам нет — списки адресов убраны" >"$STATUS" 2>/dev/null
		log "правил по доменам нет — списки адресов убраны"
		return 0
	fi

	_addr=$(do_show 2>/dev/null | awk -F'\t' '{ s += $3 + 0 } END { print s + 0 }')
	printf '%s\n' "$(date '+%H:%M:%S') наборов: $_nsets, адресов собрано: $_addr, dnsmasq перечитал настройки: $_reloaded" >"$STATUS" 2>/dev/null
	log "наборов: $_nsets, адресов: $_addr, строк в файле: $(wc -l <"$_body" 2>/dev/null | tr -d ' '), dnsmasq перечитал настройки: $_reloaded"
	rm -f "$RUN" 2>/dev/null
	return 0
}

do_off() {
	if have_nft && nft list table "$FAMILY" "$TABLE" >/dev/null 2>&1; then
		nft delete table "$FAMILY" "$TABLE" >/dev/null 2>&1
	fi
	_cd=$(conf_dir)
	rm -f "$_cd/$CONF_NAME" 2>/dev/null
	rm -f "$STATE/rule-sets.list" "$STATE/rule-sets.body" "$STATUS" 2>/dev/null
	reload_dnsmasq
	log "списки адресов убраны"
	return 0
}

do_show() {
	[ -s "$STATE/rule-sets.list" ] || return 0
	while IFS="$(printf '\t')" read -r _r _sn; do
		[ -n "$_sn" ] || continue
		_c=$(nft list set "$FAMILY" "$TABLE" "$_sn" 2>/dev/null | awk '
			index($0, "elements = {") { s = $0; sub(/.*elements = \{/, "", s); sub(/\}.*$/, "", s)
				n = split(s, p, ","); c = 0
				for (i = 1; i <= n; i++) { gsub(/[ \t]/, "", p[i]); if (p[i] != "") c++ }
				print c; exit }
		')
		printf '%s\t%s\t%s\n' "$_r" "$_sn" "${_c:-0}"
	done <"$STATE/rule-sets.list"
}

do_check() {
	printf 'nft: %s\n' "$(have_nft && echo есть || echo нет)"
	if command -v dnsmasq >/dev/null 2>&1; then
		printf 'dnsmasq: %s, поддержка nftset: %s\n' "$(command -v dnsmasq)" "$(dnsmasq_has_nftset && echo есть || echo НЕТ)"
	else
		printf 'dnsmasq: не найден в PATH (%s)\n' "$PATH"
	fi
	_cd=$(conf_dir)
	printf 'каталог настроек dnsmasq: %s (%s)\n' "$_cd" "$([ -d "$_cd" ] && echo есть || echo НЕТ)"
	if [ -f "$_cd/$CONF_NAME" ]; then
		printf 'файл списков: есть, %s байт, строк nftset: %s\n' \
			"$(wc -c <"$_cd/$CONF_NAME" 2>/dev/null | tr -d ' ')" "$(grep -c '^nftset=' "$_cd/$CONF_NAME" 2>/dev/null)"
	else
		printf 'файл списков: НЕТ (%s)\n' "$_cd/$CONF_NAME"
	fi
	if have_nft && nft list table "$FAMILY" "$TABLE" >/dev/null 2>&1; then
		printf 'наборы в nft:\n'
		do_show 2>/dev/null | sed 's/^/  раздел /'
	else
		printf 'таблицы nft %s нет\n' "$TABLE"
	fi
	printf 'правила:\n'
	for _r in $(rule_sections 2>/dev/null); do
		_parts=$(rule_parts "$_r" 2>/dev/null)
		_t=$(printf '%s' "$_parts" | cut -f2)
		_v=$(printf '%s' "$_parts" | cut -f3)
		_n=$(rule_domains "$_r" cheap 2>/dev/null | grep -c . 2>/dev/null)
		printf '  %s тип=%s значение=%s имён=%s\n' "$_r" "${_t:-—}" "${_v:-—}" "${_n:-0}"
	done
	printf 'итог последней сборки: %s\n' "$(cat "$STATUS" 2>/dev/null)"
	printf 'журнал (последние 8 строк):\n'
	tail -n 8 "$LOG" 2>/dev/null | sed 's/^/  /'
}

case "$1" in
	sync)  do_sync ;;
	off)   do_off ;;
	show)  do_show ;;
	check) do_check ;;
	*)     printf 'usage: %s sync|off|show|check\n' "$0"; exit 1 ;;
esac
